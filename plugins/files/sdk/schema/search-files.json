{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchFilesArguments",
  "type": "object",
  "properties": {
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchFilesCursor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "show_hidden": {
      "type": "boolean",
      "default": false
    },
    "text": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "$defs": {
    "DirectoryScanFrame": {
      "type": "object",
      "properties": {
        "after_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "SearchFilesCursor": {
      "type": "object",
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirectoryScanFrame"
          }
        },
        "project": {
          "type": "string"
        },
        "show_hidden": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "text",
        "show_hidden",
        "directories"
      ]
    }
  }
}
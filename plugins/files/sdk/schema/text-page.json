{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextPage",
  "type": "object",
  "properties": {
    "complete": {
      "description": "Pagination is exhausted. Skipped content remains unavailable and is not claimed as read.",
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "file": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextFragment"
      }
    },
    "limit_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "skipped": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextSkip"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "fragments",
    "complete"
  ],
  "$defs": {
    "TextCursor": {
      "type": "object",
      "properties": {
        "byte_offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "$ref": "#/$defs/TextIdentity"
        },
        "line": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "project": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "file",
        "byte_offset",
        "line"
      ]
    },
    "TextFragment": {
      "type": "object",
      "properties": {
        "byte_end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "byte_start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "line": {
          "description": "File lines start at 1. A long line can span multiple fragments/pages.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "line_complete": {
          "type": "boolean"
        },
        "text": {
          "description": "Original text, including CR/LF if present. A UTF-8 BOM is metadata, not text.",
          "type": "string"
        }
      },
      "required": [
        "line",
        "byte_start",
        "byte_end",
        "text",
        "line_complete"
      ]
    },
    "TextIdentity": {
      "type": "object",
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "encoding": {
          "type": "string"
        },
        "native_identity": {
          "description": "Native file identity, including replacement/change metadata; not an authorization token.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "native_identity",
        "byte_size",
        "encoding"
      ]
    },
    "TextSkip": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/TextSkipReason"
        }
      },
      "required": [
        "path",
        "reason",
        "detail"
      ]
    },
    "TextSkipReason": {
      "type": "string",
      "enum": [
        "binary",
        "invalid_encoding",
        "oversize",
        "unreadable",
        "symlink",
        "unsupported",
        "invalid_path"
      ]
    }
  }
}
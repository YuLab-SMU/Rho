{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchTextArguments",
  "type": "object",
  "properties": {
    "case_sensitive": {
      "type": "boolean",
      "default": false
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchTextCursor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "directory": {
      "type": "string",
      "default": ""
    },
    "filename_contains": {
      "description": "Literal substring of the file name (same case rule as text).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "limit_matches": {
      "type": "integer",
      "format": "uint32",
      "default": 100,
      "maximum": 100,
      "minimum": 1
    },
    "show_hidden": {
      "type": "boolean",
      "default": false
    },
    "text": {
      "description": "Literal UTF-8 text. Case-insensitive matching uses Unicode lowercase mapping (not locale-specific collation).",
      "type": "string",
      "maxLength": 1024,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "$defs": {
    "DirectoryScanFrame": {
      "type": "object",
      "properties": {
        "after_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "SearchTextCursor": {
      "type": "object",
      "properties": {
        "active_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirectoryScanFrame"
          }
        },
        "project": {
          "type": "string"
        },
        "query_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "query_sha256",
        "directories"
      ]
    },
    "TextCursor": {
      "type": "object",
      "properties": {
        "byte_offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "$ref": "#/$defs/TextIdentity"
        },
        "line": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "project": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "file",
        "byte_offset",
        "line"
      ]
    },
    "TextIdentity": {
      "type": "object",
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "encoding": {
          "type": "string"
        },
        "native_identity": {
          "description": "Native file identity, including replacement/change metadata; not an authorization token.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "native_identity",
        "byte_size",
        "encoding"
      ]
    }
  }
}
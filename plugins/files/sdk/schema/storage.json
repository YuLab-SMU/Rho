{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectStorage",
  "description": "Capacity of the filesystem containing the canonical project root, not project size.",
  "type": "object",
  "properties": {
    "available_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "free_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "observed_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "project": {
      "type": "string"
    },
    "total_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "project",
    "free_bytes",
    "total_bytes",
    "available_bytes",
    "observed_at_ms"
  ]
}
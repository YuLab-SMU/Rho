{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectPatchRecovery",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "affected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before": {
          "$ref": "#/$defs/ProjectSnapshot"
        },
        "project_root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project_root",
        "before",
        "affected_paths"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "affected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "root",
        "affected_paths"
      ]
    }
  ],
  "$defs": {
    "FileObservation": {
      "type": "object",
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "mode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "modified_at_ns": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "byte_size"
      ]
    },
    "GitObservation": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitStatusEntry"
          }
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_root": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_root",
        "changes",
        "truncated"
      ]
    },
    "GitStatusEntry": {
      "type": "object",
      "properties": {
        "index_status": {
          "type": "string"
        },
        "original_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "worktree_status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "index_status",
        "worktree_status"
      ]
    },
    "ProjectSnapshot": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries_truncated": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileObservation"
          }
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root",
        "files",
        "entries",
        "entries_truncated",
        "observed_at_ms"
      ]
    }
  }
}
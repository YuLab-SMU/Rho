{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectoryPage",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DirectoryEntry"
      }
    },
    "next_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "entries",
    "truncated",
    "notices"
  ],
  "$defs": {
    "DirectoryEntry": {
      "type": "object",
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "name",
        "kind",
        "byte_size"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilePage",
  "type": "object",
  "properties": {
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    },
    "file": {
      "$ref": "#/$defs/FileObservation"
    },
    "has_more": {
      "type": "boolean"
    },
    "offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "file",
    "offset",
    "bytes",
    "has_more"
  ],
  "$defs": {
    "FileObservation": {
      "type": "object",
      "properties": {
        "byte_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "mode": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "modified_at_ns": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "byte_size"
      ]
    }
  }
}
  "version": "0.1.0",
  "description": "Captured text documents, verified project files and synchronized drafts",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "src/main.ts"
    ],
    "lockfiles": [
      "Cargo.lock",
      "dependencies.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},

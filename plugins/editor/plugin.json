  "views": [
    {
      "id": "editor",
      "title": "Editor",
      "entrypoint": "dist/index.html",
      "state_schema": {
        "type": "object"
      },
      "configuration_schema": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "byte_size": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "regular"
                  },
                  "mode": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "modified_at_ns": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "kind",
                  "sha256",
                  "byte_size"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "preferences": {
            "additionalProperties": false,
            "default": {
              "font_size": 14,
              "indent_width": 4
            },
            "properties": {
              "font_size": {
                "enum": [
                  12,
                  14,
                  16,
                  18
                ],
                "type": "integer"
              },
              "indent_width": {
                "enum": [
                  2,
                  4,
                  8
                ],
                "type": "integer"
              }
            },
            "required": [
              "font_size",
              "indent_width"
            ],
            "type": "object"
          },
          "runtime": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "artifact": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "instance": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "plugin": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "revision": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "plugin",
                  "instance",
                  "revision",
                  "artifact"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_selection": {
            "default": false,
            "type": "boolean"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "minLength": 1,
                "type": "string"
              },
              "instance": {
                "minLength": 1,
                "type": "string"
              },
              "plugin": {
                "minLength": 1,
                "type": "string"
              },
              "revision": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "plugin",
              "instance",
              "revision",
              "artifact"
            ],
            "type": "object"
          }
        },
        "required": [
          "source",
          "file"
        ],
        "type": "object"
      },
      "resource_kinds": []
    }
  ],
  "capabilities": [
    {
      "capability": {
        "id": "editor.context.search",
        "version": 1
      },
      "kind": "query",
      "title": "editor.context.search",
      "description": "Observe synchronized Editor context at its original source version. Does not read native files, start R, execute code, or recover work.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "Opaque owner cursor; continuation does not imply a frozen multi-page read."
          },
          "limit": {
            "format": "uint16",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "text": {
            "description": "Empty text lists available sources. Owners document which fields match.",
            "type": "string"
          },
          "window": {
            "type": "string"
          }
        },
        "required": [
          "window",
          "text",
          "limit"
        ],
        "title": "ContextSearch",
        "type": "object"
      },
      "examples": [
        {
          "after": null,
          "limit": 20,
          "text": "",
          "window": "window-example"
        }
      ],
      "output_schema": {
        "$defs": {
          "ContextItem": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "kind": {
                "description": "A presentation hint supplied by the owner, not a closed core view enum.",
                "type": "string"
              },
              "reference": {
                "$ref": "#/$defs/ContextReference"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "reference",
              "title",
              "description",
              "kind"
            ],
            "type": "object"
          },
          "ContextReference": {
            "additionalProperties": false,
            "properties": {
              "contribution": {
                "type": "string"
              },
              "provider": {
                "$ref": "#/$defs/InstanceRef"
              },
              "selector": {
                "description": "Owner-defined identity and observed native version/digest. Preview must\nrevalidate these against the original source; never silently refresh them."
              },
              "window": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "contribution",
              "window",
              "selector"
            ],
            "type": "object"
          },
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/ContextItem"
            },
            "maxItems": 20,
            "type": "array"
          },
          "next": true,
          "notices": {
            "description": "Explain partial, cached or unavailable observations without concealing\nthem as empty results. Completeness also belongs in the query envelope.",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          }
        },
        "required": [
          "items",
          "notices"
        ],
        "title": "ContextPage",
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "documents.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "editor.context.preview",

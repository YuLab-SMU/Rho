      ],
      "output_schema": {
        "$defs": {
          "ContextItem": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "kind": {
                "description": "A presentation hint supplied by the owner, not a closed core view enum.",
                "type": "string"
              },
              "reference": {
                "$ref": "#/$defs/ContextReference"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "reference",
              "title",
              "description",
              "kind"
            ],
            "type": "object"
          },
          "ContextReference": {
            "additionalProperties": false,
            "properties": {
              "contribution": {
                "type": "string"
              },
              "provider": {
                "$ref": "#/$defs/InstanceRef"
              },
              "selector": {
                "description": "Owner-defined identity and observed native version/digest. Preview must\nrevalidate these against the original source; never silently refresh them."
              },
              "window": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "contribution",
              "window",
              "selector"
            ],
            "type": "object"
          },
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          },
          "ResourceReference": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "data": {
            "description": "Owner-defined bounded presentation data. Large artifacts use resources."
          },
          "item": {
            "$ref": "#/$defs/ContextItem"
          },
          "resources": {
            "items": {
              "$ref": "#/$defs/ResourceReference"
            },
            "maxItems": 8,
            "type": "array"
          },
          "text": {
            "description": "Plain text, never executable markup. Truncation must end at a UTF-8 boundary.",
            "type": "string"
          },

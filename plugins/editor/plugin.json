      "input_schema": {
        "$defs": {
          "ContextReference": {
            "additionalProperties": false,
            "properties": {
              "contribution": {
                "type": "string"
              },
              "provider": {
                "$ref": "#/$defs/InstanceRef"
              },
              "selector": {
                "description": "Owner-defined identity and observed native version/digest. Preview must\nrevalidate these against the original source; never silently refresh them."
              },
              "window": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "contribution",
              "window",
              "selector"
            ],
            "type": "object"
          },
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": null,
            "description": "New complete text for edit; omitted for save/run.",
            "maxLength": 32768,
            "type": [
              "string",
              "null"
            ]
          },
          "expected_session": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "default": null,
            "description": "Optional project-relative destination for an untitled document or Save As.",
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "$ref": "#/$defs/ContextReference"
          },
          "runtime": {
            "anyOf": [
              {
                "$ref": "#/$defs/InstanceRef"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact R provider/session captured by the Agent adapter, never discovered here."

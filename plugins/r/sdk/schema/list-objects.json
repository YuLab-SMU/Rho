{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListObjectsArguments",
  "type": "object",
  "properties": {
    "directory_ref": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "expected_session": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "default": 100,
      "maximum": 200,
      "minimum": 1
    },
    "name_contains": {
      "type": "string",
      "default": ""
    },
    "object_type": {
      "description": "Filter by native R typeof (for example double, character, list or closure); classes remain metadata.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "offset": {
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session"
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RInspection",
  "description": "A successful RPC can report a busy or unavailable native observation. No\ncached value is presented as current, and continuation errors keep their code.",
  "type": "object",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/NativeCompleteness"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageSnapshotData"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/RInspectionDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RInspectionStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "source",
    "observed_at_ms",
    "completeness",
    "notices"
  ],
  "$defs": {
    "NativeCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "PackageCounts": {
      "type": "object",
      "properties": {
        "all": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "attached": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "installations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "installed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "loaded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "multiple": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "all",
        "installed",
        "installations",
        "loaded",
        "attached",
        "multiple"
      ]
    },
    "PackageEntry": {
      "type": "object",
      "properties": {
        "attached": {
          "type": "boolean"
        },
        "built": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_in_library_path": {
          "type": "boolean"
        },
        "library_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "library_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded_from_library": {
          "type": "boolean"
        },
        "loaded_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "first_in_library_path",
        "loaded_from_library",
        "attached"
      ]
    },
    "PackageGroup": {
      "type": "object",
      "properties": {
        "attached": {
          "type": "boolean"
        },
        "copy_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "first_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded_copy_observed": {
          "type": "boolean"
        },
        "loaded_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "primary_library_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source_kind": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "copy_count",
        "loaded_copy_observed",
        "attached",
        "source_kind",
        "source_count"
      ]
    },
    "PackageLibrary": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "status"
      ]
    },
    "PackageProjectLink": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ]
    },
    "PackageQueryMode": {
      "type": "string",
      "enum": [
        "installed",
        "loaded",
        "attached"
      ]
    },
    "PackageSnapshotData": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/PackageCounts",
          "default": {
            "all": 0,
            "attached": 0,
            "installations": 0,
            "installed": 0,
            "loaded": 0,
            "multiple": 0
          }
        },
        "filter": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageGroup"
          }
        },
        "libraries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageLibrary"
          }
        },
        "library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/PackageQueryMode"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation_id": {
          "type": "string",
          "default": ""
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "package_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageEntry"
          }
        },
        "platform": {
          "type": "string"
        },
        "r_home": {
          "type": "string"
        },
        "r_version": {
          "type": "string"
        },
        "scan_complete": {
          "type": "boolean"
        },
        "scanned": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_matches": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r_version",
        "r_home",
        "platform",
        "library_paths",
        "mode",
        "filter",
        "offset",
        "packages",
        "total_matches",
        "scanned",
        "scan_complete",
        "notices"
      ]
    },
    "PackageSource": {
      "type": "object",
      "properties": {
        "delivery_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageSourceField"
          }
        },
        "kind": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageProjectLink"
          }
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence",
        "links"
      ]
    },
    "PackageSourceField": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "value"
      ]
    },
    "RInspectionDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "RInspectionStatus": {
      "type": "string",
      "enum": [
        "ready",
        "busy",
        "unavailable"
      ]
    }
  }
}
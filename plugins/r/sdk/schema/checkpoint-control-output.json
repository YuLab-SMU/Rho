{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCheckpointControlOutput",
  "anyOf": [
    {
      "$ref": "#/$defs/RCheckpointControlResult"
    },
    {
      "$ref": "#/$defs/RExecutionNotStarted"
    }
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "RCheckpointControlResult": {
      "type": "object",
      "properties": {
        "deleted": {
          "description": "Logical retirement is committed by the core. This does not claim that\nthe post-commit disk cleanup has completed; observe the original copy.",
          "type": "boolean"
        },
        "operation_id": {
          "type": "string"
        },
        "pinned": {
          "type": "boolean"
        },
        "reference": {
          "$ref": "#/$defs/RCheckpointReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "reference",
        "pinned",
        "deleted"
      ]
    },
    "RCheckpointReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "provider",
        "operation_id",
        "digest",
        "bytes"
      ]
    },
    "RExecutionNotStarted": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "started": {
          "description": "Always false when the owner confirms cancellation before native execution.",
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "started"
      ]
    }
  }
}
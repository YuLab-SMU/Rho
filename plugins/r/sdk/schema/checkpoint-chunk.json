{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCheckpointChunk",
  "type": "object",
  "properties": {
    "base64": {
      "type": "string"
    },
    "next": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reference": {
      "$ref": "#/$defs/RCheckpointReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "offset",
    "base64"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "RCheckpointReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "provider",
        "operation_id",
        "digest",
        "bytes"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadREvents",
  "type": "object",
  "properties": {
    "after_sequence": {
      "type": "integer",
      "format": "uint64",
      "default": 0,
      "minimum": 0
    },
    "expected_session": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "default": 100,
      "maximum": 100,
      "minimum": 1
    },
    "operation_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session",
    "operation_id"
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RInspection",
  "description": "A successful RPC can report a busy or unavailable native observation. No\ncached value is presented as current, and continuation errors keep their code.",
  "type": "object",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/NativeCompleteness"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/RInspectionDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RInspectionStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "source",
    "observed_at_ms",
    "completeness",
    "notices"
  ],
  "$defs": {
    "NativeCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "ObjectAttribute": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "ObjectMetadata": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectAttribute"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "kind": {
          "type": "string"
        },
        "length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "level_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "description": "A small native sample for immediate recognition, never a full profile.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/ObjectScalar"
          }
        },
        "supported_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectReadKind"
          }
        },
        "table_features": {
          "description": "Native reader features, separate from attributes stored on the R object.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "classes",
        "dimensions",
        "supported_reads",
        "attributes"
      ]
    },
    "ObjectObservation": {
      "type": "object",
      "properties": {
        "expires_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMetadata"
        },
        "name": {
          "type": "string"
        },
        "object_ref": {
          "type": "string"
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectPathElement"
          }
        }
      },
      "required": [
        "object_ref",
        "name",
        "path",
        "metadata",
        "observed_at_ms",
        "expires_at_ms"
      ]
    },
    "ObjectPathElement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "index"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "name"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "ObjectReadKind": {
      "type": "string",
      "enum": [
        "structure",
        "values",
        "children",
        "table",
        "text",
        "levels",
        "names"
      ]
    },
    "ObjectScalar": {
      "type": "object",
      "properties": {
        "color": {
          "description": "Canonical R color when this complete character value is a valid color.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "imaginary": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "next_text_start": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "number": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "object_type": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_characters": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "object_type"
      ]
    },
    "RInspectionDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "RInspectionStatus": {
      "type": "string",
      "enum": [
        "ready",
        "busy",
        "unavailable"
      ]
    }
  }
}
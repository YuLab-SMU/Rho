{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RInspection",
  "description": "A successful RPC can report a busy or unavailable native observation. No\ncached value is presented as current, and continuation errors keep their code.",
  "type": "object",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/NativeCompleteness"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageIndexPage"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/RInspectionDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at_ms": {
      "type": "integer",
      "format": "int64"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RInspectionStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "source",
    "observed_at_ms",
    "completeness",
    "notices"
  ],
  "$defs": {
    "NativeCompleteness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "PackageDescriptionField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "PackageFileIdentity": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ]
    },
    "PackageIndexEntry": {
      "type": "object",
      "properties": {
        "declaration": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "resolved"
      ]
    },
    "PackageIndexPage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "description": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageDescriptionField"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageIndexEntry"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageFileIdentity"
          }
        },
        "index_ref": {
          "type": "string"
        },
        "library_path": {
          "type": "string"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation_id": {
          "type": "string"
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "package": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "index_ref",
        "observation_id",
        "package",
        "library_path",
        "version",
        "files",
        "description",
        "entries",
        "total",
        "offset",
        "observed_at_ms",
        "complete",
        "notices"
      ]
    },
    "RInspectionDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "RInspectionStatus": {
      "type": "string",
      "enum": [
        "ready",
        "busy",
        "unavailable"
      ]
    }
  }
}
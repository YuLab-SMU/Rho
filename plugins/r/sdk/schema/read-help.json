{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadPackageHelpArguments",
  "type": "object",
  "properties": {
    "expected_help_files": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "$ref": "#/$defs/PackageFileIdentity"
      }
    },
    "expected_index_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageFileIdentity"
      }
    },
    "expected_session": {
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/HelpFormat",
      "default": "text"
    },
    "library_path": {
      "type": "string"
    },
    "limit_bytes": {
      "type": "integer",
      "format": "uint32",
      "default": 16384,
      "minimum": 0
    },
    "observation_id": {
      "type": "string"
    },
    "offset_utf8": {
      "type": "integer",
      "format": "uint64",
      "default": 0,
      "minimum": 0
    },
    "package": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session",
    "observation_id",
    "package",
    "library_path",
    "topic",
    "expected_index_files"
  ],
  "$defs": {
    "HelpFormat": {
      "description": "Rendering format. HTML is produced by the static `tools::Rd2HTML` stage and is\nsuitable for a sanitized document view; text remains the bounded default.",
      "type": "string",
      "enum": [
        "text",
        "html"
      ]
    },
    "PackageFileIdentity": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextItem"
      },
      "maxItems": 20
    },
    "next": true,
    "notices": {
      "description": "Explain partial, cached or unavailable observations without concealing\nthem as empty results. Completeness also belongs in the query envelope.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    }
  },
  "additionalProperties": false,
  "required": [
    "items",
    "notices"
  ],
  "$defs": {
    "ContextItem": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "description": "A presentation hint supplied by the owner, not a closed core view enum.",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ContextReference"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "title",
        "description",
        "kind"
      ]
    },
    "ContextReference": {
      "type": "object",
      "properties": {
        "contribution": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "selector": {
          "description": "Owner-defined identity and observed native version/digest. Preview must\nrevalidate these against the original source; never silently refresh them."
        },
        "window": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "contribution",
        "window",
        "selector"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    }
  }
}
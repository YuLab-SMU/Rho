{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCheckpointManifest",
  "type": "object",
  "properties": {
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/RSessionEnvironment"
        },
        {
          "type": "null"
        }
      ]
    },
    "libraries": {
      "$ref": "#/$defs/RCheckpointLibraries"
    },
    "native_session_id": {
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/RCheckpointReference"
    },
    "report": {
      "$ref": "#/$defs/CheckpointNativeReport"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/RCheckpointReference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "native_session_id",
    "report",
    "libraries"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "CheckpointCoverage": {
      "type": "string",
      "enum": [
        "complete_eligible_graph",
        "partial"
      ]
    },
    "CheckpointNativeReport": {
      "type": "object",
      "properties": {
        "context_notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "$ref": "#/$defs/CheckpointCoverage"
        },
        "library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_inventory_digest": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "r_version": {
          "type": "string"
        },
        "required_class_namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_core_namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safe_options": {
          "$ref": "#/$defs/CheckpointSafeOptions"
        },
        "saved_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckpointSkippedBinding"
          }
        },
        "working_directory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "saved_names",
        "skipped",
        "r_version",
        "platform",
        "library_paths",
        "package_inventory_digest",
        "safe_options",
        "context_notices",
        "required_core_namespaces",
        "required_class_namespaces",
        "coverage"
      ]
    },
    "CheckpointSafeOptions": {
      "type": "object",
      "properties": {
        "digits": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "out_dec": {
          "type": [
            "string",
            "null"
          ]
        },
        "scipen": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "warn": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        }
      },
      "additionalProperties": false
    },
    "CheckpointSkippedBinding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "reason"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ProviderBinding": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "target": {
          "description": "Owner-defined native identity, fixed at admission. Not interpreted by core.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "provider",
        "project"
      ]
    },
    "RCheckpointLibraries": {
      "type": "object",
      "properties": {
        "complete": {
          "description": "False retains unknown dependencies; an empty list cannot imply absence.",
          "type": "boolean"
        },
        "library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespace_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "library_paths",
        "namespace_paths",
        "complete"
      ]
    },
    "RCheckpointReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "provider",
        "operation_id",
        "digest",
        "bytes"
      ]
    },
    "REnvironmentSelection": {
      "description": "Exact Environment provider and original successful realization. Selecting it\ndoes not start R; creation performs explicit verification under this binding.",
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/ProviderBinding"
        },
        "realization": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "realization"
      ]
    },
    "RSessionEnvironment": {
      "type": "object",
      "properties": {
        "library_digest": {
          "type": "string"
        },
        "library_path": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/ResourceReference"
        },
        "selection": {
          "$ref": "#/$defs/REnvironmentSelection"
        },
        "source": {
          "$ref": "#/$defs/ProviderBinding"
        },
        "verification": {
          "type": "string"
        },
        "verification_report": {
          "$ref": "#/$defs/ResourceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "selection",
        "source",
        "report",
        "verification",
        "verification_report",
        "library_path",
        "library_digest"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
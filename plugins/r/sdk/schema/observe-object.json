{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserveObjectArguments",
  "type": "object",
  "properties": {
    "expected_session": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectPathElement"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session",
    "name"
  ],
  "$defs": {
    "ObjectPathElement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            },
            "kind": {
              "type": "string",
              "const": "index"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "name"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    }
  }
}
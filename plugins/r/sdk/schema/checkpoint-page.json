{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCheckpointPage",
  "type": "object",
  "properties": {
    "checkpoints": {
      "description": "Successful original capture/reconciliation results in this bounded journal\npage. Inspect each exact reference for current pin/deletion/native state.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RCheckpointResult"
      }
    },
    "next_cursor": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "checkpoints"
  ],
  "$defs": {
    "CheckpointCoverage": {
      "type": "string",
      "enum": [
        "complete_eligible_graph",
        "partial"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "RCheckpointReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "provider",
        "operation_id",
        "digest",
        "bytes"
      ]
    },
    "RCheckpointResult": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CheckpointCoverage"
        },
        "manifest": {
          "$ref": "#/$defs/ResourceReference"
        },
        "native_session_id": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/RCheckpointReference"
        },
        "saved_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "manifest",
        "native_session_id",
        "saved_count",
        "skipped_count",
        "coverage"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
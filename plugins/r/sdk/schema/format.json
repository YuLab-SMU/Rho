{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatRCode",
  "description": "An explicit code-tool Operation in an already selected native session.\nFormatting parses text; it does not evaluate it or write a project file.",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 65536
    },
    "expected_session": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session",
    "code"
  ],
  "$defs": {
    "RunSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "view_id",
        "label",
        "kind"
      ]
    }
  }
}
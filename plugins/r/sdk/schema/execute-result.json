{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RExecutionOutput",
  "anyOf": [
    {
      "$ref": "#/$defs/RExecutionResult"
    },
    {
      "$ref": "#/$defs/RExecutionNotStarted"
    }
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "RExecutionNotStarted": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "started": {
          "description": "Always false when the owner confirms cancellation before native execution.",
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "started"
      ]
    },
    "RExecutionResult": {
      "type": "object",
      "properties": {
        "events": {
          "$ref": "#/$defs/ResourceReference"
        },
        "operation_id": {
          "type": "string"
        },
        "output_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunROutputMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetainedROutput"
          }
        },
        "report": {
          "$ref": "#/$defs/ResourceReference"
        },
        "session_id": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "value": {
          "description": "R's dynamic value; larger values remain in the full retained report."
        },
        "value_in_report": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "session_id",
        "value",
        "value_in_report",
        "stdout",
        "stderr",
        "report",
        "events",
        "outputs"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    },
    "RetainedROutput": {
      "type": "object",
      "properties": {
        "native": {
          "type": "object",
          "properties": {
            "byte_size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "display_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "type": "string"
            },
            "operation_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation_id",
            "sequence",
            "mime_type",
            "byte_size",
            "sha256"
          ]
        },
        "reference": {
          "$ref": "#/$defs/ResourceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "native",
        "reference"
      ]
    },
    "RunROutputMode": {
      "type": "string",
      "enum": [
        "console"
      ]
    },
    "RunSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "view_id",
        "label",
        "kind"
      ]
    }
  }
}
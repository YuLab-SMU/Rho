{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginPreflightRequest",
  "type": "object",
  "properties": {
    "arguments": true,
    "capability": {
      "$ref": "#/$defs/CapabilityKey"
    },
    "preconditions": true,
    "target": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "capability",
    "arguments",
    "preconditions"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckpointCaptureArguments",
  "type": "object",
  "properties": {
    "automatic": {
      "type": "boolean",
      "default": false
    },
    "exclude_names": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "exclude_patterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "expected_session": {
      "type": "string"
    },
    "include_names": {
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "string"
      }
    },
    "include_patterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "max_bytes": {
      "type": "integer",
      "format": "uint64",
      "default": 2147483648,
      "minimum": 0
    },
    "max_seconds": {
      "type": "number",
      "format": "double",
      "default": 2.0
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session"
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCaptureAttemptObservation",
  "type": "object",
  "properties": {
    "can_discard": {
      "type": "boolean"
    },
    "discarded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "material": {
      "$ref": "#/$defs/RCaptureMaterial"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "original_status": {
      "$ref": "#/$defs/PluginOutcome"
    },
    "owner_released": {
      "type": "boolean"
    },
    "reference": {
      "$ref": "#/$defs/RCaptureAttemptReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "original_status",
    "material",
    "owner_released",
    "can_discard",
    "notices"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "PluginOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "uncertain",
        "cancelled"
      ]
    },
    "RCaptureAttemptReference": {
      "description": "An attempted capture can lack complete payload metadata. Its original Core\noperation and provider establish identity without inventing a payload digest.",
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "provider",
        "operation_id"
      ]
    },
    "RCaptureMaterial": {
      "type": "object",
      "properties": {
        "capture_metadata_available": {
          "description": "Bounded capture metadata parsed successfully; payload integrity is separate.",
          "type": "boolean"
        },
        "fingerprint": {
          "description": "Opaque native identity/metadata precondition, not a payload content hash.",
          "type": "string"
        },
        "payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "staging_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "capture_metadata_available"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecuteR",
  "type": "object",
  "properties": {
    "expected_session": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1
    },
    "run": {
      "$ref": "#/$defs/RunRArguments"
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_session",
    "run"
  ],
  "$defs": {
    "RunRArguments": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "output_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunROutputMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "RunROutputMode": {
      "type": "string",
      "enum": [
        "console"
      ]
    },
    "RunSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "view_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "view_id",
        "label",
        "kind"
      ]
    }
  }
}
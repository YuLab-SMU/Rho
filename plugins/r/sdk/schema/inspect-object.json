{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InspectArguments",
  "type": "object",
  "properties": {
    "expected_session": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "max_items": {
      "type": "integer",
      "format": "uint32",
      "default": 20,
      "maximum": 100,
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ]
}
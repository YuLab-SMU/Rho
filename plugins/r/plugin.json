{
  "protocol_version": 1,
  "id": "org.rho.r",
  "name": "R",
  "version": "0.1.0",
  "description": "An isolated R workspace with exact native sessions and retained original output.",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "backend/src/main.rs",
      "backend/src/owner.rs",
      "BUILD.md",
      "build.mjs",
      "backend/src/queue.rs",
      "backend/src/queue_tests.rs"
    ],
    "lockfiles": [
      "Cargo.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},
  "requires": [],
  "views": [],
  "contexts": [],
  "backend": {
    "executable": "dist/rho-r-backend",
    "arguments": []
  },
  "configuration_schema": {
    "type": "object",
    "properties": {
      "ark": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "r_home": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "execution_timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400
      }
    },
    "additionalProperties": false
  },
  "default_configuration": {},
  "capabilities": [
    {
      "capability": {
        "id": "r.session",
        "version": 1
      },
      "kind": "query",
      "title": "r.session",
      "description": "Observe this instance without starting R.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {}
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.prepare",
        "version": 1
      },
      "kind": "query",
      "title": "r.prepare",
      "description": "Freeze this native session before operation admission; no runtime starts.",
      "input_schema": {
        "type": "object"
      },
      "examples": [
        {
          "capability": {
            "id": "r.create_session",
            "version": 1
          },
          "arguments": {},
          "target": null,
          "preconditions": null
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.create_session",
        "version": 1
      },
      "kind": "operation",
      "title": "r.create_session",
      "description": "Create one R session for this exact plugin instance.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {}
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.session"
      ],
      "cancellation": "unsupported",
      "preflight": {
        "id": "r.prepare",
        "version": 1
      }
    },
    {
      "capability": {
        "id": "r.execute",
        "version": 1
      },
      "kind": "operation",
      "title": "r.execute",
      "description": "Execute in the admitted session and retain output with the original Operation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          },
          "expected_session": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "expected_session"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "code": "1 + 1",
          "expected_session": "copy-session-from-r.session"
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.session"
      ],
      "cancellation": "request",
      "preflight": {
        "id": "r.prepare",
        "version": 1
      }
    },
    {
      "capability": {
        "id": "r.snapshot",
        "version": 1
      },
      "kind": "query",
      "title": "r.snapshot",
      "description": "Observe bounded objects in an existing idle session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "expected_session": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected_session"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "limit": 20,
          "expected_session": "copy-session-from-r.session"
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.respond_input",
        "version": 1
      },
      "kind": "control",
      "title": "Answer R input",
      "description": "Answer an existing native input request. Answers are transient; inspect r.session after a lost acknowledgement.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reply_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "value": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "session_id",
          "operation_id",
          "request_id",
          "reply_id",
          "value"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "session_id": "copy-session-from-r.session",
          "operation_id": "copy-pending-operation",
          "request_id": "copy-pending-request",
          "reply_id": "unique-answer",
          "value": "example answer"
        }
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "submitted": {
            "const": true
          }
        },
        "required": [
          "submitted"
        ],
        "additionalProperties": false
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.input"
      ],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.console",
        "version": 1
      },
      "kind": "query",
      "title": "R queue",
      "description": "Observe queued original operations, pause and pending Host settlement without starting R.",
      "input_schema": {
        "type": "object",
        "properties": {
          "expected_session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "expected_session"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "expected_session": "copy-queue_target-from-r.session"
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.pause_queue",
        "version": 1
      },
      "kind": "control",
      "title": "Pause R queue",
      "description": "Pause the existing queue; the current run continues. Match the observed pause identity or null.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pause_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 160
          },
          "only_operation_ids": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 34,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9._:/-]+$"
            }
          }
        },
        "required": [
          "session_id",
          "pause_id"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "session_id": "copy-queue_target-from-r.session",
          "pause_id": null
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.queue"
      ],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.resume_queue",
        "version": 1
      },
      "kind": "control",
      "title": "Resume R queue",
      "description": "Resume an observed pause after original Host settlements. Never confirms a scientific result or replays an operation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pause_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 160
          },
          "only_operation_ids": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 34,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9._:/-]+$"
            }
          }
        },
        "required": [
          "session_id",
          "pause_id"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "session_id": "copy-queue_target-from-r.session",
          "pause_id": "copy-pause-from-r.console"
        }
      ],
      "output_schema": {
        "type": "object"
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.queue"
      ],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.execute",
        "version": 2
      },
      "kind": "operation",
      "title": "Execute R input with source",
      "description": "Execute the supplied code, output mode and source labels in the exact admitted session. Labels do not attest to a Host document capture.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ExecuteR",
        "type": "object",
        "properties": {
          "expected_session": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "run": {
            "$ref": "#/$defs/RunRArguments"
          }
        },
        "additionalProperties": false,
        "required": [
          "expected_session",
          "run"
        ],
        "$defs": {
          "RunRArguments": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "output_mode": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunROutputMode"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunSource"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "code"
            ]
          },
          "RunROutputMode": {
            "type": "string",
            "enum": [
              "console"
            ]
          },
          "RunSource": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "view_id": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "view_id",
              "label",
              "kind"
            ]
          }
        }
      },
      "examples": [
        {
          "expected_session": "copy-session-from-r.session",
          "run": {
            "code": "1 + 1",
            "output_mode": "console",
            "source": {
              "view_id": "console-view",
              "label": "Console",
              "kind": "console"
            }
          }
        }
      ],
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "RExecutionOutput",
        "anyOf": [
          {
            "$ref": "#/$defs/RExecutionResult"
          },
          {
            "$ref": "#/$defs/RExecutionNotStarted"
          }
        ],
        "$defs": {
          "InstanceRef": {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ]
          },
          "RExecutionNotStarted": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "started": {
                "description": "Always false when the owner confirms cancellation before native execution.",
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false,
            "required": [
              "operation_id",
              "started"
            ]
          },
          "RExecutionResult": {
            "type": "object",
            "properties": {
              "events": {
                "$ref": "#/$defs/ResourceReference"
              },
              "operation_id": {
                "type": "string"
              },
              "output_mode": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunROutputMode"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/RetainedROutput"
                }
              },
              "report": {
                "$ref": "#/$defs/ResourceReference"
              },
              "session_id": {
                "type": "string"
              },
              "source": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunSource"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stderr": {
                "type": "string"
              },
              "stdout": {
                "type": "string"
              },
              "value": {
                "description": "R's dynamic value; larger values remain in the full retained report."
              },
              "value_in_report": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "operation_id",
              "session_id",
              "value",
              "value_in_report",
              "stdout",
              "stderr",
              "report",
              "events",
              "outputs"
            ]
          },
          "ResourceReference": {
            "type": "object",
            "properties": {
              "bytes": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ]
          },
          "RetainedROutput": {
            "type": "object",
            "properties": {
              "native": {
                "type": "object",
                "properties": {
                  "byte_size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "display_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mime_type": {
                    "type": "string"
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "operation_id",
                  "sequence",
                  "mime_type",
                  "byte_size",
                  "sha256"
                ]
              },
              "reference": {
                "$ref": "#/$defs/ResourceReference"
              }
            },
            "additionalProperties": false,
            "required": [
              "native",
              "reference"
            ]
          },
          "RunROutputMode": {
            "type": "string",
            "enum": [
              "console"
            ]
          },
          "RunSource": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "view_id": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "view_id",
              "label",
              "kind"
            ]
          }
        }
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.run_r"
      ],
      "effects": [
        "r.session"
      ],
      "cancellation": "request",
      "preflight": {
        "id": "r.prepare",
        "version": 1
      }
    },
    {
      "capability": {
        "id": "r.check_code",
        "version": 1
      },
      "kind": "query",
      "title": "Check R code",
      "description": "Check completeness in the existing idle session without evaluating code.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CheckRCode",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 262144,
            "minLength": 1
          },
          "expected_session": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "expected_session",
          "code"
        ]
      },
      "examples": [
        {
          "expected_session": "copy-session-from-r.session",
          "code": "1 + 1"
        }
      ],
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CodeCompleteness",
        "type": "object",
        "properties": {
          "indent": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "indent"
        ]
      },
      "recovery_schema": true,
      "required_scopes": [
        "workspace.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "r.output_events",
        "version": 1
      },
      "kind": "query",
      "title": "Observe original R output",
      "description": "Read bounded events while a run is active. Observations never establish terminal execution status.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ReadREvents",
        "type": "object",
        "properties": {
          "after_sequence": {
            "type": "integer",
            "format": "uint64",
            "default": 0,
            "minimum": 0
          },
          "expected_session": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "format": "uint32",
            "default": 100,
            "maximum": 100,
            "minimum": 1
          },
          "operation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "expected_session",
          "operation_id"
        ]
      },
      "examples": [
        {
          "expected_session": "copy-session-from-r.session",
          "operation_id": "original-operation",
          "after_sequence": 0,
          "limit": 100
        }
      ],
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "REventsObservation",
        "type": "object",
        "properties": {
          "output": {
            "$ref": "#/$defs/OutputEvents"
          },
          "session_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "session_id",
          "output"
        ],
        "$defs": {
          "OutputEvent": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "media": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "byte_size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "display_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mime_type": {
                    "type": "string"
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "operation_id",
                  "sequence",
                  "mime_type",
                  "byte_size",
                  "sha256"
                ]
              },
              "observed_at_ms": {
                "type": "integer",
                "format": "int64"
              },
              "operation_id": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "operation_id",
              "sequence",
              "kind",
              "observed_at_ms"
            ]
          },
          "OutputEvents": {
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/OutputEvent"
                }
              },
              "gap": {
                "type": "boolean"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_sequence": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "notices": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operation_id": {

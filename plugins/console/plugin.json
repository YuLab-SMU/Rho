{
  "protocol_version": 1,
  "id": "org.rho.console",
  "name": "Console",
  "version": "0.1.0",
  "description": "Continuous R transcript, independent command drafts, original Operations and native queue controls.",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "src/main.ts",
      "src/model.ts",
      "src/r-language.ts",
      "src/terminal.ts",
      "src/style.css",
      "index.html",
      "tsconfig.json",
      "package.json",
      "build.mjs",
      "README.md"
    ],
    "lockfiles": [
      "dependencies.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},
  "requires": [
    {
      "capability": {
        "id": "operation.get",
        "version": 1
      },
      "scopes": [
        "operation.read"
      ]
    },
    {
      "capability": {
        "id": "operation.list_recent",
        "version": 1
      },
      "scopes": [
        "operation.read"
      ]
    },
    {
      "capability": {
        "id": "resources.read",
        "version": 1
      },
      "scopes": [
        "resources.read"
      ]
    },
    {
      "capability": {
        "id": "r.session",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "r.console",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "r.check_code",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "r.output_events",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "r.create_session",
        "version": 1
      },
      "scopes": [
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "r.execute",
        "version": 2
      },
      "scopes": [
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "r.respond_input",
        "version": 1
      },
      "scopes": [
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "r.pause_queue",
        "version": 1
      },
      "scopes": [
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "r.resume_queue",
        "version": 1
      },
      "scopes": [
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "operation.request_cancellation",
        "version": 1
      },
      "scopes": [
        "workspace.run_r"
      ]
    }
  ],
  "views": [
    {
      "id": "console",
      "title": "Console",
      "entrypoint": "dist/index.html",
      "state_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "maxLength": 262144
          },
          "anchor": {
            "type": "integer",
            "minimum": 0
          },
          "head": {
            "type": "integer",
            "minimum": 0
          },
          "scrollTop": {
            "type": "number",
            "minimum": 0
          },
          "hiddenBefore": {
            "type": "integer",
            "minimum": 0
          },
          "clearPositions": {
            "type": "object",
            "maxProperties": 256,
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "follow": {
            "type": "boolean"
          },
          "history": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 131072
            }
          },
          "submission": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 262144
              },
              "session": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "view": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "request",
              "code",
              "session",
              "view"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "configuration_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "plugin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifact": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "resource_kinds": []
    }
  ],
  "capabilities": [],
  "contexts": [],
  "backend": null,
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "default_configuration": {}
}

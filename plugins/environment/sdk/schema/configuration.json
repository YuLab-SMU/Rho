{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentConfiguration",
  "type": "object",
  "properties": {
    "checkpoint_reader": {
      "description": "Exact read-only R provider for retained checkpoints. None prefers the original\nactive provider, then a unique active reader; ambiguity retains material.",
      "anyOf": [
        {
          "$ref": "#/$defs/InstanceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "rscript": {
      "description": "An explicit installed executable; activation never discovers or installs R.",
      "type": [
        "string",
        "null"
      ]
    },
    "storage_root": {
      "description": "Reopen an existing material directory after its previous owner has exited.\nNone uses this instance's Host-provided data directory.",
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "format": "uint64",
      "default": 300,
      "maximum": 86400,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentRecovery",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "automatic_reexecution": {
      "type": "boolean"
    },
    "native_recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string"
    },
    "report_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "storage_root": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation",
    "storage_root",
    "automatic_reexecution",
    "action"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
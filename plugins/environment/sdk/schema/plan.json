{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentPlan",
  "type": "object",
  "properties": {
    "local_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceDigest"
      }
    },
    "lock_digest": {
      "type": "string"
    },
    "lock_path": {
      "type": "string"
    },
    "manager": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageVersion"
      }
    },
    "platform": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "r_version": {
      "type": "string"
    }
  },
  "required": [
    "project_root",
    "manager",
    "lock_path",
    "lock_digest",
    "r_version",
    "platform",
    "packages",
    "local_sources"
  ],
  "$defs": {
    "PackageVersion": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "SourceDigest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentLibrary",
  "description": "Current read-only selection of an original, verified realization. This is not\na namespace probe or an authorization to change an existing R session.",
  "type": "object",
  "properties": {
    "binding": {
      "$ref": "#/$defs/ProviderBinding"
    },
    "library_digest": {
      "type": "string"
    },
    "library_path": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "r_version": {
      "type": "string"
    },
    "realization": {
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ResourceReference"
    },
    "rscript": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ProviderBinding"
    },
    "storage_root": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "binding",
    "realization",
    "source",
    "report",
    "project_root",
    "storage_root",
    "rscript",
    "library_path",
    "library_digest",
    "r_version",
    "platform"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ProviderBinding": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "target": {
          "description": "Owner-defined native identity, fixed at admission. Not interpreted by core.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "provider",
        "project"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
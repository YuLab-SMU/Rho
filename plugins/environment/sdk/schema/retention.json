{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetentionView",
  "type": "object",
  "properties": {
    "can_purge": {
      "type": "boolean"
    },
    "can_quarantine": {
      "type": "boolean"
    },
    "can_restore": {
      "type": "boolean"
    },
    "material": {
      "$ref": "#/$defs/MaterialState"
    },
    "retained_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_operation_id": {
      "type": "string"
    }
  },
  "required": [
    "source_operation_id",
    "material",
    "can_quarantine",
    "can_restore",
    "can_purge",
    "retained_reasons"
  ],
  "$defs": {
    "MaterialObject": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "fingerprint",
        "bytes",
        "entries"
      ]
    },
    "MaterialState": {
      "type": "object",
      "properties": {
        "live_processes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "native_marker_present": {
          "type": "boolean"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "trash": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialObject"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "native_marker_present",
        "live_processes"
      ]
    }
  }
}
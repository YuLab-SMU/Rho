{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentSnapshot",
  "type": "object",
  "properties": {
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/EnvironmentSnapshotStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "notices"
  ],
  "$defs": {
    "EnvironmentObservation": {
      "description": "Native configuration is established during explicit Host startup or an\nEnvironment operation. Reading it never starts R or tests namespace loading.",
      "type": "object",
      "properties": {
        "active_workspace_library": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "configuration_source": {
          "type": "string"
        },
        "inventory_observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "jsonlite_library": {
          "type": "string"
        },
        "library_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstalledEnvironmentPackage"
          }
        },
        "pak_available": {
          "description": "Cached startup/operation probe, not a current loadability guarantee.",
          "type": "boolean"
        },
        "platform": {
          "type": "string"
        },
        "r_home": {
          "type": "string"
        },
        "r_version": {
          "type": "string"
        },
        "renv_available": {
          "description": "Cached startup/operation probe, not a current loadability guarantee.",
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "r_version",
        "platform",
        "r_home",
        "library_paths",
        "packages",
        "truncated",
        "jsonlite_library",
        "renv_available",
        "pak_available",
        "configuration_observed_at_ms",
        "configuration_source",
        "inventory_observed_at_ms",
        "notices"
      ]
    },
    "EnvironmentSnapshotStatus": {
      "type": "string",
      "enum": [
        "ready",
        "busy",
        "unavailable"
      ]
    },
    "InstalledEnvironmentPackage": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "library"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentNativeCapabilities",
  "type": "object",
  "properties": {
    "current_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "embedded_context": {
      "type": "boolean"
    },
    "history": {
      "type": "string"
    },
    "images": {
      "type": "boolean"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentModel"
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentPermissionMode"
      }
    },
    "resume": {
      "type": "boolean"
    }
  },
  "required": [
    "resume",
    "history",
    "images",
    "embedded_context",
    "modes",
    "models"
  ],
  "$defs": {
    "AgentModel": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "efforts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "efforts"
      ]
    },
    "AgentPermissionMode": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
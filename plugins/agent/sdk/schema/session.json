{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentClientSession",
  "type": "object",
  "properties": {
    "activity": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentDecision"
      }
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "last_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentMessage"
      }
    },
    "model": {
      "type": "string"
    },
    "native_session_id": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/AgentProvider"
    },
    "state": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "window": {
      "$ref": "#/$defs/AgentControllerRef"
    }
  },
  "required": [
    "id",
    "provider",
    "native_session_id",
    "project_root",
    "window",
    "model",
    "state",
    "messages",
    "activity",
    "decisions",
    "truncated"
  ],
  "$defs": {
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentDecision": {
      "type": "object",
      "properties": {
        "details": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentDecisionOption"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "details",
        "options"
      ]
    },
    "AgentDecisionOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "AgentMessage": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ]
    },
    "AgentProvider": {
      "type": "string",
      "enum": [
        "codex",
        "kimi",
        "deepseek"
      ]
    }
  }
}
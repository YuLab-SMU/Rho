{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentContextPreview",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "image_base64": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "inclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_data": true,
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "selection": {
      "$ref": "#/$defs/AgentContextSelection"
    },
    "text": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "selection",
    "title",
    "description",
    "text",
    "native_data",
    "columns",
    "rows",
    "inclusions",
    "truncated"
  ],
  "$defs": {
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    }
  }
}
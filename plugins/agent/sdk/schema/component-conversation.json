{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentAgentConversation",
  "type": "object",
  "properties": {
    "active_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "controller": {
      "$ref": "#/$defs/AgentControllerRef"
    },
    "conversation_id": {
      "type": "string"
    },
    "created_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "draft": {
      "type": "string"
    },
    "draft_content": {
      "$ref": "#/$defs/AgentDraftContent",
      "default": {
        "assets": [],
        "context": [],
        "text": ""
      }
    },
    "draft_grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentAgentGrant"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "draft_version": {
      "description": "User draft CAS is independent of streaming run/event updates.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "profile": {
      "$ref": "#/$defs/ComponentAgentProfile"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "updated_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "conversation_id",
    "version",
    "draft_version",
    "controller",
    "profile",
    "draft",
    "created_at_ms",
    "updated_at_ms"
  ],
  "$defs": {
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentDraftContent": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "ComponentAgentGrant": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDocumentGrant"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentFileGrant"
          }
        },
        "mode": {
          "$ref": "#/$defs/ComponentAgentMode"
        },
        "permission_policy": {
          "description": "Absent only in already recorded requests using the former work modes.",
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentPermissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentAgentSession"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "documents",
        "files"
      ]
    },
    "ComponentAgentMode": {
      "type": "string",
      "enum": [
        "explain",
        "edit",
        "run"
      ]
    },
    "ComponentAgentProfile": {
      "type": "string",
      "enum": [
        "objects",
        "packages",
        "plots",
        "documents",
        "workspace",
        "project",
        "environment"
      ]
    },
    "ComponentAgentSession": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "workspace_instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_instance_id",
        "session_id"
      ]
    },
    "ComponentDocumentGrant": {
      "type": "object",
      "properties": {
        "allow_save": {
          "type": "boolean"
        },
        "document": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string"
            },
            "document_version": {
              "type": "string"
            },
            "selection_version": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "document_id",
            "document_version",
            "selection_version"
          ]
        },
        "path": {
          "description": "Exact project-relative destination; Save As cannot expand this scope.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "document",
        "allow_save"
      ]
    },
    "ComponentFileGrant": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "ComponentPermissionPolicy": {
      "description": "Approval policy is independent of the work selected by the Agent.",
      "type": "string",
      "enum": [
        "ask",
        "auto_approval",
        "full_access"
      ]
    }
  }
}
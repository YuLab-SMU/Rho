{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTaskRequest",
  "description": "Captured request after the caller's scope and controller liveness were checked.\nThe identity fields are correlation data, not an authorization credential.",
  "type": "object",
  "properties": {
    "command": {
      "$ref": "#/$defs/AgentTaskCommand"
    },
    "project_root": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/AgentControllerRef"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_root",
    "window",
    "request_id",
    "command"
  ],
  "$defs": {
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentDraftContent": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "AgentProvider": {
      "type": "string",
      "enum": [
        "codex",
        "kimi",
        "deepseek"
      ]
    },
    "AgentTaskCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "create"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "$ref": "#/$defs/AgentProvider"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/AgentDraftContent"
            },
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "save_draft"
            },
            "version": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "version",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "rename"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "archived": {
              "type": "boolean"
            },
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "archive"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "archived"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "connect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "resume"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "disconnect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "take_over"
            },
            "stop": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "stop"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "draft_version": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "send"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "draft_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "configure"
            },
            "mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "kind": {
              "type": "string",
              "const": "stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "decision_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "decision"
            },
            "option_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "decision_id",
            "option_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "data": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "add_asset"
            },
            "mime_type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "name",
            "mime_type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string"
            },
            "control": {
              "$ref": "#/$defs/AgentTaskControl"
            },
            "draft_version": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "remove_asset"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "asset_id",
            "draft_version"
          ]
        }
      ]
    },
    "AgentTaskControl": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "generation"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResourceAssetUpload",
  "type": "object",
  "properties": {
    "control": {
      "$ref": "#/$defs/AgentTaskControl"
    },
    "name": {
      "type": "string",
      "maxLength": 240,
      "minLength": 1
    },
    "reference": {
      "$ref": "#/$defs/ResourceReference"
    },
    "request_id": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36
    }
  },
  "additionalProperties": false,
  "required": [
    "request_id",
    "control",
    "name",
    "reference"
  ],
  "$defs": {
    "AgentTaskControl": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "generation"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
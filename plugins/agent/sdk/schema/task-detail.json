{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTaskDetail",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentAsset"
      }
    },
    "draft": {
      "$ref": "#/$defs/AgentTaskDraft"
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentCommandReceipt"
      }
    },
    "summary": {
      "$ref": "#/$defs/AgentTaskSummary"
    }
  },
  "required": [
    "summary",
    "draft",
    "assets",
    "receipts"
  ],
  "$defs": {
    "AgentAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mime_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "name",
        "mime_type",
        "bytes",
        "sha256"
      ]
    },
    "AgentAttachment": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AgentNativeCapabilities"
        },
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "control_frozen": {
          "type": "boolean"
        },
        "controller": {
          "$ref": "#/$defs/AgentControllerRef"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentDecision"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "controller",
        "state",
        "capabilities",
        "decisions",
        "control_frozen"
      ]
    },
    "AgentCommandReceipt": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "input_digest": {
          "type": "string"
        },
        "native_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_digest": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "submitted_draft": {
          "description": "Recovery material retained until native completion is confirmed.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDraftContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_draft_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "request_id",
        "task_id",
        "command",
        "input_digest",
        "request_digest",
        "input_assets",
        "input_context",
        "status",
        "created_at_ms",
        "updated_at_ms"
      ]
    },
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentDecision": {
      "type": "object",
      "properties": {
        "details": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentDecisionOption"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "details",
        "options"
      ]
    },
    "AgentDecisionOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "AgentDraftContent": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "AgentModel": {
      "type": "object",
      "properties": {
        "default_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "efforts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "efforts"
      ]
    },
    "AgentNativeCapabilities": {
      "type": "object",
      "properties": {
        "current_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedded_context": {
          "type": "boolean"
        },
        "history": {
          "type": "string"
        },
        "images": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentModel"
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentPermissionMode"
          }
        },
        "resume": {
          "type": "boolean"
        }
      },
      "required": [
        "resume",
        "history",
        "images",
        "embedded_context",
        "modes",
        "models"
      ]
    },
    "AgentPermissionMode": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "AgentProvider": {
      "type": "string",
      "enum": [
        "codex",
        "kimi",
        "deepseek"
      ]
    },
    "AgentTask": {
      "type": "object",
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "native_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_root": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/AgentProvider"
        },
        "task_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "task_id",
        "project_root",
        "provider",
        "title",
        "created_at_ms",
        "updated_at_ms",
        "archived",
        "model"
      ]
    },
    "AgentTaskDraft": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/AgentDraftContent"
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "content",
        "updated_at_ms"
      ]
    },
    "AgentTaskSummary": {
      "type": "object",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/AgentAttachment"
        },
        "draft_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "event_cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "has_draft": {
          "type": "boolean"
        },
        "history_gap": {
          "type": "boolean"
        },
        "history_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "observation_version": {
          "description": "Orders this task's application observations, not scientific state.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task": {
          "$ref": "#/$defs/AgentTask"
        },
        "unconfirmed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "observation_version",
        "history_generation",
        "task",
        "attachment",
        "draft_version",
        "has_draft",
        "event_cursor",
        "history_gap",
        "unconfirmed"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentAgentEventPage",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentAgentEvent"
      }
    },
    "history_gap": {
      "type": "boolean"
    }
  },
  "required": [
    "events",
    "cursor",
    "history_gap"
  ],
  "$defs": {
    "AgentAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mime_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "name",
        "mime_type",
        "bytes",
        "sha256"
      ]
    },
    "CapabilityRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "ComponentAgentEvent": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/ComponentAgentEventContent"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "run_id",
        "sequence",
        "created_at_ms",
        "content"
      ]
    },
    "ComponentAgentEventContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "diagnostic": {
              "$ref": "#/$defs/Diagnostic"
            },
            "kind": {
              "type": "string",
              "const": "diagnostic"
            }
          },
          "required": [
            "kind",
            "diagnostic"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "recovery"
            },
            "version": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "state"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/ComponentAgentRunState"
            }
          },
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tool"
            },
            "phase": {
              "$ref": "#/$defs/ComponentToolPhase"
            },
            "receipt_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "receipt_id",
            "phase"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "evidence"
            },
            "reference": {
              "$ref": "#/$defs/ComponentAgentEvidence"
            }
          },
          "required": [
            "kind",
            "reference"
          ]
        }
      ]
    },
    "ComponentAgentEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AgentAsset"
            },
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "kind",
            "conversation_id",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operation"
            },
            "operation_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "operation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "media"
            },
            "reference": {
              "type": "object",
              "properties": {
                "byte_size": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "display_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mime_type": {
                  "type": "string"
                },
                "operation_id": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "operation_id",
                "sequence",
                "mime_type",
                "byte_size",
                "sha256"
              ]
            }
          },
          "required": [
            "kind",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "document": {
              "type": "object",
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "document_version": {
                  "type": "string"
                },
                "selection_version": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "document_id",
                "document_version",
                "selection_version"
              ]
            },
            "kind": {
              "type": "string",
              "const": "document"
            }
          },
          "required": [
            "kind",
            "document"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "observation"
            },
            "reference": true
          },
          "required": [
            "kind",
            "capability",
            "reference"
          ]
        }
      ]
    },
    "ComponentAgentRunState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_r",
        "waiting_for_permission",
        "needs_input",
        "stopping",
        "completed",
        "stopped",
        "failed",
        "interrupted"
      ]
    },
    "ComponentToolPhase": {
      "type": "string",
      "enum": [
        "intent",
        "accepted",
        "resolved",
        "uncertain"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "continuation": {
          "$ref": "#/$defs/DiagnosticContinuation"
        },
        "message": {
          "type": "string"
        },
        "next_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NextRead"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "continuation",
        "next_reads"
      ]
    },
    "DiagnosticCode": {
      "type": "string",
      "enum": [
        "busy",
        "stale_session",
        "observation_expired",
        "content_changed",
        "budget_exceeded",
        "unavailable",
        "invalid_input",
        "access_denied",
        "idempotency_conflict",
        "not_found",
        "execution_failed",
        "cancelled",
        "outcome_uncertain",
        "contract_violation"
      ]
    },
    "DiagnosticContinuation": {
      "type": "string",
      "enum": [
        "read_again",
        "refresh_observation",
        "inspect_original",
        "correct_input",
        "none"
      ]
    },
    "NextRead": {
      "type": "object",
      "properties": {
        "arguments": true,
        "capability": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "missing_identity_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "purpose",
        "capability",
        "arguments",
        "missing_identity_fields"
      ]
    }
  }
}
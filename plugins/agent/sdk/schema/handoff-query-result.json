{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHandoffQueryResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "source"
        },
        "source": {
          "$ref": "#/$defs/AgentHandoffSourceSnapshot"
        }
      },
      "required": [
        "kind",
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "target"
        },
        "target": {
          "$ref": "#/$defs/AgentHandoffTargetSnapshot"
        }
      },
      "required": [
        "kind",
        "target"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "receipt"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentHandoffReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentDraftContent": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "AgentHandoffReceipt": {
      "type": "object",
      "properties": {
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ProjectAgentTaskRef"
        },
        "target": {
          "$ref": "#/$defs/ProjectAgentTaskRef"
        },
        "target_draft_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "request_id",
        "source",
        "target",
        "target_draft_version",
        "created_at_ms"
      ]
    },
    "AgentHandoffSourceSnapshot": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ProjectAgentTaskRef"
        },
        "title": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "title",
        "body",
        "context",
        "revision",
        "truncated",
        "notices"
      ]
    },
    "AgentHandoffTargetSnapshot": {
      "type": "object",
      "properties": {
        "control_generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "controller": {
          "$ref": "#/$defs/AgentControllerRef"
        },
        "draft": {
          "$ref": "#/$defs/AgentDraftContent"
        },
        "draft_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/ProjectAgentTaskRef"
        },
        "title": {
          "type": "string"
        },
        "writable": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "title",
        "draft",
        "draft_version",
        "controller",
        "writable"
      ]
    },
    "ProjectAgentTaskRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rho"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conversation_id"
          ]
        }
      ]
    }
  }
}
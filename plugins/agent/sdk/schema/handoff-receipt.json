{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHandoffReceipt",
  "type": "object",
  "properties": {
    "created_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "request_id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ProjectAgentTaskRef"
    },
    "target": {
      "$ref": "#/$defs/ProjectAgentTaskRef"
    },
    "target_draft_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "request_id",
    "source",
    "target",
    "target_draft_version",
    "created_at_ms"
  ],
  "$defs": {
    "ProjectAgentTaskRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rho"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conversation_id"
          ]
        }
      ]
    }
  }
}
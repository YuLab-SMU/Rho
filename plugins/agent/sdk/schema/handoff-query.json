{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHandoffsQuery",
  "type": "object",
  "properties": {
    "project_root": {
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/AgentHandoffQuery"
    },
    "window": {
      "$ref": "#/$defs/AgentControllerRef"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_root",
    "window",
    "query"
  ],
  "$defs": {
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "AgentHandoffQuery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source"
            },
            "source": {
              "$ref": "#/$defs/ProjectAgentTaskRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "target"
            },
            "target": {
              "$ref": "#/$defs/ProjectAgentTaskRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "receipt"
            },
            "request_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id"
          ]
        }
      ]
    },
    "ProjectAgentTaskRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rho"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conversation_id"
          ]
        }
      ]
    }
  }
}
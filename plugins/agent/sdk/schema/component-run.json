{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComponentAgentRun",
  "type": "object",
  "properties": {
    "budget": {
      "$ref": "#/$defs/ComponentAgentBudget"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentAgentContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "document_grants": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentDocumentGrant"
      }
    },
    "document_versions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "document_version": {
            "type": "string"
          },
          "selection_version": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "document_id",
          "document_version",
          "selection_version"
        ]
      }
    },
    "event_cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "model": {
      "description": "Fixed configuration for this run. Contains references, never credentials.",
      "$ref": "#/$defs/ComponentModelConnection"
    },
    "model_calls": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "permissions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentAgentPermission"
      }
    },
    "profile": {
      "$ref": "#/$defs/ComponentAgentProfile"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentAgentRecovery"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "$ref": "#/$defs/ComponentAgentStart"
    },
    "run_id": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ComponentAgentRunState"
    },
    "task_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComponentAgentTaskIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_calls": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "tool_result_bytes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "updated_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "run_id",
    "request",
    "profile",
    "state",
    "model",
    "budget",
    "model_calls",
    "tool_calls",
    "tool_result_bytes",
    "event_cursor",
    "created_at_ms",
    "updated_at_ms"
  ],
  "$defs": {
    "AgentAsset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mime_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "name",
        "mime_type",
        "bytes",
        "sha256"
      ]
    },
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "ApplicationCommandState": {
      "type": "string",
      "enum": [
        "cancelled",
        "pending",
        "claimed",
        "applied",
        "awaiting_execution",
        "locally_applied_unsynced",
        "failed",
        "expired",
        "uncertain"
      ]
    },
    "ComponentAgentBudget": {
      "type": "object",
      "properties": {
        "context_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tool_result_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "model_calls",
        "tool_calls",
        "context_bytes",
        "tool_result_bytes",
        "output_tokens",
        "duration_ms"
      ]
    },
    "ComponentAgentContext": {
      "type": "object",
      "properties": {
        "history": true,
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentSourceSnapshot"
          }
        }
      },
      "required": [
        "sources"
      ]
    },
    "ComponentAgentEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AgentAsset"
            },
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "kind",
            "conversation_id",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operation"
            },
            "operation_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "operation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "media"
            },
            "reference": {
              "type": "object",
              "properties": {
                "byte_size": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "display_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mime_type": {
                  "type": "string"
                },
                "operation_id": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "operation_id",
                "sequence",
                "mime_type",
                "byte_size",
                "sha256"
              ]
            }
          },
          "required": [
            "kind",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "document": {
              "type": "object",
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "document_version": {
                  "type": "string"
                },
                "selection_version": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "document_id",
                "document_version",
                "selection_version"
              ]
            },
            "kind": {
              "type": "string",
              "const": "document"
            }
          },
          "required": [
            "kind",
            "document"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "observation"
            },
            "reference": true
          },
          "required": [
            "kind",
            "capability",
            "reference"
          ]
        }
      ]
    },
    "ComponentAgentGrant": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDocumentGrant"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentFileGrant"
          }
        },
        "mode": {
          "$ref": "#/$defs/ComponentAgentMode"
        },
        "permission_policy": {
          "description": "Absent only in already recorded requests using the former work modes.",
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentPermissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentAgentSession"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "documents",
        "files"
      ]
    },
    "ComponentAgentMode": {
      "type": "string",
      "enum": [
        "explain",
        "edit",
        "run"
      ]
    },
    "ComponentAgentPermission": {
      "type": "object",
      "properties": {
        "action_digest": {
          "type": "string"
        },
        "authorization": {
          "$ref": "#/$defs/ComponentTaskAuthorization"
        },
        "decision_id": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ComponentPermissionPolicy"
        },
        "receipt_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ComponentPermissionState"
        },
        "title": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "receipt_id",
        "action_digest",
        "tool",
        "title",
        "details",
        "authorization",
        "policy",
        "state"
      ]
    },
    "ComponentAgentProfile": {
      "type": "string",
      "enum": [
        "objects",
        "packages",
        "plots",
        "documents",
        "workspace",
        "project",
        "environment"
      ]
    },
    "ComponentAgentRecovery": {
      "type": "object",
      "properties": {
        "checked_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentRecoveredTool"
          }
        },
        "unresolved_mutations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "digest",
        "checked_at_ms",
        "unresolved_mutations",
        "tools"
      ]
    },
    "ComponentAgentRunState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_r",
        "waiting_for_permission",
        "needs_input",
        "stopping",
        "completed",
        "stopped",
        "failed",
        "interrupted"
      ]
    },
    "ComponentAgentSession": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "workspace_instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_instance_id",
        "session_id"
      ]
    },
    "ComponentAgentStart": {
      "type": "object",
      "properties": {
        "assets": {
          "description": "Immutable user-uploaded attachment references; bytes stay in Application asset storage.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentContinuation"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversation_id": {
          "type": "string"
        },
        "conversation_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "grant": {
          "$ref": "#/$defs/ComponentAgentGrant"
        },
        "model_settings_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_id": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentContextSelection"
          }
        },
        "text": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/AgentControllerRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "conversation_id",
        "conversation_version",
        "window",
        "model_settings_version",
        "text",
        "grant",
        "sources"
      ]
    },
    "ComponentAgentTaskIntent": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentIntentAction"
          }
        },
        "request_excerpt": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_excerpt",
        "actions"
      ]
    },
    "ComponentContinuation": {
      "type": "object",
      "properties": {
        "recovery_digest": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "recovery_digest"
      ]
    },
    "ComponentCredentialRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "environment"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "Retained references from Hosts that used memory-only credentials.",
          "type": "object",
          "properties": {
            "key_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key_id"
          ]
        },
        {
          "description": "Immutable version in the user-local Rho configuration file.",
          "type": "object",
          "properties": {
            "key_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "local_file"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key_id"
          ]
        }
      ]
    },
    "ComponentDocumentGrant": {
      "type": "object",
      "properties": {
        "allow_save": {
          "type": "boolean"
        },
        "document": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string"
            },
            "document_version": {
              "type": "string"
            },
            "selection_version": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "document_id",
            "document_version",
            "selection_version"
          ]
        },
        "path": {
          "description": "Exact project-relative destination; Save As cannot expand this scope.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "document",
        "allow_save"
      ]
    },
    "ComponentFileGrant": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "ComponentIntentAction": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ComponentRequestedAction"
        },
        "document_id": {
          "description": "None denotes execution in the run's already bound R session.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "An exact project-relative destination, including a not-yet-created file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    },
    "ComponentModelConnection": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string"
        },
        "credential": {
          "$ref": "#/$defs/ComponentCredentialRef"
        },
        "model": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ComponentModelProtocol"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol",
        "base_url",
        "model",
        "credential"
      ]
    },
    "ComponentModelProtocol": {
      "type": "string",
      "enum": [
        "anthropic",
        "openai_completions"
      ]
    },
    "ComponentPermissionPolicy": {
      "description": "Approval policy is independent of the work selected by the Agent.",
      "type": "string",
      "enum": [
        "ask",
        "auto_approval",
        "full_access"
      ]
    },
    "ComponentPermissionState": {
      "type": "string",
      "enum": [
        "pending",
        "allowed",
        "denied"
      ]
    },
    "ComponentRecoveredOperation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus"
        }
      },
      "required": [
        "operation_id",
        "status"
      ]
    },
    "ComponentRecoveredTool": {
      "type": "object",
      "properties": {
        "application_request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "application_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationCommandState"
            },
            {
              "type": "null"
            }
          ]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string"
              },
              "document_version": {
                "type": "string"
              },
              "selection_version": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "document_id",
              "document_version",
              "selection_version"
            ]
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentRecoveredOperation"
          }
        },
        "receipt_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ComponentRecoveryState"
        }
      },
      "required": [
        "receipt_id",
        "state",
        "operations",
        "documents"
      ]
    },
    "ComponentRecoveryState": {
      "type": "string",
      "enum": [
        "confirmed",
        "not_submitted",
        "read_interrupted",
        "pending",
        "uncertain"
      ]
    },
    "ComponentRequestedAction": {
      "type": "string",
      "enum": [
        "create",
        "edit",
        "save",
        "execute"
      ]
    },
    "ComponentSourceObservation": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "completeness": {
          "$ref": "#/$defs/ObservationCompleteness"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QueryStatus"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "capability",
        "target",
        "source",
        "observed_at_ms",
        "status",
        "completeness",
        "notices"
      ]
    },
    "ComponentSourceSnapshot": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentAgentEvidence"
          }
        },
        "native_data": true,
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentSourceObservation"
          }
        },
        "selection": {
          "$ref": "#/$defs/AgentContextSelection"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "selection",
        "title",
        "description",
        "text",
        "native_data",
        "truncated",
        "observations",
        "evidence"
      ]
    },
    "ComponentTaskAuthorization": {
      "description": "The executing Agent interprets the user's request; no review model is called.",
      "type": "string",
      "enum": [
        "user_request",
        "additional"
      ]
    },
    "ObservationCompleteness": {
      "type": "string",

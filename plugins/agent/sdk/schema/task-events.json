{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTaskEventPage",
  "type": "object",
  "properties": {
    "durable_cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentTaskEvent"
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "history_gap": {
      "type": "boolean"
    },
    "history_generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "next_cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "oldest_cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "history_generation",
    "events",
    "next_cursor",
    "has_more",
    "history_gap",
    "oldest_cursor",
    "durable_cursor"
  ],
  "$defs": {
    "AgentTaskEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "native_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_session_id": {
          "type": "string"
        },
        "native_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "description": "native_history or observation; never re-sent as model memory.",
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentUsageObservation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sequence",
        "event_id",
        "generation",
        "native_session_id",
        "kind",
        "text",
        "source",
        "observed_at_ms"
      ]
    },
    "AgentUsageObservation": {
      "type": "object",
      "properties": {
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_used": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "scope": {
          "description": "session_total, turn_total, or context_window. Totals replace, never add.",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "scope"
      ]
    }
  }
}
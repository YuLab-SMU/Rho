{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentNativeToolReceipt",
  "type": "object",
  "properties": {
    "created_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "failed": {
      "type": "boolean"
    },
    "invocation": {
      "$ref": "#/$defs/AgentNativeToolInvocation"
    },
    "kind": {
      "$ref": "#/$defs/AgentNativeToolKind"
    },
    "native_request": {
      "$ref": "#/$defs/AgentNativeToolRequest"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "$ref": "#/$defs/AgentNativeToolPhase"
    },
    "request": {
      "type": "string"
    },
    "result": true,
    "task_id": {
      "type": "string"
    },
    "updated_at_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "task_id",
    "invocation",
    "request",
    "native_request",
    "kind",
    "phase",
    "failed",
    "created_at_ms",
    "updated_at_ms"
  ],
  "$defs": {
    "AgentNativeToolInvocation": {
      "type": "object",
      "properties": {
        "arguments": true,
        "preconditions": {
          "default": null
        },
        "send_request": {
          "description": "Explicit original Send identity prevents a stale native tool call from\nbecoming new work merely because the same connection has another turn.",
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_request": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "send_request",
        "tool_request",
        "tool",
        "arguments"
      ]
    },
    "AgentNativeToolKind": {
      "type": "string",
      "enum": [
        "query",
        "operation"
      ]
    },
    "AgentNativeToolPhase": {
      "type": "string",
      "enum": [
        "prepared",
        "resolved",
        "uncertain"
      ]
    },
    "AgentNativeToolRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/PluginRequest"
            },
            "type": {
              "type": "string",
              "const": "provider"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": {
              "description": "Complete native input, including the caller's captured fields."
            },
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "project": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "host"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "project",
            "capability",
            "arguments"
          ]
        }
      ]
    },
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "PluginRequest": {
      "description": "Public Host payload: provider selection is separate from scientific arguments.",
      "type": "object",
      "properties": {
        "arguments": true,
        "binding": {
          "$ref": "#/$defs/ProviderBinding"
        },
        "preconditions": {
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "arguments"
      ]
    },
    "ProviderBinding": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "target": {
          "description": "Owner-defined native identity, fixed at admission. Not interpreted by core.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "provider",
        "project"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHandoffCommand",
  "type": "object",
  "properties": {
    "body": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentContextSelection"
      }
    },
    "project_root": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ProjectAgentTaskRef"
    },
    "source_revision": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ProjectAgentTaskRef"
    },
    "target_control_generation": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "target_draft_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "window": {
      "$ref": "#/$defs/AgentControllerRef"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_root",
    "window",
    "request_id",
    "source",
    "source_revision",
    "target",
    "target_draft_version",
    "body",
    "context"
  ],
  "$defs": {
    "AgentContextSelection": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "reference": {
          "description": "Owner-specific reference/observation, validated by the registered source."
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "reference",
        "inclusion"
      ]
    },
    "AgentControllerRef": {
      "description": "Correlation identity supplied by the Agent owner after admission. This value\nis not an authorization credential and cannot grant access to a Host window.",
      "type": "object",
      "properties": {
        "incarnation": {
          "type": "string"
        },
        "window_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "window_id",
        "incarnation"
      ]
    },
    "ProjectAgentTaskRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rho"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conversation_id"
          ]
        }
      ]
    }
  }
}
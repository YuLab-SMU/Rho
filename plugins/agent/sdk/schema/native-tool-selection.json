{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentNativeToolSelection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/AgentNativeToolTarget"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "target"
  ],
  "$defs": {
    "AgentNativeToolTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/ProviderBinding"
            },
            "type": {
              "type": "string",
              "const": "provider"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "fixed_arguments": {
              "description": "Captured by the caller before Send, for example its selected branch.\nModel arguments cannot include or replace these top-level fields.",
              "type": "object",
              "additionalProperties": true
            },
            "project": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "host"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "project",
            "capability",
            "fixed_arguments"
          ]
        }
      ]
    },
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ProviderBinding": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "project": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "target": {
          "description": "Owner-defined native identity, fixed at admission. Not interpreted by core.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "provider",
        "project"
      ]
    }
  }
}
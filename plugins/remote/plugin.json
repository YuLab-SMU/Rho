{
  "protocol_version": 1,
  "id": "org.rho.remote",
  "name": "Remote tasks",
  "version": "0.1.0",
  "description": "SSH execution and original-operation Slurm recovery on explicit configured targets",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "backend/src/main.rs",
      "build.mjs"
    ],
    "lockfiles": [
      "Cargo.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},
  "requires": [
    {
      "capability": {
        "id": "operation.get",
        "version": 1
      },
      "scopes": [
        "operation.read"
      ]
    }
  ],
  "views": [],
  "capabilities": [
    {
      "capability": {
        "id": "remote.status",
        "version": 1
      },
      "kind": "query",
      "title": "Observe configured remote activity",
      "description": "Observe configured native activity or validate an explicit request without starting SSH or a scheduler job.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "Empty",
        "type": "object"
      },
      "examples": [
        {}
      ],
      "output_schema": {
        "$defs": {
          "ProcessActivity": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "type": "string"
              },
              "phase": {
                "$ref": "#/$defs/ProcessPhase"
              }
            },
            "required": [
              "operation",
              "phase"
            ],
            "type": "object"
          },
          "ProcessPhase": {
            "enum": [
              "waiting",
              "running",
              "awaiting_settlement"
            ],
            "type": "string"
          },
          "RemoteTarget": {
            "additionalProperties": false,
            "properties": {
              "host_alias": {
                "type": "string"
              },
              "project_root": {
                "type": "string"
              },
              "slurm_cluster": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "host_alias",
              "project_root"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/$defs/ProcessActivity"
            },
            "type": "array"
          },
          "capacity": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoteTarget"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "activities",
          "capacity"
        ],
        "title": "RemoteStatus",
        "type": "object"
      },
      "recovery_schema": {
        "type": "null"
      },
      "required_scopes": [
        "project.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "process.run_remote",
        "version": 2
      },
      "kind": "operation",
      "title": "Run an SSH command",
      "description": "Execute on the configured SSH target. Preserve bounded original output in a resource. SSH loss or local transport cancellation never confirms remote termination; no automatic replay.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "args": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "output_limit_bytes": {
            "default": 65536,
            "format": "uint",
            "maximum": 131072,
            "minimum": 1,
            "type": "integer"
          },
          "program": {
            "type": "string"
          },
          "stdin": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "timeout_ms": {
            "default": 60000,
            "format": "uint64",
            "maximum": 3600000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "program"
        ],
        "title": "RunLocalArguments",
        "type": "object"
      },
      "examples": [
        {
          "args": [
            "Example\\n"
          ],
          "program": "printf"
        }
      ],
      "output_schema": {
        "$defs": {
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          },
          "RemoteExecutionOutcome": {
            "description": "Remote evidence classification; journal outcomes are committed by the caller.",
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "uncertain"
            ],
            "type": "string"
          },
          "RemoteTarget": {
            "additionalProperties": false,
            "properties": {
              "host_alias": {
                "type": "string"
              },
              "project_root": {
                "type": "string"
              },
              "slurm_cluster": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "host_alias",
              "project_root"
            ],
            "type": "object"
          },
          "ResourceReference": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "native_outcome": {
            "$ref": "#/$defs/RemoteExecutionOutcome"
          },
          "operation": {
            "type": "string"
          },
          "remote_exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "report": {
            "$ref": "#/$defs/ResourceReference",
            "description": "Original JSON RemoteExecutionReport, including bounded transport streams."
          },
          "target": {
            "$ref": "#/$defs/RemoteTarget"
          }
        },
        "required": [
          "operation",
          "target",
          "report",
          "native_outcome"
        ],
        "title": "RemoteRunResult",
        "type": "object"
      },
      "recovery_schema": {
        "$defs": {
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          },
          "OutputCapture": {
            "properties": {
              "bytes": {
                "items": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "eof": {
                "type": "boolean"
              },
              "total_bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "bytes",
              "total_bytes",
              "truncated",
              "eof"
            ],
            "type": "object"
          },
          "RemoteExecutionOutcome": {
            "description": "Remote evidence classification; journal outcomes are committed by the caller.",
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "uncertain"
            ],
            "type": "string"
          },
          "RemoteTarget": {
            "additionalProperties": false,
            "properties": {
              "host_alias": {
                "type": "string"
              },
              "project_root": {
                "type": "string"
              },
              "slurm_cluster": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "host_alias",
              "project_root"
            ],
            "type": "object"
          },
          "ResourceReference": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "automatic_reexecution": {
            "type": "boolean"
          },
          "native_outcome": {
            "$ref": "#/$defs/RemoteExecutionOutcome"
          },
          "operation": {
            "type": "string"
          },
          "project_root": {
            "type": "string"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResourceReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_digest": {
            "type": [
              "string",
              "null"
            ]
          },

          "stdout": {
            "$ref": "#/$defs/OutputCapture"
          },
          "target": {
            "$ref": "#/$defs/RemoteTarget"
          }
        },
        "required": [
          "operation",
          "project_root",
          "target",
          "native_outcome",
          "stdout",
          "stderr",
          "report_transfer_confirmed",
          "automatic_reexecution",
          "action"
        ],
        "title": "RemoteRunRecovery",
        "type": "object"
      },

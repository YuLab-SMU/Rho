            "type": "string"
          },
          "cpus": {
            "default": 1,
            "format": "uint16",
            "maximum": 512,
            "minimum": 1,
            "type": "integer"
          },
          "gpus": {
            "default": 0,
            "format": "uint16",
            "maximum": 64,
            "minimum": 0,

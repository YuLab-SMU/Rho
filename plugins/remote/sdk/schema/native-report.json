{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteExecutionReport",
  "type": "object",
  "properties": {
    "notice": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/RemoteExecutionOutcome"
    },
    "remote_exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "target": {
      "$ref": "#/$defs/RemoteTarget"
    },
    "transport": {
      "$ref": "#/$defs/ProcessReport"
    }
  },
  "required": [
    "target",
    "transport",
    "outcome",
    "notice"
  ],
  "$defs": {
    "OutputCapture": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "eof": {
          "type": "boolean"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "bytes",
        "total_bytes",
        "truncated",
        "eof"
      ]
    },
    "ProcessReport": {
      "type": "object",
      "properties": {
        "cleanup_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleanup_requested": {
          "type": "boolean"
        },
        "elapsed_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "exit_signal": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "stderr": {
          "$ref": "#/$defs/OutputCapture"
        },
        "stdin_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "$ref": "#/$defs/OutputCapture"
        },
        "supervision": {
          "type": "string"
        },
        "termination": {
          "$ref": "#/$defs/ProcessTermination"
        }
      },
      "required": [
        "termination",
        "stdout",
        "stderr",
        "elapsed_ms",
        "supervision",
        "cleanup_requested"
      ]
    },
    "ProcessTermination": {
      "type": "string",
      "enum": [
        "exited",
        "cancelled",
        "timed_out",
        "uncertain"
      ]
    },
    "RemoteExecutionOutcome": {
      "description": "Remote evidence classification; journal outcomes are committed by the caller.",
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "uncertain"
      ]
    },
    "RemoteTarget": {
      "type": "object",
      "properties": {
        "host_alias": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "slurm_cluster": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host_alias",
        "project_root"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteStatus",
  "type": "object",
  "properties": {
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProcessActivity"
      }
    },
    "capacity": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_key": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "activities",
    "capacity"
  ],
  "$defs": {
    "ProcessActivity": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ProcessPhase"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "phase"
      ]
    },
    "ProcessPhase": {
      "type": "string",
      "enum": [
        "waiting",
        "running",
        "awaiting_settlement"
      ]
    },
    "RemoteTarget": {
      "type": "object",
      "properties": {
        "host_alias": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "slurm_cluster": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host_alias",
        "project_root"
      ]
    }
  }
}
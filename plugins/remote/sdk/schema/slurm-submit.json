{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlurmSubmitArguments",
  "type": "object",
  "properties": {
    "account": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "body": {
      "description": "Bash body, not an sbatch option file. Resource options are typed fields.",
      "type": "string"
    },
    "cpus": {
      "type": "integer",
      "format": "uint16",
      "default": 1,
      "maximum": 512,
      "minimum": 1
    },
    "gpus": {
      "type": "integer",
      "format": "uint16",
      "default": 0,
      "maximum": 64,
      "minimum": 0
    },
    "memory_mb": {
      "type": "integer",
      "format": "uint32",
      "default": 1024,
      "maximum": 1048576,
      "minimum": 1
    },
    "partition": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "time_minutes": {
      "type": "integer",
      "format": "uint32",
      "default": 10,
      "maximum": 10080,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "body"
  ]
}
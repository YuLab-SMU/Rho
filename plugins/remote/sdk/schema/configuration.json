{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteConfiguration",
  "type": "object",
  "properties": {
    "target": {
      "description": "No connection or operation is possible until an explicit target is set.",
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RemoteTarget": {
      "type": "object",
      "properties": {
        "host_alias": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "slurm_cluster": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host_alias",
        "project_root"
      ]
    }
  }
}
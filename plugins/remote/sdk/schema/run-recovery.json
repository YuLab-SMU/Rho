{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteRunRecovery",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "automatic_reexecution": {
      "type": "boolean"
    },
    "native_outcome": {
      "$ref": "#/$defs/RemoteExecutionOutcome"
    },
    "operation": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "report_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_transfer_confirmed": {
      "type": "boolean"
    },
    "stderr": {
      "$ref": "#/$defs/OutputCapture"
    },
    "stdout": {
      "$ref": "#/$defs/OutputCapture"
    },
    "target": {
      "$ref": "#/$defs/RemoteTarget"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation",
    "project_root",
    "target",
    "native_outcome",
    "stdout",
    "stderr",
    "report_transfer_confirmed",
    "automatic_reexecution",
    "action"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "OutputCapture": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "eof": {
          "type": "boolean"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "bytes",
        "total_bytes",
        "truncated",
        "eof"
      ]
    },
    "RemoteExecutionOutcome": {
      "description": "Remote evidence classification; journal outcomes are committed by the caller.",
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "uncertain"
      ]
    },
    "RemoteTarget": {
      "type": "object",
      "properties": {
        "host_alias": {
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "slurm_cluster": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host_alias",
        "project_root"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
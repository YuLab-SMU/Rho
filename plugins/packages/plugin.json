{
  "protocol_version": 1,
  "id": "org.rho.packages",
  "name": "Packages",
  "version": "0.1.0",
  "description": "Read-only installed R package copies, observed source details and exact-copy Help navigation.",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "README.md",
      "build.mjs",
      "index.html",
      "package.json",
      "src/actions.ts",
      "src/connection.ts",
      "src/icons.tsx",
      "src/main.tsx",
      "src/packages.ts",
      "src/primitives.tsx",
      "src/resource-ports.ts",
      "src/shared/model.ts",
      "src/shared/ports.ts",
      "src/style.css",
      "src/styles.d.ts",
      "src/view-services.tsx",
      "src/views/package-inspector.tsx",
      "src/views/packages-panel.tsx",
      "tests/actions.test.ts",
      "tests/connection.test.ts",
      "tests/packages.test.ts",
      "tsconfig.json",
      "src/agent-source.ts",
      "tests/agent-source.test.ts"
    ],
    "lockfiles": [
      "dependencies.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},
  "requires": [
    {
      "capability": {
        "id": "r.inspection_state",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "r.packages",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "windows.layout",
        "version": 1
      },
      "scopes": [
        "plugins.run"
      ]
    },
    {
      "capability": {
        "id": "windows.open_view",
        "version": 1
      },
      "scopes": [
        "application.control",
        "application.read",
        "documents.read",
        "documents.write",
        "environment.read",
        "environment.write",
        "operation.read",
        "plugins.read",
        "plugins.run",
        "plugins.write",
        "process.run_local",
        "project.read",
        "project.references.read",
        "project.write",
        "remote.execute",
        "resources.read",
        "skill.read",
        "slurm.read",
        "slurm.write",
        "workspace.read",
        "workspace.run_r"
      ]
    },
    {
      "capability": {
        "id": "operation.get",
        "version": 1
      },
      "scopes": [
        "operation.read"
      ]
    },
    {
      "capability": {
        "id": "operation.list_recent",
        "version": 1
      },
      "scopes": [
        "operation.read"
      ]
    },
    {
      "capability": {
        "id": "plugins.instances",
        "version": 1
      },
      "scopes": [
        "plugins.read"
      ]
    },
    {
      "capability": {
        "id": "plugins.instance",
        "version": 1
      },
      "scopes": [
        "plugins.read"
      ]
    },
    {
      "capability": {
        "id": "plugins.inspect",
        "version": 1
      },
      "scopes": [
        "plugins.read"
      ]
    },
    {
      "capability": {
        "id": "r.context.packages.preview",
        "version": 1
      },
      "scopes": [
        "workspace.read"
      ]
    },
    {
      "capability": {
        "id": "annotations.read",
        "version": 1
      },
      "scopes": [
        "application.read",
        "plugins.read"
      ]
    }
  ],
  "views": [
    {
      "id": "packages",
      "title": "Packages",
      "entrypoint": "dist/index.html",
      "state_schema": {
        "type": "object",
        "properties": {
          "nativeSession": {
            "type": [
              "string",
              "null"
            ]
          },
          "actions": {
            "type": [
              "object",
              "null"
            ]
          },
          "packages": {
            "type": "object"
          },
          "agent": {
            "type": "object",
            "required": [
              "input",
              "pending",
              "opened"
            ],
            "properties": {
              "input": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "pending": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "opened": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "annotation": {
                "type": "object",
                "required": [
                  "source",
                  "pending",
                  "opened"
                ],
                "properties": {
                  "source": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "pending": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "opened": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "configuration_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "instance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "plugin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifact": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "additionalProperties": false
          },
          "help": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9._:/-]+$"
                  },
                  "plugin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9._:/-]+$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "artifact": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "instance",
                  "plugin",
                  "revision",
                  "artifact"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "help_group": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          }
        },
        "required": [
          "source",
          "help",
          "help_group"
        ],
        "additionalProperties": false
      },
      "resource_kinds": []
    }
  ],
  "capabilities": [],
  "contexts": [],
  "backend": null,
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "default_configuration": {}
}

{
  "protocol_version": 1,
  "id": "org.rho.process",
  "name": "Processes",
  "version": "0.1.0",
  "description": "Native local process execution, bounded output evidence and original-operation settlement",
  "license": "AGPL-3.0-only",
  "source": {
    "files": [
      "backend/src/main.rs",
      "build.mjs"
    ],
    "lockfiles": [
      "Cargo.lock"
    ],
    "build_instructions": "BUILD.md",
    "build": {
      "command": [
        "node",
        "build.mjs"
      ]
    }
  },
  "dependencies": {},
  "requires": [],
  "views": [],
  "capabilities": [
    {
      "capability": {
        "id": "process.status",
        "version": 1
      },
      "kind": "query",
      "title": "Observe native process activity",
      "description": "Observe native process scheduling or validate a prospective request. Does not start a process, recover work or install software.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "title": "Empty",
        "type": "object"
      },
      "examples": [
        {}
      ],
      "output_schema": {
        "$defs": {
          "ProcessActivity": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "type": "string"
              },
              "phase": {
                "$ref": "#/$defs/ProcessPhase"
              }
            },
            "required": [
              "operation",
              "phase"
            ],
            "type": "object"
          },
          "ProcessPhase": {
            "enum": [
              "waiting",
              "running",
              "awaiting_settlement"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "activities": {
            "description": "Native scheduling only. Committed outcomes belong to operation.get.",
            "items": {
              "$ref": "#/$defs/ProcessActivity"
            },
            "type": "array"
          },
          "capacity": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "activities",
          "capacity"
        ],
        "title": "ProcessStatus",
        "type": "object"
      },
      "recovery_schema": {
        "type": "null"
      },
      "required_scopes": [
        "project.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "process.prepare_local",
        "version": 2
      },
      "kind": "query",
      "title": "Prepare a local process",
      "description": "Observe native process scheduling or validate a prospective request. Does not start a process, recover work or install software.",
      "input_schema": {
        "$defs": {
          "CapabilityKey": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "arguments": true,
          "capability": {
            "$ref": "#/$defs/CapabilityKey"
          },
          "preconditions": true,
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "capability",
          "arguments",
          "preconditions"
        ],
        "title": "PluginPreflightRequest",
        "type": "object"
      },
      "examples": [
        {
          "arguments": {
            "args": [
              "Example\\n"
            ],
            "program": "/usr/bin/printf"
          },
          "capability": {
            "id": "process.run_local",
            "version": 2
          },
          "preconditions": null,
          "target": null
        }
      ],
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "arguments": true,
          "owner_context": true,
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "arguments",
          "owner_context"
        ],
        "title": "PluginPreflightResult",
        "type": "object"
      },
      "recovery_schema": {
        "type": "null"
      },
      "required_scopes": [
        "process.run_local",
        "project.read"
      ],
      "effects": [],
      "cancellation": "unsupported",
      "preflight": null
    },
    {
      "capability": {
        "id": "process.run_local",
        "version": 2
      },
      "kind": "operation",
      "title": "Run a local process",
      "description": "Run one authorized local process in the exact project. Retain bounded original stdout/stderr in a resource, and submit the result through the original Host operation. Trusted native execution is not an OS sandbox.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "args": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "output_limit_bytes": {
            "default": 65536,
            "format": "uint",
            "maximum": 131072,
            "minimum": 1,
            "type": "integer"
          },
          "program": {
            "type": "string"
          },
          "stdin": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "timeout_ms": {
            "default": 60000,
            "format": "uint64",
            "maximum": 3600000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "program"
        ],
        "title": "RunLocalArguments",
        "type": "object"
      },
      "examples": [
        {
          "args": [
            "Example\\n"
          ],
          "program": "/usr/bin/printf"
        }
      ],
      "output_schema": {
        "$defs": {
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          },
          "ProcessTermination": {
            "enum": [
              "exited",
              "cancelled",
              "timed_out",
              "uncertain"
            ],
            "type": "string"
          },
          "ResourceReference": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "exit_signal": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "operation": {
            "type": "string"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "report": {
            "$ref": "#/$defs/ResourceReference",
            "description": "Exact JSON-encoded ProcessReport, including bounded original byte streams."
          },
          "termination": {
            "$ref": "#/$defs/ProcessTermination"
          }
        },
        "required": [
          "operation",
          "report",
          "termination"
        ],
        "title": "ProcessRunResult",
        "type": "object"
      },
      "recovery_schema": {
        "$defs": {
          "InstanceRef": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "plugin": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "instance",
              "plugin",
              "revision",
              "artifact"
            ],
            "type": "object"
          },
          "OutputCapture": {
            "properties": {
              "bytes": {
                "items": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "eof": {
                "type": "boolean"
              },
              "total_bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "bytes",
              "total_bytes",
              "truncated",
              "eof"
            ],
            "type": "object"
          },
          "ProcessTermination": {
            "enum": [
              "exited",
              "cancelled",
              "timed_out",
              "uncertain"
            ],
            "type": "string"
          },
          "ResourceReference": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "digest": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "owner": {
                "$ref": "#/$defs/InstanceRef"
              },
              "resource": {
                "type": "string"
              }
            },
            "required": [
              "owner",
              "resource",
              "digest",
              "media_type",
              "bytes"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "automatic_reexecution": {
            "type": "boolean"
          },
          "native_termination": {
            "anyOf": [
              {
                "$ref": "#/$defs/ProcessTermination"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "type": "string"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "project_root": {
            "type": "string"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResourceReference"
              },
              {
                "type": "null"
              }
            ],
            "description": "Native report transfer may fail after execution. An empty reference never\nestablishes absence of effects or authorizes another execution."
          },
          "report_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_transfer_confirmed": {
            "type": "boolean"
          },
          "stderr": {
            "anyOf": [
              {
                "$ref": "#/$defs/OutputCapture"
              },
              {
                "type": "null"
              }
            ]
          },
          "stdout": {
            "anyOf": [
              {
                "$ref": "#/$defs/OutputCapture"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation",
          "project_root",
          "report_transfer_confirmed",
          "automatic_reexecution"
        ],
        "title": "ProcessRunRecovery",
        "type": "object"
      },
      "required_scopes": [
        "process.run_local",
        "project.read"
      ],
      "effects": [
        "network",
        "process.spawn",
        "project.files"
      ],
      "cancellation": "request",
      "preflight": {
        "id": "process.prepare_local",
        "version": 2
      }
    }
  ],
  "contexts": [],
  "backend": {
    "executable": "dist/rho-process-backend",
    "arguments": []
  },
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "title": "Empty",
    "type": "object"
  },
  "default_configuration": {}
}

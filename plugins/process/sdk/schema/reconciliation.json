{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessReconciliation",
  "type": "object",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/ProcessObservationCompleteness"
    },
    "no_matching_processes_observed": {
      "type": "boolean"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NativeProcessIdentity"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NativeProcessIdentity"
      }
    },
    "signalled": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NativeProcessIdentity"
      }
    },
    "source_operation_id": {
      "type": "string"
    }
  },
  "required": [
    "source_operation_id",
    "observed",
    "signalled",
    "remaining",
    "no_matching_processes_observed",
    "completeness",
    "notices"
  ],
  "$defs": {
    "NativeProcessIdentity": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "started_at_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "pid",
        "started_at_seconds"
      ]
    },
    "ProcessObservationCompleteness": {
      "description": "Completeness of visible native process evidence, distinct from transport status.",
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    }
  }
}
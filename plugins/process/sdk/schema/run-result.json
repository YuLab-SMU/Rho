{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessRunResult",
  "type": "object",
  "properties": {
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "exit_signal": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "operation": {
      "type": "string"
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "report": {
      "description": "Exact JSON-encoded ProcessReport, including bounded original byte streams.",
      "$ref": "#/$defs/ResourceReference"
    },
    "termination": {
      "$ref": "#/$defs/ProcessTermination"
    }
  },
  "additionalProperties": false,
  "required": [
    "operation",
    "report",
    "termination"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ProcessTermination": {
      "type": "string",
      "enum": [
        "exited",
        "cancelled",
        "timed_out",
        "uncertain"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
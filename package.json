{
  "name": "@rho-workspace/local",
  "version": "0.4.0",
  "type": "module",
  "description": "Rho versioned local backend and headless client",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "bin": {
    "rho": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/client.js",
    "./server": "./dist/server.js",
    "./protocol": "./dist/protocol.js"
  },
  "files": [
    "dist",
    "protocol",
    "fixtures",
    "vendor",
    "LICENSE",
    "scripts/acceptance.mjs",
    "scripts/recovery-acceptance.mjs",
    "scripts/support.mjs",
    "docs/HEADLESS.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/protocol.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "prepack": "npm run build && node scripts/check-pack.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "recovery": "node scripts/recovery-acceptance.mjs",
    "agent": "node scripts/agent-experiment.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "@rho-workspace/plugin-contracts": "file:../Rho-plugins/packages/contracts",
    "@rho-workspace/plugin-documents": "file:../Rho-plugins/plugins/documents",
    "@rho-workspace/plugin-files": "file:../Rho-plugins/plugins/files",
    "@rho-workspace/plugin-r": "file:../Rho-plugins/plugins/r",
    "@rho-workspace/plugin-requirements": "file:../Rho-plugins/plugins/requirements",
    "@rho-workspace/plugin-tables": "file:../Rho-plugins/plugins/tables",
    "@rho-workspace/plugin-media": "file:../Rho-plugins/plugins/media",
    "@rho-workspace/plugin-charts": "file:../Rho-plugins/plugins/charts",
    "@rho-workspace/plugin-agent": "file:../Rho-plugins/plugins/agent"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  },
  "bundleDependencies": [
    "ajv",
    "@rho-workspace/plugin-contracts",
    "@rho-workspace/plugin-documents",
    "@rho-workspace/plugin-files",
    "@rho-workspace/plugin-r",
    "@rho-workspace/plugin-requirements",
    "@rho-workspace/plugin-tables",
    "@rho-workspace/plugin-media",
    "@rho-workspace/plugin-charts",
    "@rho-workspace/plugin-agent"
  ],
  "private": true
}

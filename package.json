{
  "name": "@rho-workspace/local",
  "version": "0.4.0",
  "type": "module",
  "description": "Rho local workspace service, scoped browser shell and headless client",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "bin": {
    "rho": "./dist/cli.js",
    "rho-ui": "./scripts/ui-plugin.mjs"
  },
  "exports": {
    ".": "./dist/client.js",
    "./server": "./dist/server.js",
    "./protocol": "./dist/protocol.js",
    "./observation": "./dist/observation.js",
    "./browser": "./dist/browser.js",
    "./ui-contract": "./dist/ui-contract.js"
  },
  "files": [
    "dist",
    "protocol",
    "fixtures",
    "vendor",
    "LICENSE",
    "scripts/acceptance.mjs",
    "scripts/recovery-acceptance.mjs",
    "scripts/support.mjs",
    "docs/HEADLESS.md",
    "docs/COLLABORATION.md",
    "scripts/collaboration-acceptance.mjs",
    "scripts/claude-consumer.mjs",
    "docs/FRONTEND.md",
    "scripts/ui-acceptance.mjs",
    "scripts/u2-ui-acceptance.mjs",
    "scripts/mcp-consumer.mjs",
    "scripts/execution-acceptance.mjs",
    "scripts/person-files-acceptance.mjs",
    "scripts/interaction-acceptance.mjs",
    "scripts/base-r-episode.mjs",
    "scripts/browser-checks.mjs",
    "scripts/frontend-acceptance.mjs",
    "scripts/ui-plugin.mjs",
    "scripts/ui-selection.mjs",
    "scripts/ui-toolchain.json",
    "scripts/ui-preview",
    "web/theme.css",
    "docs/PLUGIN-AUTHORING.md"
  ],
  "scripts": {
    "build": "npm run build:service && npm run build:web",
    "test": "npm run build && node --test test/*.test.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "prepack": "npm run build && node scripts/check-pack.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "recovery": "node scripts/recovery-acceptance.mjs",
    "agent": "node scripts/agent-experiment.mjs",
    "acceptance:collaboration": "node scripts/collaboration-acceptance.mjs",
    "acceptance:collaboration:agent": "RHO_COLLAB_MODEL=1 node scripts/collaboration-acceptance.mjs",
    "build:service": "node scripts/clean-dist.mjs && node scripts/contract-owners.mjs && npm run build:protocol-artifact && node scripts/contract-types.mjs && tsc && node scripts/plugin-inventory.mjs",
    "build:web": "tsc -p tsconfig.web.json && vite build && node scripts/web-manifest.mjs",
    "test:ui": "npm run build && node --test test/browser.test.mjs && node scripts/ui-acceptance.mjs",
    "acceptance:execution": "node scripts/execution-acceptance.mjs",
    "acceptance:person": "node scripts/person-files-acceptance.mjs",
    "acceptance:ui": "node scripts/ui-acceptance.mjs",
    "test:ui:plugins": "npm run build && node scripts/plugin-ui-acceptance.mjs",
    "acceptance:ui:u2": "node scripts/u2-ui-acceptance.mjs",
    "test:task-map": "node --test test/task-map.test.mjs",
    "check:replay": "tsc && node --test test/expression.test.mjs test/trace.test.mjs",
    "test:documents": "node --test test/document-authors.test.mjs test/document-u2.test.mjs",
    "test:tables": "node --test ../Rho-plugins/test/resources.test.mjs",
    "test:files": "node --test --test-name-pattern='completion sidecar|output directory' ../Rho-plugins/test/resources.test.mjs",
    "test:charts": "node --test --test-name-pattern='a plot binds one immutable' ../Rho-plugins/test/resources.test.mjs",
    "test:workspace": "node --test test/workspace.test.mjs",
    "test:annotations": "node --test ../Rho-plugins/test/annotations.test.mjs",
    "test:media": "node --test ../Rho-plugins/test/owners.test.mjs",
    "test:requirements": "node --test --test-name-pattern='base-R requirements' ../Rho-plugins/test/resources.test.mjs",
    "test:native": "node --test test/native-artifacts.test.mjs",
    "test:feedback": "node --test test/feedback-delivery.test.mjs",
    "test:presenter": "node --test test/presenter.test.mjs",
    "acceptance:walkthrough": "node scripts/skill-walkthrough.mjs",
    "acceptance:matrix": "node scripts/matrix.mjs",
    "verify": "node scripts/verification.mjs",
    "test:ui:u2": "npm run build && npm run acceptance:ui:u2",
    "build:contracts": "node scripts/contract-owners.mjs && npm run build:protocol-artifact && node scripts/contract-types.mjs",
    "build:protocol-artifact": "tsc -p tsconfig.protocol.json --noCheck && node scripts/protocol.mjs",
    "check:contracts": "node scripts/contract-owners.mjs --check && tsc -p tsconfig.protocol.json --noCheck && node scripts/protocol.mjs --check && node scripts/contract-types.mjs --check && tsc --noEmit && tsc -p tsconfig.types.json && tsc -p tsconfig.web.json",
    "test:contracts": "node --test test/entry-contracts.test.mjs test/contract-coverage.test.mjs test/protocol.test.mjs test/validate.test.mjs",
    "acceptance:interaction": "node scripts/interaction-acceptance.mjs",
    "acceptance:smoke": "node scripts/install-smoke.mjs",
    "acceptance:shell": "node scripts/shell-acceptance.mjs",
    "acceptance:pages": "node scripts/pages-acceptance.mjs",
    "acceptance:actions": "node scripts/action-acceptance.mjs",
    "acceptance:objects": "node scripts/object-acceptance.mjs",
    "acceptance:continuity": "node scripts/continuity-acceptance.mjs",
    "acceptance:e2e": "node scripts/e2e-acceptance.mjs",
    "perf": "node scripts/performance.mjs",
    "acceptance:interaction:agent": "RHO_INTERACTION_MODEL=1 node scripts/interaction-acceptance.mjs",
    "acceptance:base-r": "node scripts/base-r-episode.mjs",
    "acceptance:frontend": "node scripts/frontend-acceptance.mjs",
    "ui:create": "node scripts/ui-plugin.mjs create",
    "ui:dev": "node scripts/ui-plugin.mjs dev",
    "acceptance:plugin-dx": "node scripts/plugin-dx-acceptance.mjs",
    "acceptance:agent-activity": "node scripts/agent-activity-episode.mjs",
    "acceptance:acp": "node scripts/acp-episode.mjs"
  },
  "dependencies": {
    "@rho-workspace/plugin-agent": "file:../Rho-plugins/plugins/agent",
    "@rho-workspace/plugin-annotations": "file:../Rho-plugins/plugins/annotations",
    "@rho-workspace/plugin-charts": "file:../Rho-plugins/plugins/charts",
    "@rho-workspace/plugin-contracts": "file:../Rho-plugins/packages/contracts",
    "@rho-workspace/plugin-documents": "file:../Rho-plugins/plugins/documents",
    "@rho-workspace/plugin-files": "file:../Rho-plugins/plugins/files",
    "@rho-workspace/plugin-media": "file:../Rho-plugins/plugins/media",
    "@rho-workspace/plugin-r": "file:../Rho-plugins/plugins/r",
    "@rho-workspace/plugin-requirements": "file:../Rho-plugins/plugins/requirements",
    "@rho-workspace/plugin-tables": "file:../Rho-plugins/plugins/tables",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "json-schema-to-typescript": "^16.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "bundleDependencies": [
    "ajv",
    "@rho-workspace/plugin-contracts",
    "@rho-workspace/plugin-documents",
    "@rho-workspace/plugin-files",
    "@rho-workspace/plugin-r",
    "@rho-workspace/plugin-requirements",
    "@rho-workspace/plugin-tables",
    "@rho-workspace/plugin-media",
    "@rho-workspace/plugin-charts",
    "@rho-workspace/plugin-agent",
    "@rho-workspace/plugin-annotations"
  ],
  "private": true
}

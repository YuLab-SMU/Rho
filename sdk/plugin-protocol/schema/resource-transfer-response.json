{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceTransferResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ResourceReference"
        },
        "type": {
          "type": "string",
          "const": "stored"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "Exactly `bytes` raw bytes follow this header, then EOF.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "next": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "offset": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reference": {
              "$ref": "#/$defs/ResourceReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "reference",
            "offset",
            "bytes"
          ]
        },
        "type": {
          "type": "string",
          "const": "data"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "message"
          ]
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
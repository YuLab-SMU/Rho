{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceTransferRequest",
  "type": "object",
  "properties": {
    "parent_request": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "transfer": {
      "$ref": "#/$defs/ResourceTransfer"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "token",
    "parent_request",
    "transfer"
  ],
  "$defs": {
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ResourceDeclaration": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "media_type",
        "bytes"
      ]
    },
    "ResourceRead": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reference": {
          "$ref": "#/$defs/ResourceReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "reference",
        "offset",
        "limit"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    },
    "ResourceTransfer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ResourceDeclaration"
            },
            "type": {
              "type": "string",
              "const": "put"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ResourceRead"
            },
            "type": {
              "type": "string",
              "const": "read"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ]
        }
      ]
    }
  }
}
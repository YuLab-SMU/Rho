{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatePluginTestProject",
  "description": "An explicit backend test gets a fresh native project and journal. No existing\nproject path, session, provider binding or launch credential is accepted.",
  "type": "object",
  "properties": {
    "instances": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioInstance"
      }
    },
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "instances"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "ScenarioInstance": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "configuration": true,
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "optional_capabilities": {
          "description": "Selected declarations remain configuration, not authority to activate.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityKey"
          }
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "revision",
        "artifact",
        "configuration",
        "dependencies"
      ]
    }
  }
}
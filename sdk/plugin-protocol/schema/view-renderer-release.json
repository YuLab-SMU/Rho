{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginViewRendererRelease",
  "type": "object",
  "properties": {
    "released": {
      "description": "False on an identical repeat. This acknowledges only deregistration,\nnever saved content, view closure or backend release.",
      "type": "boolean"
    },
    "renderer": {
      "type": "string"
    },
    "view": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "view",
    "renderer",
    "released"
  ]
}
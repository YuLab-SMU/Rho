{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResolveWindowProvider",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/CapabilityKey"
    },
    "window": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "window",
    "capability"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    }
  }
}
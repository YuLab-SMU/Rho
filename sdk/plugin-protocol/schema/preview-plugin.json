{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewPlugin",
  "description": "Create a disposable presentation instance of an existing immutable artifact.\nIt has no backend, Host grants, provider registrations or project data path.\nOpen/close its views and release it through the ordinary lifecycle ports.",
  "type": "object",
  "properties": {
    "alias": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "configuration": true,
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginPreviewQuery"
      },
      "maxItems": 128
    },
    "revision": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "artifact",
    "alias",
    "configuration",
    "queries"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "PluginPreviewQuery": {
      "description": "An exact query fixture, never a backend reply or scientific evidence. Missing\narguments do not fall through to the real Host, even for read-only queries.",
      "type": "object",
      "properties": {
        "arguments": true,
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "data": true
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "arguments",
        "data"
      ]
    }
  }
}
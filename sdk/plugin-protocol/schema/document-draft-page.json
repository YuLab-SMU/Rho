{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentDraftPage",
  "type": "object",
  "properties": {
    "drafts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentDraftSummary"
      },
      "maxItems": 20
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "drafts"
  ],
  "$defs": {
    "DocumentDraftSummary": {
      "description": "Opaque synchronized metadata; content is read separately at this version.",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        },
        "metadata": true,
        "source": {
          "$ref": "#/$defs/DraftSource"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "draft",
        "source",
        "version",
        "digest",
        "bytes",
        "metadata"
      ]
    },
    "DraftSource": {
      "type": "object",
      "properties": {
        "contribution": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "contribution"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckpointPlugin",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string"
    },
    "changes": {
      "description": "At most 128 edits and 128 KiB of decoded inline content per checkpoint.\nManifest file declarations must describe the complete resulting source tree.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PluginSourceEdit"
      }
    },
    "expected_head": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "branch",
    "expected_head",
    "changes"
  ],
  "$defs": {
    "PluginSourceEdit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "content_base64": {
              "type": "string"
            },
            "executable": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "put"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "content_base64",
            "executable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remove"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Copy exact retained source bytes, including large/binary files, without rebuilding.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "copy"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revision",
            "path"
          ]
        }
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioRevision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "instances": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioInstance"
      }
    },
    "layout": {
      "$ref": "#/$defs/ScenarioLayout"
    },
    "name": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioProvider"
      }
    },
    "scenario": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "scenario",
    "project",
    "name",
    "instances",
    "providers",
    "layout"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    },
    "ScenarioInstance": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "configuration": true,
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "revision",
        "artifact",
        "configuration",
        "dependencies"
      ]
    },
    "ScenarioLayout": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "empty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScenarioLayout"
              }
            },
            "direction": {
              "$ref": "#/$defs/SplitDirection"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "split"
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction",
            "weights",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "tabs"
            },
            "selected": {
              "type": [
                "string",
                "null"
              ]
            },
            "views": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScenarioView"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "views"
          ]
        }
      ]
    },
    "ScenarioProvider": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "instance": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "instance"
      ]
    },
    "ScenarioView": {
      "type": "object",
      "properties": {
        "configuration": true,
        "contribution": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": true,
        "state_revision": {
          "description": "State is only opened under the exact revision that authored its schema.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "instance",
        "contribution",
        "configuration",
        "state",
        "state_revision"
      ]
    },
    "SplitDirection": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadPluginArchive",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reference": {
      "$ref": "#/$defs/PluginArchiveReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "offset",
    "limit"
  ],
  "$defs": {
    "PluginArchiveReference": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "archive",
        "digest",
        "bytes"
      ]
    }
  }
}
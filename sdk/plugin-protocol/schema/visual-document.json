{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualDocument",
  "description": "Both the canvas and declaration editor modify this model. Custom source is\nreferenced by path; it is never reconstructed from a rendered component.",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CustomComponent"
      }
    },
    "data_sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VisualDataSource"
      }
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VisualNode"
      }
    },
    "root": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version",
    "root",
    "nodes",
    "data_sources",
    "components"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "CustomComponent": {
      "type": "object",
      "properties": {
        "export": {
          "type": "string"
        },
        "input_schema": true,
        "output_schema": true,
        "properties_schema": true,
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "export",
        "properties_schema",
        "input_schema",
        "output_schema"
      ]
    },
    "DataBinding": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Property path, interpreted without eval or executable expressions.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "path"
      ]
    },
    "VisualAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "kind": {
              "type": "string",
              "const": "invoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "capability",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "contribution": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "open_view"
            },
            "resource": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DataBinding"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "contribution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "set_state"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "refresh"
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ]
        }
      ]
    },
    "VisualCondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/DataBinding"
            },
            "kind": {
              "type": "string",
              "const": "exists"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/DataBinding"
            },
            "kind": {
              "type": "string",
              "const": "equals"
            },
            "value": true
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/VisualCondition"
            },
            "kind": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "condition"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VisualCondition"
              }
            },
            "kind": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conditions"
          ]
        }
      ]
    },
    "VisualDataSource": {
      "type": "object",
      "properties": {
        "arguments": true,
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "subscribe": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "arguments",
        "subscribe"
      ]
    },
    "VisualNode": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DataBinding"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/VisualAction"
            }
          }
        },
        "kind": {
          "$ref": "#/$defs/VisualNodeKind"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "style_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "visible_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualCondition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "children",
        "properties",
        "style_tokens",
        "bindings",
        "events"
      ]
    },
    "VisualNodeKind": {
      "type": "string",
      "enum": [
        "container",
        "split",
        "tabs",
        "text",
        "button",
        "form",
        "list",
        "table",
        "media",
        "custom"
      ]
    }
  }
}
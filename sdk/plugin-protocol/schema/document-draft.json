{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentDraft",
  "type": "object",
  "properties": {
    "content": {
      "$ref": "#/$defs/DraftContent"
    },
    "discarded": {
      "description": "Explicit discard releases content and its source revision. The tombstone\nprevents a delayed first save from recreating the discarded identity.",
      "type": "boolean"
    },
    "draft": {
      "type": "string"
    },
    "metadata": true,
    "principal": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/DraftSource"
    },
    "version": {
      "description": "One draft's compare-and-swap version, never a scientific revision.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "window": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "draft",
    "project",
    "principal",
    "window",
    "source",
    "version",
    "content",
    "metadata",
    "discarded"
  ],
  "$defs": {
    "DraftChunkReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes"
      ]
    },
    "DraftContent": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chunks": {
          "description": "Canonical 64 KiB chunks, except for the final chunk. Empty content has\nno chunks. Full content and every chunk are verified before publication.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftChunkReference"
          }
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes",
        "chunks"
      ]
    },
    "DraftSource": {
      "type": "object",
      "properties": {
        "contribution": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "contribution"
      ]
    }
  }
}
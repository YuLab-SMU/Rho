{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginArchiveProgress",
  "type": "object",
  "properties": {
    "complete": {
      "description": "All ranges are staged. This alone is not package validation or import.",
      "type": "boolean"
    },
    "received": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reference": {
      "$ref": "#/$defs/PluginArchiveReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "received",
    "complete"
  ],
  "$defs": {
    "PluginArchiveReference": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "archive",
        "digest",
        "bytes"
      ]
    }
  }
}
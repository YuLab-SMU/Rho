{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewContext",
  "type": "object",
  "properties": {
    "inclusion": {
      "description": "Owner-defined inclusion, such as a captured selection or a table range."
    },
    "max_bytes": {
      "type": "integer",
      "format": "uint32",
      "maximum": 65536,
      "minimum": 1
    },
    "reference": {
      "$ref": "#/$defs/ContextReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "inclusion",
    "max_bytes"
  ],
  "$defs": {
    "ContextReference": {
      "type": "object",
      "properties": {
        "contribution": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/InstanceRef"
        },
        "selector": {
          "description": "Owner-defined identity and observed native version/digest. Preview must\nrevalidate these against the original source; never silently refresh them."
        },
        "window": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "contribution",
        "window",
        "selector"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    }
  }
}
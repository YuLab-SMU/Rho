{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioPage",
  "type": "object",
  "properties": {
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioSummary"
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false,
  "required": [
    "scenarios"
  ],
  "$defs": {
    "ScenarioSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "scenario",
        "revision",
        "name"
      ]
    }
  }
}
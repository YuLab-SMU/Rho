{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginArchiveReceipt",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plugin": {
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/PluginArchiveReference"
    },
    "revision": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "revision",
    "plugin",
    "artifacts"
  ],
  "$defs": {
    "PluginArchiveReference": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "archive",
        "digest",
        "bytes"
      ]
    }
  }
}
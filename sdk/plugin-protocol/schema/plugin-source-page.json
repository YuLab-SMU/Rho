{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginSourcePage",
  "type": "object",
  "properties": {
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PackageFile"
      }
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "files",
    "total"
  ],
  "$defs": {
    "PackageFile": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes",
        "executable"
      ]
    }
  }
}
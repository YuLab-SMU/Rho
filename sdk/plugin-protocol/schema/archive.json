{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginArchive",
  "description": "A bounded, versioned local archive. Content-addressed blobs avoid duplicate bytes.\nJSON plus base64 makes the import format independent of native archive extractors.",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BuildArtifact"
      }
    },
    "blobs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "revision": {
      "$ref": "#/$defs/PluginRevision"
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version",
    "revision",
    "artifacts",
    "blobs"
  ],
  "$defs": {
    "BackendEntrypoint": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executable": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "executable",
        "arguments"
      ]
    },
    "BuildArtifact": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PackageFile"
          }
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "target": {
          "description": "Examples: ui-web, aarch64-apple-darwin. No platform is selected implicitly.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "target",
        "files"
      ]
    },
    "BuildRecipe": {
      "type": "object",
      "properties": {
        "command": {
          "description": "Executable and literal arguments, without a shell interpolation layer.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "CancellationSupport": {
      "type": "string",
      "enum": [
        "unsupported",
        "request"
      ]
    },
    "CapabilityContribution": {
      "type": "object",
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/CancellationSupport"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "description": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "examples": {
          "description": "Valid scientific arguments used in discovery; the Host adds provider binding.",
          "type": "array",
          "items": true
        },
        "input_schema": true,
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "output_schema": true,
        "preflight": {
          "description": "Optional read-only owner preflight, invoked before Operation admission.",
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recovery_schema": true,
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "kind",
        "title",
        "description",
        "input_schema",
        "examples",
        "output_schema",
        "recovery_schema",
        "required_scopes",
        "effects",
        "cancellation"
      ]
    },
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "CapabilityKind": {
      "type": "string",
      "enum": [
        "query",
        "control",
        "operation",
        "runtime"
      ]
    },
    "CapabilityRequirement": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "scopes"
      ]
    },
    "ContextContribution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "search": {
          "$ref": "#/$defs/CapabilityKey"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "search",
        "preview"
      ]
    },
    "PackageFile": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes",
        "executable"
      ]
    },
    "PluginDependency": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "revision"
      ]
    },
    "PluginManifest": {
      "type": "object",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackendEntrypoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityContribution"
          }
        },
        "configuration_schema": true,
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextContribution"
          }
        },
        "default_configuration": true,
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginDependency"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          }
        },
        "source": {
          "$ref": "#/$defs/SourceDeclaration"
        },
        "version": {
          "description": "Human-readable only. All bindings use revision and artifact digests.",
          "type": "string"
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewContribution"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "id",
        "name",
        "version",
        "description",
        "license",
        "source",
        "dependencies",
        "requires",
        "views",
        "capabilities",
        "contexts",
        "configuration_schema",
        "default_configuration"
      ]
    },
    "PluginRevision": {
      "type": "object",
      "properties": {
        "files": {
          "description": "Includes plugin.json, declarations, lockfiles and all first-party source.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PackageFile"
          }
        },
        "id": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/PluginManifest"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "manifest",
        "files"
      ]
    },
    "SourceDeclaration": {
      "type": "object",
      "properties": {
        "build": {
          "description": "Executed only by an explicit development build, never by import or query.",
          "anyOf": [
            {
              "$ref": "#/$defs/BuildRecipe"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_instructions": {
          "type": "string"
        },
        "files": {
          "description": "Every first-party source file must be included in the package snapshot.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "lockfiles",
        "build_instructions"
      ]
    },
    "ViewContribution": {
      "type": "object",
      "properties": {
        "configuration_schema": true,
        "entrypoint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "resource_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "state_schema": true,
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "entrypoint",
        "state_schema",
        "configuration_schema",
        "resource_kinds"
      ]
    }
  }
}
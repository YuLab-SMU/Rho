{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginTestProjectPage",
  "type": "object",
  "properties": {
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginTestProjectObservation"
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false,
  "required": [
    "projects"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "CreatePluginTestProject": {
      "description": "An explicit backend test gets a fresh native project and journal. No existing\nproject path, session, provider binding or launch credential is accepted.",
      "type": "object",
      "properties": {
        "instances": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ScenarioInstance"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "instances"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "PluginTestProject": {
      "description": "Historical lifecycle metadata. Ready alone never proves a prior Host or\nbackend still exists; use the observation's explicit native-presence flag.",
      "type": "object",
      "properties": {
        "activation_operations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instances": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/InstanceRef"
          }
        },
        "principal": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/CreatePluginTestProject"
        },
        "source_operation_id": {
          "type": "string"
        },
        "source_project": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PluginTestProjectState"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "source_project",
        "principal",
        "source_operation_id",
        "project",
        "directory",
        "selection",
        "version",
        "state",
        "instances",
        "activation_operations"
      ]
    },
    "PluginTestProjectObservation": {
      "type": "object",
      "properties": {
        "observed_in_this_host": {
          "type": "boolean"
        },
        "project": {
          "$ref": "#/$defs/PluginTestProject"
        }
      },
      "additionalProperties": false,
      "required": [
        "project",
        "observed_in_this_host"
      ]
    },
    "PluginTestProjectState": {
      "type": "string",
      "enum": [
        "preparing",
        "ready",
        "stopping",
        "stopped",
        "failed"
      ]
    },
    "ScenarioInstance": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "configuration": true,
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "optional_capabilities": {
          "description": "Selected declarations remain configuration, not authority to activate.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityKey"
          }
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "revision",
        "artifact",
        "configuration",
        "dependencies"
      ]
    }
  }
}
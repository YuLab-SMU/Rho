{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginViewMessage",
  "type": "object",
  "properties": {
    "body": {
      "$ref": "#/$defs/PluginViewRequest"
    },
    "connection": {
      "type": "string"
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "request": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "test_project": {
      "description": "Select only an already live child for ordinary port calls. Intrinsic\nview state, close cooperation and presentation stay with this view.",
      "type": [
        "string",
        "null"
      ]
    },
    "view": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "connection",
    "view",
    "sequence",
    "request",
    "body"
  ],
  "$defs": {
    "CapabilityKey": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "InstanceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instance",
        "plugin",
        "revision",
        "artifact"
      ]
    },
    "PluginArchiveReference": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "archive",
        "digest",
        "bytes"
      ]
    },
    "PluginViewRequest": {
      "description": "Every request crosses the containing shell's scoped Host port. No browser\ncredential, project root or user identity is accepted from the iframe.",
      "oneOf": [
        {
          "description": "Register only after installing the local close-time flush handler.",
          "type": "object",
          "properties": {
            "renderer": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "register_close_handler"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "renderer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "renderer": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "observe_lifecycle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "renderer"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string"
            },
            "renderer": {
              "type": "string"
            },
            "state_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "prepare_close"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "renderer",
            "operation",
            "state_version"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "renderer": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "refuse_close"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "renderer",
            "operation",
            "reason"
          ]
        },
        {
          "description": "Reserve a browser text-copy action while the user gesture is current.\nHost validation is not confirmation that the clipboard was written.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "begin_text_copy"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "copy_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "finish_text_copy"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "copy_id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "copy_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "cancel_text_copy"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "copy_id"
          ]
        },
        {
          "description": "Request a new browser tab after an explicit gesture. The Host verifies\nview authority; only the container can acknowledge native navigation.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_external_url"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "Open this containing window's counterpart in an explicitly selected\ndisposable project. The shell alone constructs its private launch URL.",
          "type": "object",
          "properties": {
            "test_project": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "open_test_workspace"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "test_project"
          ]
        },
        {
          "description": "Admit an explicit original-resource download. This is not evidence that\nthe containing browser requested or completed a file download.",
          "type": "object",
          "properties": {
            "filename": {
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/ResourceReference"
            },
            "type": {
              "type": "string",
              "const": "download_resource"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reference",
            "filename"
          ]
        },
        {
          "description": "Download exact package bytes through the declared archive-read port.\nPresentation acknowledgement alone does not prove that a file was saved.",
          "type": "object",
          "properties": {
            "filename": {
              "type": "string"
            },
            "reference": {
              "$ref": "#/$defs/PluginArchiveReference"
            },
            "type": {
              "type": "string",
              "const": "download_archive"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reference",
            "filename"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "type": {
              "type": "string",
              "const": "control"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "capability",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "type": {
              "type": "string",
              "const": "query"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "capability",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": true,
            "capability": {
              "$ref": "#/$defs/CapabilityKey"
            },
            "preconditions": {
              "type": "array",
              "items": true
            },
            "request_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "invoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "request_id",
            "capability",
            "arguments",
            "preconditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "get_operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "operation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "cancel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "operation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expected_version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "state": true,
            "type": {
              "type": "string",
              "const": "set_state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "expected_version",
            "state"
          ]
        }
      ]
    },
    "ResourceReference": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/InstanceRef"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner",
        "resource",
        "digest",
        "media_type",
        "bytes"
      ]
    }
  }
}
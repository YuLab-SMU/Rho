{
  "name": "dsh-rho",
  "version": "0.0.1",
  "private": true,
  "description": "Rho result views and version-bound questions inside DeepSeek Harness",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./lib/index.cjs",
  "exports": { ".": "./lib/index.cjs", "./client": "./lib/client.js" },

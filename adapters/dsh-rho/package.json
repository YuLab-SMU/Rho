{
  "name": "dsh-rho",
  "version": "0.1.6",
  "description": "Connect DeepSeek Harness to an existing Rho project and its full WebUI",
  "license": "AGPL-3.0-only",
  "author": "YuLab-SMU",
  "homepage": "https://yulab-smu.top/Rho/docs/reference/deepseek-harness.html",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "rho",
    "science",
    "data-analysis",
    "notebook"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuLab-SMU/Rho.git",
    "directory": "adapters/dsh-rho"
  },
  "main": "./src/host.cjs",
  "exports": {
    ".": "./src/host.cjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/host.cjs",
    "src/connection.cjs",
    "lib/client.js",
    "lib/observe.cjs",
    "lib/observe-source.json",
    "lib/observe.LICENSES.txt",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/en.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.22.0 <23",
    "dsh": "0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5 || 0.2.2-rc.1"
  }
}

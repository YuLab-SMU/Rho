{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rho",
  "version": "0.4.0-dev.27",
  "identifier": "org.yulab.rho",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rho",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "An agent-native scientific workbench for R",
    "longDescription": "Rho is a lightweight R workbench with an Ark-backed live session and an aisdk-powered AI collaborator."
  }
}

{
  "name": "rho-desktop-frontend",
  "private": true,
  "version": "0.4.1-dev.22",
  "description": "Frontend tooling for the Rho Surface Runtime",
  "license": "AGPL-3.0-only",
  "scripts": {
    "rsr:dev": "vite --config ui/vite.config.mts",
    "rsr:dev:desktop": "node ../scripts/run-rsr-debug.mjs",
    "rsr:build": "vite build --config ui/vite.config.mts",
    "rsr:preview": "vite preview --config ui/vite.config.mts",
    "rsr:typecheck": "tsc --noEmit --project ui/tsconfig.app.json --pretty false && tsc --noEmit --project ui/tsconfig.node.json --pretty false",
    "rsr:lint": "eslint ui/src ui/*.mts",
    "rsr:test": "vitest run --config ui/vitest.config.mts",
    "rsr:test:fast": "vitest run --config ui/vitest.fast.config.mts",
    "rsr:test:integration": "vitest run --config ui/vitest.config.mts src/app/App.test.tsx src/app/agent/AgentSurface.test.tsx --maxWorkers=1",
    "rsr:test:acceptance-contracts": "vitest run --config ui/vitest.config.mts src/acceptance",
    "rsr:test:contract": "node ../scripts/test-rsr-contract.mjs",
    "rsr:test:assets": "node ../scripts/test-rsr-generated-assets.mjs",
    "rsr:test:browser": "node ../scripts/test-rsr-browser-smoke.mjs",
    "rsr:test:interactions": "node ../scripts/test-rsr-interactions.mjs",
    "rsr:test:identity": "node ../scripts/test-rsr-build-identity.mjs && node ../scripts/test-rsr-process-identity.mjs",
    "rsr:test:commands": "node ../scripts/test-tauri-command-inventory.mjs --test && node ../scripts/test-tauri-command-inventory.mjs",
    "rsr:test:bindings:static": "node ../scripts/test-generated-bindings.mjs --static",
    "rsr:test:bindings": "node ../scripts/test-generated-bindings.mjs --full",
    "rsr:test:runtime-output-bindings": "node ../scripts/test-runtime-output-bindings.mjs",
    "rsr:test:runtime-bindings": "node ../scripts/test-runtime-bindings.mjs",
    "rsr:test:surface-studio-bindings": "node ../scripts/test-surface-studio-bindings.mjs",
    "rsr:test:resource-bindings": "node ../scripts/test-resource-bindings.mjs",
    "rsr:test:profile-bindings": "node ../scripts/test-profile-bindings.mjs",
    "rsr:test:workbench-projection-bindings": "node ../scripts/test-workbench-projection-bindings.mjs",
    "rsr:test:agent-conversation-bindings": "node ../scripts/test-agent-conversation-bindings.mjs",
    "rsr:test:agent-turn-bindings": "node ../scripts/test-agent-turn-bindings.mjs",
    "rsr:test:agent-execution-bindings": "node ../scripts/test-agent-execution-bindings.mjs",
    "rsr:test:agent-runtime-bindings": "node ../scripts/test-agent-runtime-bindings.mjs",
    "rsr:test:plugin-surface-bindings": "node ../scripts/test-plugin-surface-bindings.mjs",
    "rsr:test:project-bindings": "node ../scripts/test-project-bindings.mjs",
    "rsr:test:kernel-bindings": "node ../scripts/test-kernel-bindings.mjs",
    "rsr:test:generated-transport-boundary": "node ../scripts/test-generated-transport-boundary.mjs",
    "rsr:test:check-bindings": "node ../scripts/test-check-bindings.mjs",
    "rsr:test:authority-bindings": "node ../scripts/test-authority-bindings.mjs",
    "rsr:test:evidence-graph-bindings": "node ../scripts/test-evidence-graph-bindings.mjs",
    "rsr:test:startup-bindings": "node ../scripts/test-startup-bindings.mjs",
    "rsr:test:history-bindings": "node ../scripts/test-history-bindings.mjs",
    "rsr:test:environment-bindings": "node ../scripts/test-environment-bindings.mjs",
    "rsr:test:git-bindings": "node ../scripts/test-git-bindings.mjs",
    "rsr:test:governance": "node ../scripts/test-governance.mjs && node ../scripts/governance.mjs check",
    "rsr:test:production-invariants": "node ../scripts/test-production-invariants.mjs",
    "rsr:test:release-contracts": "node ../scripts/test-release-contracts.mjs",
    "rsr:test:tiers": "node ../scripts/test-test-tiers.mjs",
    "rsr:test:dev-checkpoint": "node ../scripts/test-dev-checkpoint.mjs",
    "rsr:test:dev-lanes": "node ../scripts/test-dev-lanes.mjs",
    "rsr:test:visual-acceptance": "node ../scripts/test-visual-acceptance.mjs",
    "rsr:accept:exact": "node ../scripts/accept-rsr-exact-app.mjs",
    "rsr:accept:visual": "node ../scripts/visual-acceptance.mjs run",
    "rsr:quick": "node ../scripts/dev-checkpoint.mjs quick --ui",
    "rsr:check:resume": "node ../scripts/dev-checkpoint.mjs rsr-final",
    "rsr:check:resume:stable": "node ../scripts/dev-checkpoint.mjs rsr-final --stable-ui",
    "rsr:check": "npm run rsr:typecheck && npm run rsr:lint && npm run rsr:test:bindings:static && npm run rsr:test:commands && npm run rsr:test:generated-transport-boundary && npm run rsr:test:contract && npm run rsr:test:tiers && npm run rsr:test:fast",
    "rsr:check:contracts": "npm run rsr:typecheck && npm run rsr:test:commands && npm run rsr:test:bindings && npm run rsr:test:generated-transport-boundary && npm run rsr:test:contract && npm run rsr:test:acceptance-contracts",
    "rsr:check:full": "npm run rsr:typecheck && npm run rsr:lint && npm run rsr:test:identity && npm run rsr:test:commands && npm run rsr:test:bindings && npm run rsr:test:generated-transport-boundary && npm run rsr:test:governance && npm run rsr:test:contract && npm run rsr:test:tiers && npm run rsr:test && npm run rsr:build && npm run rsr:test:assets",
    "rsr:acceptance": "npm run rsr:test:browser && npm run rsr:test:interactions && npm run rsr:test:visual-acceptance",
    "rsr:release": "npm run rsr:check:full && npm run rsr:test:production-invariants && npm run rsr:acceptance && npm run rsr:test:release-contracts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dockview-react": "8.2.0",
    "dompurify": "3.4.13",
    "katex": "0.16.22",
    "marked": "18.0.9",
    "monaco-editor": "0.55.1",
    "papaparse": "5.5.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.61.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.13"
    }
  }
}

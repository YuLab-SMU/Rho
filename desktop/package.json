{
  "name": "rho-desktop-frontend",
  "private": true,
  "version": "0.4.1-dev.15",
  "description": "Frontend tooling for the Rho Surface Runtime",
  "license": "AGPL-3.0-only",
  "scripts": {
    "rsr:dev": "vite --config ui/vite.config.mts",
    "rsr:dev:desktop": "node ../scripts/run-rsr-debug.mjs",
    "rsr:build": "vite build --config ui/vite.config.mts",
    "rsr:preview": "vite preview --config ui/vite.config.mts",
    "rsr:typecheck": "tsc --noEmit --project ui/tsconfig.app.json --pretty false && tsc --noEmit --project ui/tsconfig.node.json --pretty false",
    "rsr:lint": "eslint ui/src ui/*.mts",
    "rsr:test": "vitest run --config ui/vitest.config.mts",
    "rsr:test:contract": "node ../scripts/test-rsr-contract.mjs",
    "rsr:test:assets": "node ../scripts/test-rsr-generated-assets.mjs",
    "rsr:test:browser": "node ../scripts/test-rsr-browser-smoke.mjs",
    "rsr:test:interactions": "node ../scripts/test-rsr-interactions.mjs",
    "rsr:test:identity": "node ../scripts/test-rsr-build-identity.mjs && node ../scripts/test-rsr-process-identity.mjs",
    "rsr:test:commands": "node ../scripts/test-tauri-command-inventory.mjs --test && node ../scripts/test-tauri-command-inventory.mjs",
    "rsr:test:runtime-output-bindings": "node ../scripts/test-runtime-output-bindings.mjs",
    "rsr:test:runtime-bindings": "node ../scripts/test-runtime-bindings.mjs",
    "rsr:test:surface-studio-bindings": "node ../scripts/test-surface-studio-bindings.mjs",
    "rsr:test:resource-bindings": "node ../scripts/test-resource-bindings.mjs",
    "rsr:test:profile-bindings": "node ../scripts/test-profile-bindings.mjs",
    "rsr:test:agent-conversation-bindings": "node ../scripts/test-agent-conversation-bindings.mjs",
    "rsr:test:agent-turn-bindings": "node ../scripts/test-agent-turn-bindings.mjs",
    "rsr:test:agent-execution-bindings": "node ../scripts/test-agent-execution-bindings.mjs",
    "rsr:test:agent-runtime-bindings": "node ../scripts/test-agent-runtime-bindings.mjs && node ../scripts/test-agent-dependency-diagnostics.mjs --test && node ../scripts/test-agent-dependency-diagnostics.mjs",
    "rsr:test:agent-settings-bindings": "node ../scripts/test-agent-settings-bindings.mjs",
    "rsr:test:agent-file-bindings": "node ../scripts/test-agent-file-bindings.mjs",
    "rsr:test:plugin-surface-bindings": "node ../scripts/test-plugin-surface-bindings.mjs",
    "rsr:test:project-bindings": "node ../scripts/test-project-bindings.mjs",
    "rsr:test:architecture": "node ../scripts/test-architecture-program.mjs && node ../scripts/architecture-program.mjs validate --root ..",
    "rsr:test:cutover": "node ../scripts/test-rsr-cutover.mjs",
    "rsr:accept:exact": "node ../scripts/accept-rsr-exact-app.mjs",
    "rsr:check": "npm run rsr:typecheck && npm run rsr:lint && npm run rsr:test:identity && npm run rsr:test:commands && npm run rsr:test:runtime-output-bindings && npm run rsr:test:runtime-bindings && npm run rsr:test:surface-studio-bindings && npm run rsr:test:resource-bindings && npm run rsr:test:profile-bindings && npm run rsr:test:agent-conversation-bindings && npm run rsr:test:agent-turn-bindings && npm run rsr:test:agent-execution-bindings && npm run rsr:test:agent-runtime-bindings && npm run rsr:test:agent-settings-bindings && npm run rsr:test:agent-file-bindings && npm run rsr:test:plugin-surface-bindings && npm run rsr:test:project-bindings && npm run rsr:test:architecture && npm run rsr:test:contract && npm run rsr:test && npm run rsr:build && npm run rsr:test:assets && npm run rsr:test:cutover && npm run rsr:test:browser && npm run rsr:test:interactions"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dompurify": "3.4.13",
    "katex": "0.16.22",
    "marked": "18.0.9",
    "monaco-editor": "0.55.1",
    "papaparse": "5.5.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.61.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.13"
    }
  }
}

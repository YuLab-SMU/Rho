  {
   "id": "bdc2f39e4f52c10e40486fca81d7bc5c11c69ae5969f29894886b26a48aabc0a",
   "path": "analysis.R",
   "initialDigest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
   "history": [
    {
     "version": 2,
     "at": "2026-10-24T14:37:55.760Z",
     "author": "agent:98032e9878600a62c3fea6b35d7c5ee2",
     "afterDigest": "03d0c24b1784bf80488c60367db614052a299584af393007b7a79192dac0c2aa",
     "edits": [
      {
       "from": 0,
       "to": 0,
       "insert": "# Question: how much of the temperature effect on ozone survives adjustment for\n# wind and solar radiation, and how much of the change is just a change of sample?\n# Every number below comes from this run; nothing is typed in from elsewhere.\nout <- commandArgs(trailingOnly = TRUE)[1]\n\ndata(airquality, package = \"datasets\")\nd <- datasets::airquality\nvars <- c(\"Ozone\", \"Solar.R\", \"Wind\", \"Temp\")\nmiss <- vapply(vars, function(v) sum(is.na(d[[v]])), integer(1))\n\n# ozone-core drops only rows without ozone/wind/temp; complete also drops solar.\ncore <- d[complete.cases(d[, c(\"Ozone\", \"Wind\", \"Temp\")]), ]\ncc   <- d[complete.cases(d[, vars]), ]\n\ntidy <- function(label, sample, m) {\n  co <- summary(m)$coefficients\n  data.frame(model = label, sample = sample, n = nobs(m), term = rownames(co),\n             estimate = co[, \"Estimate\"], std.error = co[, \"Std. Error\"],\n             statistic = co[, \"t value\"], p.value = co[, \"Pr(>|t|)\"],\n             r2 = summary(m)$r.squared, adj.r2 = summary(m)$adj.r.squared,\n             stringsAsFactors = FALSE, row.names = NULL)\n}\n\nm0 <- lm(Ozone ~ Temp, core)                        # A: raw, ozone-core\nm1 <- lm(Ozone ~ Temp + Wind, core)                 # B: wind, same rows\nm2 <- lm(Ozone ~ Temp + Wind, cc)                   # C: wind, complete rows\nm3 <- lm(Ozone ~ Temp + Wind + Solar.R, cc)         # D: + solar, complete rows\ncoefs <- rbind(tidy(\"A\", \"ozone-core\", m0), tidy(\"B\", \"ozone-core\", m1),\n               tidy(\"C\", \"complete\", m2), tidy(\"D\", \"complete\", m3))\nwrite.csv(coefs, file.path(out, \"coefficients.csv\"), row.names = FALSE)\n\ntemp_row <- function(label, sample, m) {\n  est <- unname(coef(m)[\"Temp\"]); se <- unname(sqrt(vcov(m)[\"Temp\", \"Temp\"]))\n  tc <- qt(0.975, df.residual(m))\n  data.frame(model = label, sample = sample, n = nobs(m), estimate = est,\n             std.error = se, ci.low = est - tc * se, ci.high = est + tc * se,\n             p.value = unname(summary(m)$coefficients[\"Temp\", \"Pr(>|t|)\"]))\n}\neffects <- rbind(temp_row(\"A\", \"ozone-core\", m0), temp_row(\"B\", \"ozone-core\", m1),\n                 temp_row(\"C\", \"complete\", m2), temp_row(\"D\", \"complete\", m3))\nbase <- effects$estimate[1]\neffects$share.of.A <- effects$estimate / base\neffects$change.vs.previous <- c(NA, diff(effects$estimate) / base)\nwrite.csv(effects, file.path(out, \"effects.csv\"), row.names = FALSE)\n\na01 <- anova(m0, m1); a23 <- anova(m2, m3)\ntests <- data.frame(test = c(\"wind added (B vs A)\", \"solar added (D vs C)\"),\n                    df = c(a01$Df[2], a23$Df[2]),\n                    f = c(a01$F[2], a23$F[2]),\n                    p.value = c(a01$`Pr(>F)`[2], a23$`Pr(>F)`[2]))\nwrite.csv(tests, file.path(out, \"tests.csv\"), row.names = FALSE)\n\npng(file.path(out, \"temp-effect.png\"), width = 1040, height = 620, res = 110)\nop <- par(mar = c(4.6, 8.2, 4, 2))\nplot(NA, xlim = range(c(effects$ci.low, effects$ci.high)), ylim = c(0.4, nrow(effects) + 0.6),\n     yaxt = \"n\", xlab = \"Ozone change per 1 F temperature (ppb, 95% CI)\", ylab = \"\",\n     main = \"Temperature effect under four specifications\")\nabline(h = seq_len(nrow(effects)), col = \"grey92\"); abline(v = 0, lty = 2, col = \"grey45\")\nsegments(effects$ci.low, seq_len(nrow(effects)), effects$ci.high, seq_len(nrow(effects)), lwd = 2.2)\npoints(effects$estimate, seq_len(nrow(effects)), pch = 19, cex = 1.5)\naxis(2, at = seq_len(nrow(effects)), las = 1, cex.axis = 0.85,\n     labels = sprintf(\"%s  n=%d  %s\", effects$model, effects$n, effects$sample))\ntext(effects$estimate, seq_len(nrow(effects)) + 0.24, sprintf(\"%.3f\", effects$estimate), cex = 0.72)\npar(op); invisible(dev.off())\n\nfiles <- c(\"coefficients.csv\", \"effects.csv\", \"tests.csv\", \"temp-effect.png\")\nartifacts <- lapply(files, function(f) {\n  p <- file.path(out, f)\n  list(path = f, bytes = unname(file.size(p)),\n       sha256 = digest::digest(p, algo = \"sha256\", file = TRUE))\n})\nmanifest <- list(schemaVersion = 1L, complete = TRUE, artifacts = artifacts)\nwriteLines(jsonlite::toJSON(manifest, auto_unbox = TRUE), file.path(dirname(out), \"inventory.json\"))\n\ncat(\"n rows:\", nrow(d), \" missing:\", paste(names(miss), miss, sep = \"=\", collapse = \" \"), \"\\n\")\ncat(\"temp coefficient by model (ppb per F):\\n\"); print(effects[, c(\"model\", \"n\", \"estimate\", \"ci.low\", \"ci.high\")], row.names = FALSE)\ncat(\"share of raw estimate kept:\", paste(sprintf(\"%.3f\", effects$share.of.A), collapse = \" \"), \"\\n\")\n"
      }
     ]
    },

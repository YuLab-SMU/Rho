  {
   "id": "ae9bbf5f7bad1a930f0493ecdcfaf0b70197c9d5b38e92374092d8cc22a3de11",
   "path": "stats.R",
   "initial": "# Summary statistics that check.R relies on.\nweighted_mean <- function(x, w) sum(x * w) / length(x)\n\ntrimmed_mean <- function(x, trim) {\n  x <- sort(x)\n  n <- length(x)\n  k <- floor(n * trim)\n  mean(x[k:(n - k)])\n}\n\nzscore <- function(x) (x - mean(x)) / sqrt(mean((x - mean(x))^2))\n",
   "initialDigest": "9465f4f6f7665aab88a175938d1dc1c142c8843f9ca3cc282c2315de1d9517a9",

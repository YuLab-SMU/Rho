      "delete_work_package": "P8-08",
      "compatibility_allowed": false
    },
    {
      "edge": "fixture -> registered Tauri command",
      "current_source": "desktop/src-tauri/src/commands/{agent,jobs}",
      "replacement_owner": "authoritative application state",
      "delete_work_package": "P8-08",
      "compatibility_allowed": false
    },
    {

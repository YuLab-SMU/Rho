package rho:plugin@1.0.0;

interface lifecycle {
  activate: func(api-version: u64) -> result<_, string>;
  echo: func(payload: string) -> result<string, string>;
  heartbeat: func() -> result<_, string>;
  quiesce: func() -> result<_, string>;
  dispose: func() -> result<_, string>;
}

interface guest-calls {
  record broker-request {
    call-id: string,
    handle-id: string,
    permission: string,
    operation: string,
    args-json: string,
  }

  record completion {
    call-id: string,
    result-json: string,
  }

  record guest-error {
    call-id: string,
    code: string,
  }

  variant guest-step {
    broker-request(broker-request),
    complete(completion),
    error(guest-error),
  }

  begin: func(call-id: string, request-json: string) -> guest-step;
  resume: func(call-id: string, result-json: string) -> guest-step;
  cancel: func(call-id: string) -> result<bool, string>;
}

world plugin {
  export lifecycle;
  export guest-calls;
}

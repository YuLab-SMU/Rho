{
  "schema_version": 1,
  "checks": {
    "docs.index": {
      "command": ["node", "scripts/governance.mjs", "check"]
    },
    "docs.tool": {
      "command": ["node", "scripts/test-governance.mjs"]
    },
    "development.checkpoint": {
      "command": ["node", "scripts/test-dev-checkpoint.mjs"]
    },
    "development.lanes": {
      "command": ["node", "scripts/test-dev-lanes.mjs"]
    },
    "development.integration": {
      "command": ["node", "scripts/test-worktree-integration.mjs"]
    },
    "frontend": {
      "command": ["npm", "--prefix", "desktop", "run", "rsr:check"]
    },
    "r.agent": {
      "command": ["Rscript", "-e", "testthat::test_local('r/rho.agent')"]
    },
    "r.bridge": {
      "command": ["Rscript", "-e", "testthat::test_local('r/rho.bridge')"]
    },
    "release.candidate": {
      "command": ["node", "scripts/candidate-release.mjs", "--test", "true"]
    },
    "release.signing": {
      "command": ["node", "scripts/test-signpath-candidate-workflow.mjs"]
    },
    "release.site": {
      "command": ["node", "scripts/generate-update-site.mjs", "--test", "true"]
    },
    "release.updater": {
      "command": ["node", "scripts/tauri-native-updater.mjs", "--test", "true"]
    },
    "rust.extensions": {
      "command": ["cargo", "test", "-p", "rho-extension-runtime", "-p", "rho-plugin-dev", "--locked"]
    },
    "rust.store": {
      "command": ["cargo", "test", "-p", "rho-store", "--locked"]
    },
    "rust.workspace": {
      "command": ["cargo", "test", "--workspace", "--locked"]
    }
  },
  "areas": {
    "documentation": {
      "sources": [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "docs/**",
        "governance/**",
        "scripts/governance.mjs",
        "scripts/test-governance.mjs",
        "test/acceptance-project/*.md"
      ],
      "checks": ["docs.index", "docs.tool"]
    },
    "development": {
      "sources": [
        "scripts/dev-checkpoint.mjs",
        "scripts/dev-lanes.mjs",
        "scripts/path-ownership.mjs",
        "scripts/test-dev-checkpoint.mjs",
        "scripts/test-dev-lanes.mjs",
        "scripts/test-worktree-integration.mjs"
      ],
      "checks": ["development.checkpoint", "development.integration", "development.lanes"]
    },
    "desktop": {
      "sources": [
        "desktop/package-lock.json",
        "desktop/package.json",
        "desktop/src-tauri/**",
        "desktop/ui/**",
        "crates/rho-ui-contract/**",
        "scripts/accept-rsr-exact-app.mjs",
        "scripts/generate-*-bindings.mjs",
        "scripts/generate-rsr-contract-fixtures.mjs",
        "scripts/rsr-*",
        "scripts/run-rsr-debug.mjs",
        "scripts/serve-desktop-preview.mjs",
        "scripts/test-*-bindings.mjs",
        "scripts/test-compat-*.mjs",
        "scripts/test-desktop-platform-config.mjs",
        "scripts/test-generated-transport-boundary.mjs",
        "scripts/test-rsr-*.mjs",
        "scripts/test-tauri-command-inventory.mjs",
        "scripts/test-visual-acceptance.mjs",
        "scripts/visual-acceptance.mjs",
        "scripts/visual-acceptance/**",
        "test/acceptance-project/**"
      ],
      "checks": ["frontend", "rust.workspace"]
    },
    "persistence-and-interfaces": {
      "sources": [
        "Cargo.lock",
        "Cargo.toml",
        "crates/rho-cli/**",
        "crates/rho-core/**",
        "crates/rho-mcp/**",
        "crates/rho-protocol/**",
        "crates/rho-server/**",
        "crates/rho-store/**",
        "rust-toolchain.toml"
      ],
      "checks": ["rust.store", "rust.workspace"]
    },
    "r-runtime": {
      "sources": [
        "crates/rho-agent-transport/**",
        "crates/rho-kernel/**",
        "r/rho.agent/**",
        "r/rho.bridge/**",
        "test/environment-demo/**"
      ],
      "checks": ["r.agent", "r.bridge", "rust.workspace"]
    },
    "extensions": {
      "sources": [
        "crates/rho-extension-runtime/**",
        "crates/rho-plugin-dev/**",
        "desktop/src-tauri/src/internal_extensions/**",
        "desktop/src-tauri/src/internal_extensions.rs",
        "desktop/src-tauri/src/plugin_surface_runtime.rs",
        "desktop/src-tauri/src/workspace_plugins/**",
        "examples/workspace-plugin-*/**",
        "scripts/test-extension-*.mjs"
      ],
      "checks": ["rust.extensions", "rust.workspace"]
    },
    "release": {
      "sources": [
        ".github/CODEOWNERS",
        ".github/release-notes/**",
        ".github/workflows/**",
        "CODE_SIGNING_POLICY.md",
        "LICENSE",
        "LICENSES.md",
        "PRIVACY.md",
        "SECURITY.md",
        "Cargo.lock",
        "Cargo.toml",
        "crates/rho-updater-verifier/**",
        "desktop/package-lock.json",
        "desktop/package.json",
        "desktop/src-tauri/tauri.conf.json",
        "runtime/**",
        "scripts/bootstrap-*",
        "scripts/build-*.sh",
        "scripts/build-*.ps1",
        "scripts/prepare-runtime-resources.*",
        "scripts/*apprun*",
        "scripts/*bundle*.mjs",
        "scripts/*entitlements*.mjs",
        "scripts/*notary*.mjs",
        "scripts/*release*.mjs",
        "scripts/*signpath*.mjs",
        "scripts/*updater*.mjs",
        "scripts/generate-update-site.mjs",
        "scripts/test-release-metadata.ps1",
        "scripts/test-desktop-platform-config.mjs",
        "scripts/test-license-contract.mjs"
      ],
      "checks": ["release.candidate", "release.signing", "release.site", "release.updater"]
    }
  }
}

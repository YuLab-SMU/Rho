{
  "schema_version": 1,
  "checks": {
    "next.architecture": { "command": ["node", "next/scripts/check-architecture.mjs"] },
    "next.rust": { "command": ["cargo", "test", "--workspace", "--locked", "--", "--test-threads=1"] },
    "next.client": { "command": ["node", "next/scripts/client.mjs", "check"] },
    "next.real-r": { "command": ["node", "next/scripts/test-real-r.mjs"] },
    "next.environment": { "command": ["node", "next/scripts/test-environment.mjs"] },
    "next.process-recovery": { "command": ["node", "next/scripts/test-process-recovery.mjs"] },
    "next.remote-protocol": { "command": ["node", "next/scripts/test-remote-protocol.mjs"] },
    "next.mcp": { "command": ["node", "next/scripts/test-mcp.mjs"] },
    "next.mcp-real-r": { "command": ["node", "next/scripts/test-mcp.mjs", "--real-r"] },
    "next.workbench": { "command": ["node", "next/scripts/test-workbench.mjs"] },
    "next.workbench-real-r": { "command": ["node", "next/scripts/test-workbench.mjs", "--real-r"] },
    "docs.index": { "command": ["node", "scripts/governance.mjs", "check"] },
    "docs.tool": { "command": ["node", "scripts/test-governance.mjs"] }
  },
  "areas": {
    "documentation": {
      "sources": ["AGENTS.md", "README.md", "CONTRIBUTING.md", "docs/**", "governance/**", "scripts/governance.mjs", "scripts/test-governance.mjs"],
      "checks": ["docs.index", "docs.tool"]
    },
    "next-system": {
      "sources": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "next/**", "vendor/jet/**", "docs/NEXT-SYSTEM.md"],
      "checks": ["docs.index", "docs.tool", "next.architecture", "next.rust", "next.client", "next.real-r", "next.environment", "next.process-recovery", "next.remote-protocol", "next.mcp", "next.mcp-real-r", "next.workbench", "next.workbench-real-r"]
    },
    "legacy-pending-retirement": {
      "sources": ["crates/**", "desktop/**", "r/**", "programs/**", "test/**", "fuzz/**", "scripts/**"],
      "checks": []
    },
    "delivery": {
      "sources": [".github/**", "runtime/**", "LICENSE", "LICENSES.md", "PRIVACY.md", "SECURITY.md", "CODE_SIGNING_POLICY.md", "scripts/bootstrap-ark-*.sh", "scripts/bootstrap-ark-*.ps1"],
      "checks": ["docs.index", "next.architecture"]
    }
  }
}

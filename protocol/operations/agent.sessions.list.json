{
  "method": "agent.sessions.list",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "omitted": {
        "minimum": 0,
        "type": "integer"
      },
      "sessions": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "continueWith": {
              "enum": [
                "claude-acp",
                "codex-acp",
                "acp",
                null
              ]
            },
            "conversationId": {
              "type": "string"
            },
            "id": {
              "pattern": "^x-[a-f0-9]{64}$",
              "type": "string"
            },
            "inputOwner": {
              "const": "external"
            },
            "lastAt": {
              "type": "string"
            },
            "observedAt": {
              "type": "string"
            },
            "omittedTurns": {
              "minimum": 0,
              "type": "integer"
            },
            "open": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "pid": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "since": {
                      "type": "string"
                    },
                    "where": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "where"
                  ],
                  "type": "object"
                }
              ]
            },
            "problem": {
              "type": "string"
            },
            "producer": {
              "type": "string"
            },
            "resume": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "sourceCursor": {
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "unknown"
              ]
            },
            "title": {
              "type": "string"
            },
            "turns": {
              "minimum": 0,
              "type": "integer"
            },
            "where": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "producer",
            "sessionId",
            "title",
            "lastAt",
            "observedAt",
            "state",
            "turns",
            "sourceCursor",
            "omittedTurns"
          ],
          "type": "object"
        },
        "maxItems": 128,
        "type": "array"
      }
    },
    "required": [
      "sessions",
      "omitted"
    ],
    "type": "object"
  },
  "description": null
}

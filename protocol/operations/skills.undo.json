{
  "method": "skills.undo",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "change": {
        "pattern": "^sc-[a-f0-9]{16}$",
        "type": "string"
      },
      "changeId": {
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
        "type": "string"
      },
      "name": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "name",
      "change",
      "changeId"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "change": {
        "additionalProperties": false,
        "properties": {
          "added": {
            "minimum": 0,
            "type": "integer"
          },
          "after": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "minLength": 1,
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "changeId": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "diff": {
            "additionalProperties": false,
            "properties": {
              "cut": {
                "type": "boolean"
              },
              "lines": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "enum": [
                        " ",
                        "+",
                        "-",
                        "…"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "text"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "lines",
              "cut"
            ],
            "type": "object"
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "cell",
                    "conversation",
                    "file",
                    "annotation",
                    "place",
                    "note"
                  ]
                },
                "label": {
                  "maxLength": 200,
                  "type": "string"
                },
                "ref": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^sc-[a-f0-9]{16}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "recorded",
              "removed",
              "undone",
              "outside"
            ]
          },
          "reason": {
            "type": "string"
          },
          "removed": {
            "minimum": 0,
            "type": "integer"
          },
          "skill": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "undoes": {
            "anyOf": [
              {
                "pattern": "^sc-[a-f0-9]{16}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "undoneBy": {
            "anyOf": [
              {
                "pattern": "^sc-[a-f0-9]{16}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "changeId",
          "skill",
          "kind",
          "by",
          "at",
          "reason",
          "evidence",
          "before",
          "after",
          "undoes",
          "undoneBy",
          "added",
          "removed",
          "diff"
        ],
        "type": "object"
      },
      "skill": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "body": {
                "type": "string"
              },
              "bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "description": {
                "type": "string"
              },
              "modifiedAt": {
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                "type": "string"
              },
              "version": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "description",
              "body",
              "version",
              "bytes",
              "modifiedAt"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "skill",
      "change"
    ],
    "type": "object"
  },
  "description": "Put a project skill back as it was before its newest change, while the file is still as that change left it. The undo is a change of its own."
}

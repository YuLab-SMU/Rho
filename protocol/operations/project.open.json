{
  "method": "project.open",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "path"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "openedAt": {
        "type": "string",
        "format": "date-time"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "workspace": {
        "type": "boolean"
      },
      "nativeSelected": {
        "type": "boolean"
      },
      "visibilityRoot": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "root": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "root",
            "name"
          ]
        }
      },
      "creation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "digest",
          "author"
        ]
      },
      "host": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "exitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "reply": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "exitCode",
          "reply"
        ]
      }
    },
    "required": [
      "id",
      "root",
      "openedAt",
      "host"
    ]
  },
  "description": null
}

          "updatedAt": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "idle",
              "running",
              "completed",
              "failed",
              "stopped",
              "unknown"
            ]
          },
          "lastAt": {
            "type": "string",
            "minLength": 1
          }
        },

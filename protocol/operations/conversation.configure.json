{
  "method": "conversation.configure",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "conversationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"

      "configId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "value": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "required": [
      "projectId",
      "conversationId",
      "configId",
      "value"
    ]
  },

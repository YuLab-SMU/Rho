{
  "method": "extension.list",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "plugins": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source": {
              "type": "string"
            },
            "sourceCommit": {
              "type": "string"
            },
            "market": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "keywords": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "required": [
                "id",
                "title",
                "url",
                "digest"
              ],
              "additionalProperties": false
            },
            "enabled": {
              "type": "boolean"
            },
            "installedAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "version",
            "title",
            "description",
            "digest",
            "source",
            "enabled",
            "installedAt"
          ],
          "additionalProperties": false
        }
      },
      "directory": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
            },
            "title": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "needs": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "version",
            "description",
            "source",
            "repository",
            "needs"
          ],
          "additionalProperties": false
        }
      },
      "markets": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fetchedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "checkedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "plugins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96,
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "needs": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 16,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "title",
                  "version",
                  "description",
                  "source",
                  "repository",
                  "needs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "url",
            "title",
            "revision",
            "digest",
            "fetchedAt",
            "checkedAt",
            "error",
            "plugins"
          ],
          "additionalProperties": false
        }
      },
      "limits": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "plugins",
      "directory",
      "markets",
      "limits"
    ],
    "additionalProperties": false
  },
  "description": "List installed third-party packages, the bundled directory and retained remote market indexes. Listing makes no network request and starts no plugin or runtime. Use extension.describe for installed operation schemas and Skills."
}

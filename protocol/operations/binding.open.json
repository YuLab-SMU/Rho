{
  "method": "binding.open",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "adapter": {
        "const": "claude-code-mcp"
      },
      "attachment": {
        "additionalProperties": false,
        "properties": {
          "adapterRegistrationId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "role": {
            "enum": [
              "business",
              "presentation"
            ]
          },
          "taskId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "transportCapabilities": {
            "additionalProperties": false,
            "properties": {
              "hookEmissionDeduplication": {
                "enum": [
                  "none",
                  "no-reemit-after-attempt"
                ]
              },
              "inboxDeduplication": {
                "enum": [
                  "none",
                  "retained-original-delivery"
                ]
              },
              "inboxLookup": {
                "type": "boolean"
              },
              "inputMode": {
                "enum": [
                  "pull-tool-result",
                  "post-tool-boundary",
                  "queued-turn",
                  "unsupported"
                ]
              },
              "modelConsumptionAck": {
                "const": false
              },
              "nativeExecutionDeduplication": {
                "const": false
              }
            },
            "required": [
              "inputMode",
              "inboxLookup",
              "inboxDeduplication",
              "hookEmissionDeduplication",
              "modelConsumptionAck",
              "nativeExecutionDeduplication"
            ],
            "type": "object"
          }
        },
        "required": [
          "taskId",
          "role",
          "adapterRegistrationId",
          "transportCapabilities"
        ],
        "type": "object"
      },
      "externalSessionId": {
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "externalSessionId",
      "adapter"
    ],
    "type": "object"
  },
  "outputSchema": {
    "anyOf": [
      {
        "additionalProperties": true,
        "properties": {
          "adapter": {
            "const": "claude-code-mcp"
          },
          "at": {
            "minLength": 1,
            "type": "string"
          },
          "externalSessionId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "principal": {
            "minLength": 1,
            "type": "string"
          },
          "projectId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "disconnected"
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "principal",
          "externalSessionId",
          "adapter",
          "status",
          "at"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "const": "claude-code-mcp"
          },
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "attachment": {
            "additionalProperties": false,
            "properties": {
              "adapterRegistrationId": {
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
                "type": "string"
              },
              "role": {
                "enum": [
                  "business",
                  "presentation"
                ]
              },
              "taskId": {
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
                "type": "string"
              },
              "transportCapabilities": {
                "additionalProperties": false,
                "properties": {
                  "hookEmissionDeduplication": {
                    "enum": [
                      "none",
                      "no-reemit-after-attempt"
                    ]
                  },
                  "inboxDeduplication": {
                    "enum": [
                      "none",
                      "retained-original-delivery"
                    ]
                  },
                  "inboxLookup": {
                    "type": "boolean"
                  },
                  "inputMode": {
                    "enum": [
                      "pull-tool-result",
                      "post-tool-boundary",
                      "queued-turn",
                      "unsupported"
                    ]
                  },
                  "modelConsumptionAck": {
                    "const": false
                  },
                  "nativeExecutionDeduplication": {
                    "const": false
                  }
                },
                "required": [
                  "inputMode",
                  "inboxLookup",
                  "inboxDeduplication",
                  "hookEmissionDeduplication",
                  "modelConsumptionAck",
                  "nativeExecutionDeduplication"
                ],
                "type": "object"
              }
            },
            "required": [
              "taskId",
              "role",
              "adapterRegistrationId",
              "transportCapabilities"
            ],
            "type": "object"
          },
          "externalSessionId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "principal": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "projectId": {
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "connected",
              "disconnected"
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "principal",
          "externalSessionId",
          "adapter",
          "status",
          "at",
          "attachment"
        ],
        "type": "object"
      }
    ]
  },
  "description": "Bind this external session to the authenticated project scope. Conversation stays in Claude Code."
}

{
  "method": "data.compare",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "left": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      },
      "options": {
        "additionalProperties": false,
        "properties": {
          "join": {
            "enum": [
              "left",
              "inner",
              "full"
            ]
          },
          "leftField": {
            "minLength": 1,
            "type": "string"
          },
          "leftKey": {
            "minLength": 1,
            "type": "string"
          },
          "leftNamespace": {
            "minLength": 1,
            "type": "string"
          },
          "mapping": {
            "const": "equal-string"
          },
          "rightField": {
            "minLength": 1,
            "type": "string"
          },
          "rightKey": {
            "minLength": 1,
            "type": "string"
          },
          "rightNamespace": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "leftKey",
          "rightKey",
          "leftNamespace",
          "rightNamespace",
          "mapping",
          "leftField",
          "rightField",
          "join"
        ],
        "type": "object"
      },
      "right": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      }
    },
    "required": [
      "projectId",
      "left",
      "right",
      "options"
    ],
    "type": "object"
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "file",
          "table",
          "media",
          "object",
          "plot",
          "model"
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      },
      "provenance": {
        "type": "object"
      },
      "coverage": {
        "type": "object"
      },
      "availability": {
        "enum": [
          "available",
          "partial",
          "missing",
          "unknown"
        ]
      },
      "format": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "mimeType": {
                "type": "string",
                "minLength": 1
              },
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "key": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pages": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "additionalProperties": true
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "required": [
      "id",
      "version",
      "projectId",
      "owner",
      "kind",
      "path",
      "bytes",
      "provenance",
      "coverage",
      "availability"
    ]
  },
  "description": "Join two explicit table versions using declared keys, namespaces, fields and join policy. Scientific comparability remains the project responsibility."
}

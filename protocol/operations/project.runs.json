{
  "method": "project.runs",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "execution": {
              "type": "string",
              "minLength": 1
            },
            "delivery": {
              "type": "string",
              "minLength": 1
            },
            "acceptedAt": {
              "type": "string",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "declared": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "present": {
                    "type": "boolean"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "path",
                  "present",
                  "bytes"
                ],
                "additionalProperties": true
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completion": {
              "enum": [
                "present",
                "absent"
              ]
            },
            "integrity": {
              "enum": [
                "unchecked",
                "declared",
                "incomplete",
                "verified",
                "not-applicable"
              ]
            },
            "domain": {
              "enum": [
                "unchecked",
                "checked"
              ]
            },
            "script": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceKey": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "hasStderr": {
              "type": "boolean"
            },
            "stop": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "requestedAt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "requested",
                        "signalled",
                        "stopped",
                        "finished-first",
                        "unconfirmed"
                      ]
                    },
                    "exit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "requestedAt",
                    "by",
                    "state",
                    "exit"
                  ],
                  "additionalProperties": true
                }
              ]
            },
            "repairOf": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "operationId",
            "action",
            "execution",
            "delivery",
            "acceptedAt",
            "author",
            "declared",
            "missing",
            "completion",
            "integrity",
            "domain",
            "script",
            "sourceKey",
            "hasStderr",
            "stop",
            "repairOf"
          ],
          "additionalProperties": true
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "runs",
      "total",
      "truncated"
    ],
    "additionalProperties": true
  },
  "description": "Report what this project has run and what it is running: one bounded summary per operation with its execution state, accepted time, author kind, the artifact paths its plan declared, whether each of those files is on disk now, whether the producer wrote a completion inventory, and the recorded integrity and domain states. A declaration, a file on disk and a verified artifact are separate facts. It carries no request body, no code and no output text, and starts nothing."
}

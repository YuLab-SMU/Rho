{
  "method": "document.history",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "documentId": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "documentId"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "currentRevision": {
        "minimum": 0,
        "type": "integer"
      },
      "currentVersion": {
        "minimum": 1,
        "type": "integer"
      },
      "documentId": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "entries": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "afterDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "at": {
              "minLength": 1,
              "type": "string"
            },
            "author": {
              "minLength": 1,
              "type": "string"
            },
            "beforeDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "changeId": {
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
              "type": "string"
            },
            "groupId": {
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "edit",
                "undo",
                "undo-own",
                "revert"
              ]
            },
            "requestDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "revertedBy": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reverts": {
              "items": {
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "undoGroup": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "changeId",
            "requestDigest",
            "author",
            "kind",
            "undoGroup",
            "groupId",
            "version",
            "revision",
            "at",
            "beforeDigest",
            "afterDigest",
            "reverts",
            "revertedBy"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "retainedFromVersion": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "documentId",
      "currentVersion",
      "currentRevision",
      "retainedFromVersion",
      "entries"
    ],
    "type": "object"
  },
  "description": null
}

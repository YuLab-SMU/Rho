{
  "method": "project.entries",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "file",
                "folder"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "hidden": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "name",
            "kind",
            "bytes",
            "hidden"
          ],
          "additionalProperties": true
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      },
      "roots": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "path": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "required": [
      "entries",
      "total",
      "truncated",
      "roots",
      "path"
    ],
    "additionalProperties": true
  },
  "description": "List one level of a folder in this project: ordinary files and folders, bounded and confined to that folder, excluding owner state. The project folder lists the source folders it works in as @<sourceId> entries, which descend like any other folder. Listing reads no file contents and starts no runtime."
}

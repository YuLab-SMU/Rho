{
  "method": "selection.set",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "resource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "entities": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "maxItems": 1000
      }
    },
    "required": [
      "projectId",
      "resource",
      "entities"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "resource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "entities": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "at": {
        "type": "string",
        "minLength": 1
      },
      "namespace": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "resource",
      "entities",
      "at"
    ]
  },
  "description": null
}

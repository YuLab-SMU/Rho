{
  "method": "workspace.save",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "format": {
        "enum": [
          1,
          2,
          3
        ]
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "schemaVersion": {
        "enum": [
          1,
          2,
          3
        ]
      },
      "sourceProjectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "acknowledgedAt": {
        "type": "string",
        "format": "date-time"
      },
      "documents": {
        "type": "array",
        "maxItems": 64
      },
      "resources": {
        "type": "array",
        "maxItems": 1024
      },
      "compositions": {
        "type": "array",
        "maxItems": 64
      },
      "selection": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "capabilities": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "receipts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "schemaVersion",
          "version",
          "enabled",
          "receipts"
        ]
      },
      "interactions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scope": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "caller"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "view",
                        "shared"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ]
                }
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "selection": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "document": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "documentId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "from": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "to": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "documentId",
                        "version",
                        "from",
                        "to"
                      ]
                    }
                  },
                  "required": [
                    "document"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "resource": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "id",
                        "version"
                      ]
                    },
                    "entities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "maxItems": 1024
                    }
                  },
                  "required": [
                    "resource",
                    "entities"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "receipts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "changeId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
                  },
                  "requestDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "changeId",
                  "requestDigest",
                  "version",
                  "author",
                  "at"
                ]
              },
              "maxItems": 256
            },
            "retainedFromVersion": {
              "type": "integer",
              "minimum": 1
            },
            "receipt": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "changeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
                },
                "requestDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "author": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "changeId",
                "requestDigest",
                "version",
                "author",
                "at"
              ]
            }
          },
          "required": [
            "key",
            "scope",
            "version",
            "selection"
          ]
        },
        "maxItems": 128
      },
      "annotations": {
        "type": "array",
        "maxItems": 128
      },
      "contexts": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contextId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "context": {
              "type": "object"
            }
          },
          "required": [
            "contextId",
            "context"
          ]
        }
      }
    },
    "required": [
      "schemaVersion",
      "sourceProjectId",
      "acknowledgedAt",
      "documents",
      "resources",
      "compositions",
      "selection"
    ]
  },
  "description": null
}

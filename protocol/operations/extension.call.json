{
  "method": "extension.call",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "pluginId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
      },
      "expectedDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "operation": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
      },
      "input": {
        "type": "object",
        "additionalProperties": true
      },
      "changeId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId",
      "pluginId",
      "expectedDigest",
      "operation",
      "input",
      "changeId"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "invocationId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "caller": {
        "type": "string"
      },
      "projectId": {
        "type": "string"
      },
      "pluginId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
      },
      "packageDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "operation": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
      },
      "requestDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "state": {
        "enum": [
          "pending",
          "completed",
          "unknown"
        ]
      },
      "startedAt": {
        "type": "string"
      },
      "endedAt": {
        "type": "string"
      },
      "value": {},
      "error": {
        "type": "string"
      },
      "delegations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "request": {},
            "state": {
              "enum": [
                "pending",
                "completed",
                "unknown"
              ]
            },
            "value": {},
            "error": {
              "type": "string"
            }
          },
          "required": [
            "method",
            "request",
            "state"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "invocationId",
      "caller",
      "projectId",
      "pluginId",
      "packageDigest",
      "operation",
      "requestDigest",
      "state",
      "startedAt"
    ],
    "additionalProperties": false
  },
  "description": "Call an enabled third-party operation at the described package digest, under the caller and project. The package runs trusted native code. Non-read calls retain the original changeId: repeat observes that invocation, including unknown outcomes, without re-execution. Completion is not scientific validity."
}

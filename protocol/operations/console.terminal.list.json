{
  "method": "console.terminal.list",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "terminals": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "by": {
              "minLength": 1,
              "type": "string"
            },
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "cols": {
              "maximum": 500,
              "minimum": 2,
              "type": "integer"
            },
            "cwd": {
              "type": "string"
            },
            "endedAt": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "exit": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "signal": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "signal"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kept": {
              "minimum": 0,
              "type": "integer"
            },
            "problem": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rows": {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            "shell": {
              "minLength": 1,
              "type": "string"
            },
            "startedAt": {
              "minLength": 1,
              "type": "string"
            },
            "terminalId": {
              "pattern": "^t-[a-f0-9]{16}$",
              "type": "string"
            },
            "typedBy": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "by": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "by",
                    "at"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "terminalId",
            "by",
            "shell",
            "cwd",
            "cols",
            "rows",
            "startedAt",
            "endedAt",
            "exit",
            "bytes",
            "kept",
            "problem",
            "typedBy"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "terminals"
    ],
    "type": "object"
  },
  "description": "The open terminals in this project, with who opened each, who else last typed there, each one's size, how much it has printed and whether its shell has ended."
}

{
  "method": "conversation.list",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "trashed": {
        "type": "boolean"
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "conversations": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "client": {
              "type": "string",
              "minLength": 1
            },
            "principal": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            },
            "updatedAt": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "turns": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "enum": [
                "idle",
                "running",
                "completed",
                "failed",
                "stopped",
                "unknown"
              ]
            },
            "lastAt": {
              "type": "string",
              "minLength": 1
            },
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "agentTitle": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "adapter": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "config": {
              "type": "object",
              "maxProperties": 12,
              "propertyNames": {
                "maxLength": 512
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "used": {
                      "type": "number",
                      "minimum": 0
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cost": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "amount": {
                              "type": "number"
                            },
                            "currency": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "amount",
                            "currency"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "used",
                    "size",
                    "cost"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "costUsd": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sessionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "trashedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "conversationId",
            "title",
            "client",
            "principal",
            "createdAt",
            "updatedAt",
            "version",
            "turns",
            "state",
            "lastAt"
          ],
          "additionalProperties": true
        }
      }
    },
    "required": [
      "conversations"
    ],
    "additionalProperties": true
  },
  "description": "Person at this machine only: list the conversations started in Rho in this project, or those in its trash, with each one's Agent, last model, choices and reported usage. Reading starts nothing."
}

{
  "method": "kernel.complete",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "language": {
        "enum": [
          "r",
          "python"
        ]
      },
      "line": {
        "maxLength": 4096,
        "type": "string"
      },
      "notebook": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "language",
      "line"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "from": {
        "minimum": 0,
        "type": "integer"
      },
      "items": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "enum": [
                "variable",
                "function",
                "property",
                "argument",
                "keyword",
                "file",
                "name"
              ]
            }
          },
          "required": [
            "label",
            "type"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "omitted": {
        "minimum": 0,
        "type": "integer"
      },
      "problem": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "sessionId": {
        "anyOf": [
          {
            "pattern": "^s-[a-f0-9]{16}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "state": {
        "enum": [
          "shown",
          "busy",
          "none",
          "timeout",
          "failed",
          "ended"
        ]
      }
    },
    "required": [
      "state",
      "sessionId",
      "from",
      "items",
      "omitted",
      "problem"
    ],
    "type": "object"
  },
  "description": "The names a live session offers after a line being typed (the project's own session unless notebook names a notebook): its values and the names of its packages, the parts of a value after $ or a dot, a table's columns in quotes, a call's arguments, files. line is the line up to the cursor; from is where the name being completed starts in it. A value named before $ or a dot is read; a call is never run. Never starts a session or waits for a cell: while a cell runs or waits the answer is busy. One that takes too long is interrupted."
}

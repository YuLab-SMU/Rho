{
  "method": "project.openFile",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "compositionId": {
        "type": "string",
        "minLength": 1
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 0
      },
      "changeId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "projectId",
      "path",
      "compositionId",
      "expectedVersion",
      "changeId"
    ]
  },
  "outputSchema": {

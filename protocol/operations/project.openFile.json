                                "minLength": 1
                              },
                              "version": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            },
                            "required": [
                              "id",
                              "version"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "documentId": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              "version": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "required": [
                              "documentId",
                              "version"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "const": "live-document"
                              },
                              "documentId": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            },
                            "required": [
                              "kind",
                              "documentId"
                            ]
                          }
                        ]
                      }
                    },
                    "selection": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "maxItems": 1000
                    },
                    "presentation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "emphasis": {

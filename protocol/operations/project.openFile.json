              "type": "object",
              "additionalProperties": false,
              "properties": {
                "content": {
                  "type": "string"
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "author": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "content",
                "group",
                "author"
              ]
            }
          }
        },
        "required": [
          "id",
          "path",
          "version",
          "content",
          "diskDigest",
          "dirty",
          "author",
          "acknowledgedAt",
          "undo"

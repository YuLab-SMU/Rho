          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string"
          },
          "diskDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dirty": {
            "type": "boolean"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "acknowledgedAt": {
            "type": "string",
            "minLength": 1
          },
          "undo": {
            "type": "array",

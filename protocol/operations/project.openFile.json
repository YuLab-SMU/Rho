                            "axis": {
                              "enum": [
                                "horizontal",
                                "vertical"
                              ]
                            },
                            "weights": {
                              "type": "array",
                              "items": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 100
                              },
                              "minItems": 2,
                              "maxItems": 256
                            }
                          },
                          "required": [
                            "mode",
                            "axis",
                            "weights"
                          ]

                      }
                    ]
                  }
                },
                "selection": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1000
                },
                "presentation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "emphasis": {

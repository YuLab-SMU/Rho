                        "type": "string",
                        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
                      },
                      "maxItems": 256,
                      "uniqueItems": true
                    },
                    "presentation": {
                      "oneOf": [
                        {
                          "type": "object",

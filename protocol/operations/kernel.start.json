{
  "method": "kernel.start",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "language": {
        "enum": [
          "r",
          "python"
        ]
      },
      "notebook": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
        "type": "string"
      },
      "place": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "language"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "session": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "minimum": 0,
            "type": "integer"
          },
          "endedAt": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ending": {
            "anyOf": [
              {
                "enum": [
                  "stopped",
                  "exited",
                  "disconnected",
                  "rho-closed",
                  "not-started"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "language": {
            "enum": [
              "r",
              "python"
            ]
          },
          "notebook": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
            "type": "string"
          },
          "pid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "place": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "destination": {
                    "pattern": "^[A-Za-z0-9_.%+@:\\[\\]/][A-Za-z0-9_.%+@:\\[\\]/-]{0,254}$",
                    "type": "string"
                  },
                  "folder": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "label": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "placeId": {
                    "pattern": "^(?!local$)[a-z][a-z0-9-]{0,31}$",
                    "type": "string"
                  }
                },
                "required": [
                  "placeId",
                  "label",
                  "destination",
                  "folder"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "program": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sessionId": {
            "pattern": "^s-[a-f0-9]{16}$",
            "type": "string"
          },
          "startedAt": {
            "minLength": 1,
            "type": "string"
          },
          "startedBy": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "starting",
              "idle",
              "busy",
              "ended"
            ]
          },
          "stop": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "by": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "by",
                  "at"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "variables": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "minimum": 0,
                  "type": "number"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "size",
                "bytes",
                "summary"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "variablesAt": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "variablesOmitted": {
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sessionId",
          "language",
          "state",
          "version",
          "pid",
          "startedAt",
          "startedBy",
          "endedAt",
          "ending",
          "stop",
          "problem",
          "variables",
          "variablesOmitted",
          "variablesAt",
          "cells"
        ],
        "type": "object"
      }
    },
    "required": [
      "session"
    ],
    "type": "object"
  },
  "description": "Person at this machine only: start an R or Python session without a cell (the project's own unless notebook names a notebook), where the place names, else where the project runs that language. A live session is returned as it is; one that is stopping is waited for first. An Agent's first cell starts its session."
}

{
  "method": "skill.list",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "operation-guide"
        },
        "scope": {
          "enum": [
            "application",
            "plugin"
          ]
        },
        "mutable": {
          "const": false
        },
        "delivery": {
          "const": "rho"
        },
        "presentation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "type": "number"
            },
            "readOnly": {
              "type": "boolean"
            },
            "runsCode": {
              "type": "boolean"
            }
          },
          "required": []
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "object"
            }
          },
          "required": [
            "method",
            "input"
          ]
        },
        "failureRecipes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "next": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "message",
              "next"
            ]
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "command",
            "description"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "owner",
        "kind",
        "scope",
        "mutable",
        "delivery"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "content"
        ]
      }
    }
  },
  "description": "List immutable application and enabled provider operation-guide manifests shipped in the selected package. The list has no Skill bodies; use skill.read for one after choosing its digest. Skills guide discovery but do not grant authorization."
}

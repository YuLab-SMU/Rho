{
  "method": "skill.read",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "skillId": {
        "type": "string",
        "minLength": 1
      },
      "expectedDigest": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "projectId",
      "skillId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "const": "operation-guide"
      },
      "scope": {
        "enum": [
          "application",
          "plugin"
        ]
      },
      "mutable": {
        "const": false
      },
      "delivery": {
        "const": "rho"
      },
      "content": {
        "type": "string",
        "minLength": 1
      },
      "presentation": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "number"
          },
          "readOnly": {
            "type": "boolean"
          },
          "runsCode": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "intent": {
        "type": "string",
        "minLength": 1
      },
      "requires": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "example": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          }
        },
        "required": [
          "method",
          "input"
        ]
      },
      "failureRecipes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "next": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "message",
            "next"
          ]
        }
      },
      "verify": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "description"
        ]
      }
    },
    "required": [
      "id",
      "version",
      "digest",
      "owner",
      "kind",
      "scope",
      "mutable",
      "delivery",
      "content"
    ],
    "additionalProperties": true
  },
  "description": "Read the body of one immutable shipped operation guide after checking its digest. A stale digest requires rereading instead of applying cached instructions."
}

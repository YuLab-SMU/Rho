{
  "method": "artifact.check",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "operationId": {
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
        "type": "string"
      }
    },
    "required": [
      "projectId",
      "operationId"
    ],
    "type": "object"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "integrity": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "state": {
            "enum": [
              "unchecked",
              "declared",
              "incomplete",
              "verified",
              "not-applicable"
            ]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "kind",
                "reason"
              ]
            },
            "maxItems": 512
          },
          "completionDeclaration": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "manifestDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "state"
        ]
      },
      "domain": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "state": {
            "enum": [
              "unchecked",
              "checked"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "object"
          }
        },
        "required": [
          "state"
        ]
      },
      "resources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "file",
                "table",
                "media",
                "object",
                "plot",
                "model"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "provenance": {
              "type": "object"
            },
            "coverage": {
              "type": "object"
            },
            "availability": {
              "enum": [
                "available",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "format": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "encoding": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "key": {
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "classes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "pages": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "projectId",
            "owner",
            "kind",
            "path",
            "bytes",
            "provenance",
            "coverage",
            "availability"
          ]
        }
      }
    },
    "required": [
      "integrity",
      "domain"
    ],
    "additionalProperties": true
  },
  "description": "Verify the selected completion inventory and file bytes only; domain check reports remain project resources."
}

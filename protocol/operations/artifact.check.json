{
  "method": "artifact.check",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId",
      "operationId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "integrity": {
        "type": "object"
      },
      "domain": {
        "type": "object"
      },
      "resources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "file",
                "table",
                "media",
                "object",
                "plot",
                "model"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "provenance": {
              "type": "object"
            },
            "coverage": {
              "type": "object"
            },
            "availability": {
              "enum": [
                "available",
                "partial",
                "missing",
                "unknown"
              ]
            },
            "format": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "id",
            "version",
            "projectId",
            "owner",
            "kind",
            "path",
            "bytes",
            "provenance",
            "coverage",
            "availability"
          ]
        }
      }
    },
    "required": [
      "integrity",
      "domain"
    ],
    "additionalProperties": true
  },
  "description": "Verify the selected completion inventory and file bytes only; domain check reports remain project resources."
}

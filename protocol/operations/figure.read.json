{
  "method": "figure.read",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "cellId": {
        "pattern": "^k-[a-f0-9]{16}$",
        "type": "string"
      },
      "form": {
        "enum": [
          "summary",
          "view",
          "selections"
        ]
      },
      "limit": {
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "marks": {
        "items": {
          "pattern": "^\\d{1,4}\\.\\d{1,7}$",
          "type": "string"
        },
        "maxItems": 5000,
        "type": "array"
      },
      "plot": {
        "maximum": 64,
        "minimum": 1,
        "type": "integer"
      },
      "selection": {
        "pattern": "^f-[a-f0-9]{16}$",
        "type": "string"
      },
      "where": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "column": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "layer": {
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge",
                "in",
                "contains"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maxItems": 500,
                  "type": "array"
                }
              ]
            }
          },
          "required": [
            "column",
            "op",
            "value"
          ],
          "type": "object"
        },
        "maxItems": 8,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "projectId",
      "cellId",
      "plot"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "figure": {
        "type": "object"
      },
      "matched": {
        "type": "object"
      },
      "record": {
        "type": "object"
      },
      "rows": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "rowsTotal": {
        "minimum": 0,
        "type": "integer"
      },
      "selections": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "at": {
              "minLength": 1,
              "type": "string"
            },
            "by": {
              "minLength": 1,
              "type": "string"
            },
            "cellId": {
              "pattern": "^k-[a-f0-9]{16}$",
              "type": "string"
            },
            "changeId": {
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
              "type": "string"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "layers": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "geom": {
                    "type": "string"
                  },
                  "layer": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "marks": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "layer",
                  "geom",
                  "marks"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "marks": {
              "items": {
                "pattern": "^\\d{1,4}\\.\\d{1,7}$",
                "type": "string"
              },
              "type": "array"
            },
            "note": {
              "type": "string"
            },
            "plot": {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            "selectionId": {
              "pattern": "^f-[a-f0-9]{16}$",
              "type": "string"
            }
          },
          "required": [
            "selectionId",
            "cellId",
            "plot",
            "digest",
            "by",
            "at",
            "changeId",
            "note",
            "count",
            "layers"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    },
    "required": [
      "figure",
      "selections"
    ],
    "type": "object"
  },
  "description": "What a plot a cell drew shows: its layers, mappings, panels and data, the rows behind marks, and the marks people and Agents selected."
}

            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "sentAt": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "running",
              "completed",
              "failed",
              "stopped",
              "unknown"
            ]
          },
          "startedAt": {

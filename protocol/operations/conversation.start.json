{
  "method": "conversation.start",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "changeId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "backend": {
        "enum": [
          "claude-acp",
          "codex-acp"
        ]
      },
      "config": {
        "type": "object",
        "maxProperties": 12,
        "propertyNames": {
          "maxLength": 512
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "required": [
      "projectId",
      "changeId",
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "conversation": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "client": {
            "type": "string",
            "minLength": 1
          },
          "principal": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "minLength": 1
          },
          "updatedAt": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "idle",
              "running",
              "completed",
              "failed",
              "stopped",
              "unknown"
            ]
          },
          "lastAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "conversationId",
          "title",
          "client",
          "principal",
          "createdAt",
          "updatedAt",
          "version",
          "turns",
          "state",
          "lastAt"
        ],
        "additionalProperties": true
      },
      "turn": {

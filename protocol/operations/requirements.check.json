{
  "method": "requirements.check",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "requirements": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "minimumVersion": {
              "pattern": "^[0-9]+([.-][0-9]+)*$",
              "type": "string"
            },
            "package": {
              "pattern": "^[A-Za-z][A-Za-z0-9.]*$",
              "type": "string"
            },
            "source": {
              "enum": [
                "cran",
                "bioconductor"
              ]
            }
          },
          "required": [
            "package",
            "source"
          ],
          "type": "object"
        },
        "maxItems": 64,
        "type": "array",
        "uniqueItems": true
      }
    },
    "required": [
      "projectId",
      "requirements"
    ],
    "type": "object"
  },
  "outputSchema": {
    "additionalProperties": true,
    "properties": {
      "checkId": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "checkedAt": {
        "minLength": 1,
        "type": "string"
      },
      "environment": {
        "type": "object"
      },
      "native": {
        "type": "object"
      },
      "requirements": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "minimumVersion": {
              "pattern": "^[0-9]+([.-][0-9]+)*$",
              "type": "string"
            },
            "package": {
              "pattern": "^[A-Za-z][A-Za-z0-9.]*$",
              "type": "string"
            },
            "source": {
              "enum": [
                "cran",
                "bioconductor"
              ]
            }
          },
          "required": [
            "package",
            "source"
          ],
          "type": "object"
        },
        "maxItems": 64,
        "type": "array",
        "uniqueItems": true
      },
      "status": {
        "enum": [
          "present",
          "missing",
          "unknown"
        ]
      }
    },
    "required": [
      "requirements",
      "checkedAt",
      "environment",
      "native",
      "status",
      "checkId"
    ],
    "type": "object"
  },
  "description": "Probe only the explicitly declared R packages with bounded base R; no Core Host or project script starts."
}

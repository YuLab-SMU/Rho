{
  "method": "action.lookup",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId",
      "operationId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "principal": {
        "type": "string",
        "minLength": 1
      },
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "requestDigest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "request": {
        "type": "object"
      },
      "action": {
        "type": "string",
        "minLength": 1
      },
      "actionVersion": {
        "type": "string",
        "minLength": 1
      },
      "acceptedAt": {
        "type": "string",
        "minLength": 1
      },
      "core": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caller": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          }
        },
        "required": [
          "caller",
          "requestId"
        ]
      },
      "delivery": {
        "enum": [
          "not-sent",
          "sending",
          "answered",
          "not-delivered",
          "unknown"
        ]
      },
      "execution": {
        "enum": [
          "unobserved",
          "active",
          "completed",
          "failed",
          "unknown"
        ]
      },
      "native": {},
      "integrity": {
        "type": "object"
      },
      "domain": {
        "type": "object"
      },
      "interpretation": {
        "type": "object"
      },
      "plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object"
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "codeDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "completion": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "args",
          "source",
          "output",
          "codeDigest"
        ]
      },
      "lastCli": {
        "type": "object"
      },
      "checks": {
        "type": "object"
      },
      "cancellation": {
        "type": "object"
      }
    },
    "required": [
      "operationId",
      "principal",
      "projectId",
      "requestDigest",
      "action",
      "actionVersion",
      "acceptedAt",
      "core",
      "delivery",
      "execution",
      "native",
      "integrity",
      "domain",
      "interpretation",
      "request",
      "plan"
    ]
  },
  "description": "Read the original accepted operation. Missing acknowledgement is not permission for a new identity."
}

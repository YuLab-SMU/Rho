{
  "method": "task.map.declare",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 0
      },
      "changeId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "question": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          {
            "type": "null"
          }
        ]
      },
      "compositionId": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "vocabulary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kinds": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "tone": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "role": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "icon": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "states": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "tone": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "role": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "icon": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    }
                  },
                  "required": [
                    "label"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": []
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 280
                  },
                  "tone": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "judgment": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "text"
                ]
              },
              "maxItems": 12
            },
            "progress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "done": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              },
              "required": [
                "done"
              ]
            },
            "view": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
              },
              "maxItems": 16,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "state",
            "title"
          ]
        },
        "maxItems": 256
      },
      "remove": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "maxItems": 256,
        "uniqueItems": true
      },
      "next": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "maxItems": 16,
        "uniqueItems": true
      }
    },
    "required": [
      "projectId",
      "expectedVersion",
      "changeId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "format": {
        "const": "rho.task-map/1"
      },
      "version": {
        "type": "integer",
        "minimum": 0
      },
      "vocabulary": {
        "type": "object"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "next": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "presentation": {
        "type": "object"
      },
      "suggestions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "receipts": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "format",
      "version",
      "vocabulary",
      "items",
      "next",
      "presentation",
      "suggestions"
    ],
    "additionalProperties": true
  },
  "description": "Agent only: conditionally declare task items, your own kind/state vocabulary (label, tone, optional role) and the next steps you will take. Rho shows next only from this declaration and never infers it."
}

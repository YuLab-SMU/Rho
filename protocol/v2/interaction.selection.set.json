{
  "method": "interaction.selection.set",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "scope": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "caller"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "view",
                  "shared"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          }
        ]
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 0
      },
      "changeId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "selection": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "document": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "documentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "from": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "documentId",
                  "version",
                  "from",
                  "to"
                ]
              }
            },
            "required": [
              "document"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 1024,
                "uniqueItems": true
              }
            },
            "required": [
              "resource",
              "entities"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "projectId",
      "scope",
      "expectedVersion",
      "changeId",
      "selection"
    ]
  },
  "outputSchema": {
    "type": "object"
  },
  "description": null
}

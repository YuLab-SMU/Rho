{
  "method": "skill.list",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "content"
      ],
      "additionalProperties": true
    }
  },
  "description": "List the application and enabled provider Skills shipped in the selected package. Skills guide discovery but do not grant authorization."
}

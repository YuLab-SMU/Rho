{
  "method": "project.create",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[^/\\\\]+$",
        "not": {
          "enum": [
            ".",
            "..",
            ".rho",
            ".git"
          ]
        }
      }
    },
    "required": [
      "name"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "openedAt": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "root",
      "openedAt"
    ],
    "additionalProperties": true
  },
  "description": null
}

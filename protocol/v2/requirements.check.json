{
  "method": "requirements.check",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9.]*$"
            },
            "source": {
              "enum": [
                "cran",
                "bioconductor"
              ]
            },
            "minimumVersion": {
              "type": "string",
              "pattern": "^[0-9]+([.-][0-9]+)*$"
            }
          },
          "required": [
            "package",
            "source"
          ]
        },
        "maxItems": 64,
        "uniqueItems": true
      }
    },
    "required": [
      "projectId",
      "requirements"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9.]*$"
            },
            "source": {
              "enum": [
                "cran",
                "bioconductor"
              ]
            },
            "minimumVersion": {
              "type": "string",
              "pattern": "^[0-9]+([.-][0-9]+)*$"
            }
          },
          "required": [
            "package",
            "source"
          ]
        },
        "maxItems": 64,
        "uniqueItems": true
      },
      "checkedAt": {
        "type": "string",
        "minLength": 1
      },
      "environment": {
        "type": "object"
      },
      "native": {
        "type": "object"
      },
      "status": {
        "enum": [
          "present",
          "missing",
          "unknown"
        ]
      },
      "checkId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "requirements",
      "checkedAt",
      "environment",
      "native",
      "status",
      "checkId"
    ],
    "additionalProperties": true
  },
  "description": "Probe only the explicitly declared R packages with bounded base R; no Core Host or project script starts."
}

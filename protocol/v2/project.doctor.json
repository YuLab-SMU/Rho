{
  "method": "project.doctor",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
      },
      "intent": {
        "enum": [
          "run-r",
          "edit-documents",
          "inspect-tables",
          "present"
        ]
      }
    },
    "required": [
      "projectId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "ok",
                "warn",
                "fail"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "remedy": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "state",
            "detail",
            "remedy"
          ],
          "additionalProperties": true
        }
      },
      "intent": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ready": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "methods",
              "missing",
              "ready"
            ],
            "additionalProperties": true
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "ok",
      "checks",
      "intent"
    ],
    "additionalProperties": true
  },
  "description": "Report whether this project can actually do work right now: Core binary, Rscript, write access to the project and state folders, plugin selection, Host socket and unfinished runs. Each check carries the next action when it does not pass. It starts no Host and changes nothing."
}

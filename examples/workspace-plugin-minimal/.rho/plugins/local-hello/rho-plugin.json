{
  "schemaVersion": 2,
  "id": "org.yulab.rho.local-hello",
  "name": "Local Hello",
  "version": "0.1.0",
  "apiVersion": "^1.0",
  "runtime": {
    "kind": "wasm",
    "entry": "dist/plugin.wasm",
    "scope": "project"
  },
  "provides": [
    {
      "capability": "ui.command.local_hello",
      "contract_major": 1
    },
    {
      "capability": "tool.local_status",
      "contract_major": 1
    },
    {
      "capability": "ui.viewer.local_status",
      "contract_major": 1
    }
  ],
  "permissions": [],
  "contributions": [
    {
      "id": "ui.command.local_hello",
      "kind": "command",
      "contractMajor": 1,
      "label": "Run local hello",
      "purpose": "Verify the local plugin author loop",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "notification"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "kind",
          "message"
        ]
      }
    },
    {
      "id": "tool.local_status",
      "kind": "tool",
      "contractMajor": 1,
      "label": "Local component status",
      "purpose": "Return the local component status to the Agent",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "local-hello"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "component",
          "status"
        ]
      }
    },
    {
      "id": "ui.viewer.local_status",
      "kind": "viewer",
      "contractMajor": 1,
      "label": "Open local component status",
      "purpose": "Render the local component status in a trusted Viewer",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "enum": [
              "rho.plugin_viewer_document.v1"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 128
          },
          "blocks": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "text"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "kind",
                "text"
              ]
            }
          }
        },
        "required": [
          "contract",
          "title",
          "blocks"
        ]
      }
    }
  ]
}

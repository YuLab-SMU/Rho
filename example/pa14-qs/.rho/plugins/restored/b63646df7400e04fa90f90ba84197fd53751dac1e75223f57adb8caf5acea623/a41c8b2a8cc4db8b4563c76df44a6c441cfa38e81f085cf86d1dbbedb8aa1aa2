series_levels <- c("ΔrhlI:ΔlasI mix", "Wild type", "ΔlasI alone", "ΔrhlI alone")
series_cols <- c("ΔrhlI:ΔlasI mix" = "#6250d6", "Wild type" = "#52514e",
                 "ΔlasI alone" = "#2a78d6", "ΔrhlI alone" = "#eb6834")

ref <- data.frame(
  series = factor(c("Wild type", "ΔlasI alone", "ΔrhlI alone"),
                  levels = series_levels),
  area = c(wt_area_gm,
           exp(mean(log(coc$area[coc$culture == "ΔlasI"]))),
           exp(mean(log(coc$area[coc$culture == "ΔrhlI"])))),
  circularity = c(mean(wt_circ),
                  mean(coc$circularity[coc$culture == "ΔlasI"]),
                  mean(coc$circularity[coc$culture == "ΔrhlI"])),
  roundness = c(mean(wt_round),
                mean(coc$roundness[coc$culture == "ΔlasI"]),
                mean(coc$roundness[coc$culture == "ΔrhlI"]))
)

mix$series <- factor("ΔrhlI:ΔlasI mix", levels = series_levels)

pred_grid <- data.frame(x = seq(log2(1/3), log2(100), length.out = 200))
pa <- predict(m_quad, newdata = pred_grid, interval = "confidence")
pred_area <- data.frame(
  ratio = 2^pred_grid$x,
  fit = exp(pa[, "fit"]),
  lwr = exp(pa[, "lwr"]),
  upr = exp(pa[, "upr"]),
  series = factor("ΔrhlI:ΔlasI mix", levels = series_levels)
)
pc <- predict(m_circ, newdata = pred_grid, interval = "confidence")
pred_circ <- data.frame(
  ratio = 2^pred_grid$x,
  fit = exp(pc[, "fit"]),
  lwr = exp(pc[, "lwr"]),
  upr = exp(pc[, "upr"]),
  series = factor("ΔrhlI:ΔlasI mix", levels = series_levels)
)

theme_swarm <- theme_minimal(base_size = 9) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    panel.grid.major.y = element_line(colour = "#e1e0d9", linewidth = 0.3),
    panel.background = element_rect(fill = "#fcfcfb", colour = NA),
    plot.background = element_rect(fill = "#fcfcfb", colour = NA),
    axis.line = element_line(colour = "#c3c2b7", linewidth = 0.4),
    axis.ticks = element_line(colour = "#c3c2b7", linewidth = 0.4),
    axis.text = element_text(colour = "#52514e", size = 8),
    axis.text.x = element_text(angle = 0, hjust = 0.5, vjust = 1),
    axis.title.y = element_text(colour = "#0b0b0b", size = 9.5),
    axis.title.x = element_blank(),
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.box = "horizontal",
    legend.title = element_text(size = 8.5, colour = "#52514e"),
    legend.text = element_text(size = 8.5, colour = "#52514e"),
    legend.key.size = unit(10, "pt"),
    legend.margin = margin(0, 0, 0, 0)
  )

x_scale <- scale_x_log10(
  breaks = c(1/3, 1, 3, 10, 100, 1000),
  labels = c("1:3", "1:1", "3:1", "10:1", "100:1", "1000:1"),
  limits = c(0.2, 3000),
  expand = c(0, 0)
)

p_area <- ggplot() +
  geom_ribbon(data = pred_area, aes(x = ratio, ymin = lwr, ymax = upr),
              fill = "#6250d6", alpha = 0.14, show.legend = FALSE) +
  geom_line(data = pred_area, aes(x = ratio, y = fit, colour = series),
            linewidth = 0.7) +
  geom_hline(data = ref[ref$series == "Wild type", ],
             aes(yintercept = area, colour = series),
             linetype = "solid", linewidth = 0.5) +
  geom_hline(data = ref[ref$series == "ΔlasI alone", ],
             aes(yintercept = area, colour = series),
             linetype = "dashed", linewidth = 0.5) +
  geom_hline(data = ref[ref$series == "ΔrhlI alone", ],
             aes(yintercept = area, colour = series),
             linetype = "dotted", linewidth = 0.5) +
  geom_point(data = mix, aes(x = ratio, y = area, colour = series),
             position = position_jitter(width = 0.012, height = 0, seed = 1),
             size = 1.7, alpha = 0.85) +
  geom_vline(xintercept = peak_ratio, linetype = "dotted",
             colour = "#898781", linewidth = 0.35) +
  annotate("text", x = peak_ratio * 1.12, y = 232000,
           label = "peak 12:1 (95% CI 10–15:1)", hjust = 0,
           size = 2.8, colour = "#52514e") +
  scale_colour_manual(values = series_cols, name = "Culture") +
  scale_y_log10(
    breaks = c(1e4, 2e4, 5e4, 1e5, 2e5),
    labels = c("10k", "20k", "50k", "100k", "200k"),
    limits = c(6500, 270000),
    expand = c(0, 0)
  ) +
  x_scale +
  labs(y = "Colony area (imaging units, log scale)") +
  theme_swarm

p_circ <- ggplot() +
  geom_ribbon(data = pred_circ, aes(x = ratio, ymin = lwr, ymax = upr),
              fill = "#6250d6", alpha = 0.14, show.legend = FALSE) +
  geom_line(data = pred_circ, aes(x = ratio, y = fit, colour = series),
            linewidth = 0.7) +
  geom_hline(data = ref[ref$series == "Wild type", ],
             aes(yintercept = circularity, colour = series),
             linetype = "solid", linewidth = 0.5) +
  geom_hline(data = ref[ref$series == "ΔlasI alone", ],
             aes(yintercept = circularity, colour = series),
             linetype = "dashed", linewidth = 0.5) +
  geom_hline(data = ref[ref$series == "ΔrhlI alone", ],
             aes(yintercept = circularity, colour = series),
             linetype = "dotted", linewidth = 0.5) +
  geom_point(data = mix, aes(x = ratio, y = circularity, colour = series),
             position = position_jitter(width = 0.012, height = 0, seed = 1),
             size = 1.7, alpha = 0.85) +
  scale_colour_manual(values = series_cols, name = "Culture") +
  scale_y_continuous(
    limits = c(0, 1),
    breaks = c(0, 0.25, 0.5, 0.75, 1),
    labels = c("0", "0.25", "0.5", "0.75", "1"),
    expand = c(0, 0)
  ) +
  x_scale +
  labs(y = "Circularity") +
  theme_swarm

p_round <- ggplot() +
  geom_hline(data = subset(ref, series == "Wild type"),
             aes(yintercept = roundness, colour = series),
             linetype = "solid", linewidth = 0.5, show.legend = FALSE) +
  geom_point(data = mix, aes(x = ratio, y = roundness, colour = series),
             position = position_jitter(width = 0.012, height = 0, seed = 1),
             size = 1.7, alpha = 0.85, show.legend = FALSE) +
  scale_colour_manual(values = series_cols, name = "Culture") +
  scale_y_continuous(
    limits = c(0.4, 1.02),
    breaks = c(0.4, 0.6, 0.8, 1.0),
    labels = c("0.4", "0.6", "0.8", "1.0"),
    expand = c(0, 0)
  ) +
  x_scale +
  labs(y = "Roundness") +
  theme_swarm

fig <- (p_area | p_circ | p_round) +
  plot_layout(guides = "collect", widths = c(1.15, 1, 1)) +
  plot_annotation(
    tag_levels = "A",
    caption = paste(
      "Points are individual dishes (n = 3 per condition); horizontal lines are alone-culture means.",
      "\nCurves are quadratic fits in log2 ratio over 1:3–100:1 with 95% confidence bands;",
      "the 500:1 and 1000:1 mixes lie outside the fitted window. Mix ratios read ΔrhlI:ΔlasI."
    ),
    theme = theme(
      plot.tag = element_text(face = "bold", size = 11, colour = "#0b0b0b"),
      plot.caption = element_text(size = 7.5, colour = "#898781", hjust = 0)
    )
  ) &
  theme(legend.position = "bottom", legend.direction = "horizontal",
        legend.box = "horizontal")

ggsave("results/swarming_cocultures.png", fig,
       width = 9.2, height = 4.6, dpi = 300, bg = "#fcfcfb")

